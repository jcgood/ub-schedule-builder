req-sequence&quot;: [&quot;economics-bs__box-0-0-0&quot;]}, &quot;economics-bs__box-7-0-0&quot;: {&quot;prereq-immediate&quot;: [&quot;economics-bs__box-2-2-0&quot;, &quot;economics-bs__box-2-3-0&quot;], &quot;prereq-sequence&quot;: [&quot;economics-bs__box-0-0-0&quot;]}, &quot;economics-bs__box-7-1-0&quot;: {&quot;prereq-immediate&quot;: [&quot;economics-bs__box-2-3-0&quot;, &quot;economics-bs__box-3-5-0&quot;], &quot;prereq-sequence&quot;: [&quot;economics-bs__box-0-0-0&quot;, &quot;economics-bs__box-2-4-0&quot;]}, &quot;economics-bs__box-7-2-0&quot;: {&quot;prereq-immediate&quot;: [&quot;economics-bs__box-2-2-0&quot;, &quot;economics-bs__box-2-3-0&quot;, &quot;economics-bs__box-3-5-0&quot;], &quot;prereq-sequence&quot;: [&quot;economics-bs__box-0-0-0&quot;, &quot;economics-bs__box-2-4-0&quot;]}}\"><div class=\"scroll-hint\">Scroll right for more semesters \u2192</div><div class=\"flow-scroll\"><div class=\"flow-container\">\n      <div class=\"semester-col term-fall\">\n        <div class=\"col-header\"><span class=\"col-year\">Year 1</span><span class=\"col-term\">Fall</span></div>\n        <div class=\"col-slots\"><div class=\"slot\"><div class=\"box box-course box-flexible\" id=\"economics-bs__box-0-0-0\" data-detail=\"{&quot;kind&quot;: &quot;course&quot;, &quot;title&quot;: &quot;Survey of Calculus and Its Applications I&quot;, &quot;description&quot;: &quot;For students in social, biological, and management sciences. Limits, continuity, differentiation of algebraic and exponential functions; applications; introduces integration.&quot;, &quot;credits&quot;: &quot;4&quot;, &quot;grading&quot;: &quot;Graded (GRD)&quot;, &quot;typically_offered&quot;: &quot;Fall, Spring, Summer, Winter&quot;, &quot;requisites&quot;: &quot;Pre-Requisite: Score of 70/100 or better on both the Fundamentals and the Algebra portions of the Math Readiness Assessment, or a C or better in ULC 148 , MTH 108 , MTH 113 , MTH 114 , MTH 115 , a D or better in MTH 121 or MTH 131 or MTH 141 or a score of 3 on AP Calculus or a score of 4 or 5 on AP Pre-Calculus.&quot;, &quot;flexible&quot;: true, &quot;also_ubc&quot;: true, &quot;catalog_url&quot;: &quot;https://catalogs.buffalo.edu/preview_program.php?catoid=21&amp;poid=7960&amp;returnto=1177&quot;, &quot;groups&quot;: [{&quot;requirement_type&quot;: &quot;choice_required&quot;, &quot;group&quot;: &quot;Economics Core - calculus requirement (choose 1 of 3)&quot;, &quot;courses&quot;: [{&quot;code&quot;: &quot;MTH 121LR&quot;, &quot;title&quot;: &quot;Survey of Calculus and Its Applications I&quot;}, {&quot;code&quot;: &quot;MTH 131LR&quot;, &quot;title&quot;: &quot;Mathematical Analysis for Management&quot;}, {&quot;code&quot;: &quot;MTH 141LR&quot;, &quot;title&quot;: &quot;College Calculus I&quot;}]}]}\" role=\"button\" tabindex=\"0\"><div class=\"box-eyebrow\"><span class=\"box-eyebrow-tag\">full list on click</span><span class=\"box-eyebrow-sep\"> &middot; </span><span class=\"box-eyebrow-tag box-ubc-tag\">UB Curriculum</span></div><div class=\"box-label\">Economics Core - calculus requirement (choose 1 of 3)</div><span class=\"box-credits\">4 cr</span></div></div><div class=\"slot\"><div class=\"box box-course\" id=\"economics-bs__box-0-1-0\" data-detail=\"{&quot;kind&quot;: &quot;course&quot;, &quot;title&quot;: &quot;Introduction to Macroeconomics&quot;, &quot;description&quot;: &quot;This course provides an overview of the fundamental economic principles and economic measures used to evaluate the economy, such as gross domestic product, the inflation rate, the unemployment rate, and federal deficits. The course examines how the economy functions, what causes economic difficulties, and the policies that are used to improve the functioning of the economy. This course may be taken independently of ECO 182 .&quot;, &quot;credits&quot;: &quot;4&quot;, &quot;grading&quot;: &quot;Graded (GRD)&quot;, &quot;typically_offered&quot;: &quot;Fall, Spring, Summer, Winter&quot;, &quot;requisites&quot;: null, &quot;flexible&quot;: false, &quot;also_ubc&quot;: false}\" role=\"button\" tabindex=\"0\"><div class=\"box-label\"><span class=\"box-code\">ECO 181LD</span><span class=\"box-title\">Introduction to Macroeconomics</span></div><span class=\"box-credits\">4 cr</span></div></div><div class=\"slot\"><div class=\"or-group\"><div class=\"box box-course\" id=\"economics-bs__box-0-2-0\" data-detail=\"{&quot;kind&quot;: &quot;course&quot;, &quot;title&quot;: &quot;Writing and Rhetoric&quot;, &quot;description&quot;: &quot;An introduction to research, writing, and rhetorical practices employed in academic and professional contexts. The course examines the operation of genres, the audiences they address, and the purposes they serve. The course focuses on the analysis and development of student writing and rhetorical practice. Assignments include research essays, digital compositions, and oral presentations.&quot;, &quot;credits&quot;: &quot;4&quot;, &quot;grading&quot;: &quot;Graded (GRD)&quot;, &quot;typically_offered&quot;: &quot;Fall, Spring, Summer&quot;, &quot;requisites&quot;: &quot;ENG 105 non-Z Requisite&quot;, &quot;flexible&quot;: false, &quot;also_ubc&quot;: true}\" role=\"button\" tabindex=\"0\"><div class=\"box-eyebrow\"><span class=\"box-eyebrow-tag box-ubc-tag\">UB Curriculum</span></div><div class=\"box-label\"><span class=\"box-code\">ENG 105LEC</span><span class=\"box-title\">Writing and Rhetoric</span></div><span class=\"box-credits\">4 cr</span><div class=\"box-note\">(may also be completed in a different semester shown)</div></div><div class=\"or-sep\">or</div><div class=\"box box-generic\" id=\"economics-bs__box-0-2-1\" data-detail=\"{&quot;kind&quot;: &quot;generic&quot;, &quot;category&quot;: &quot;ubc&quot;, &quot;description&quot;: &quot;Pathway: a UB Curriculum Thematic or Global Pathway course - part of at least four UB Areas/SUNY General Education categories a student&#x27;s Pathways coursework must satisfy across two Pathways (one Thematic, one Global).&quot;, &quot;catalog_url&quot;: &quot;https://www.buffalo.edu/ubcurriculum/pathways.html&quot;}\" role=\"button\" tabindex=\"0\"><div class=\"box-eyebrow\"><span class=\"box-eyebrow-tag box-ubc-tag\">UB Curriculum</span></div><div class=\"box-label\">Pathway</div><span class=\"box-credits\">3 cr</span></div></div></div><div class=\"slot\"><div class=\"box box-generic\" id=\"economics-bs__box-0-3-0\" data-detail=\"{&quot;kind&quot;: &quot;generic&quot;, &quot;category&quot;: &quot;ubc&quot;, &quot;description&quot;: &quot;UB Seminar: a 1- or 3-credit seminar every student completes in their first semester of enrollment, taught by faculty across departments around a &#x27;big idea&#x27; in the discipline. A UB Curriculum core requirement, not specific to this major.&quot;, &quot;catalog_url&quot;: &quot;https://www.buffalo.edu/ubcurriculum/seminar.html&quot;}\" role=\"button\" tabindex=\"0\"><div class=\"box-eyebrow\"><span class=\"box-eyebrow-tag box-ubc-tag\">UB Curriculum</span></div><div class=\"box-label\">UB Seminar</div><span class=\"box-credits\">3 cr</span></div></div></div>\n        <div class=\"col-total\">14 or 15 credits</div>\n      </div>\n      <div class=\"semester-col term-spring\">\n        <div class=\"col-header\"><span class=\"col-year\">Year 1</span><span class=\"col-term\">Spring</span></div>\n        <div class=\"col-slots\"><div class=\"slot\"><div class=\"or-group\"><div class=\"box box-course\" id=\"economics-bs__box-1-0-0\" data-detail=\"{&quot;kind&quot;: &quot;course&quot;, &quot;title&quot;: &quot;Writing and Rhetoric&quot;, &quot;description&quot;: &quot;An introduction to research, writing, and rhetorical practices employed in academic and professional contexts. The course examines the operation of genres, the audiences they address, and the purposes they serve. The course focuses on the analysis and development of student writing and rhetorical practice. Assignments include research essays, digital compositions, and oral presentations.&quot;, &quot;credits&quot;: &quot;4&quot;, &quot;grading&quot;: &quot;Graded (GRD)&quot;, &quot;typically_offered&quot;: &quot;Fall, Spring, Summer&quot;, &quot;requisites&quot;: &quot;ENG 105 non-Z Requisite&quot;, &quot;flexible&quot;: false, &quot;also_ubc&quot;: true}\" role=\"button\" tabindex=\"0\"><div class=\"box-eyebrow\"><span class=\"box-eyebrow-tag box-ubc-tag\">UB Curriculum</span></div><div class=\"box-label\"><span class=\"box-code\">ENG 105LEC</span><span class=\"box-title\">Writing and Rhetoric</span></div><span class=\"box-credits\">4 cr</span><div class=\"box-note\">(may also be completed in a different semester shown)</div></div><div class=\"or-sep\">or</div><div class=\"box box-generic\" id=\"economics-bs__box-1-0-1\" data-detail=\"{&quot;kind&quot;: &quot;generic&quot;, &quot;category&quot;: &quot;ubc&quot;, &quot;description&quot;: &quot;Pathway: a UB Curriculum Thematic or Global Pathway course - part of at least four UB Areas/SUNY General Education categories a student&#x27;s Pathways coursework must satisfy across two Pathways (one Thematic, one Global).&quot;, &quot;catalog_url&quot;: &quot;https://www.buffalo.edu/ubcurriculum/pathways.html&quot;}\" role=\"button\" tabindex=\"0\"><div class=\"box-eyebrow\"><span class=\"box-eyebrow-tag box-ubc-tag\">UB Curriculum</span></div><div class=\"box-label\">Pathway</div><span class=\"box-credits\">3 cr</span></div></div></div><div class=\"slot\"><div class=\"box box-generic\" id=\"economics-bs__box-1-1-0\" data-detail=\"{&quot;kind&quot;: &quot;generic&quot;, &quot;category&quot;: &quot;ubc&quot;, &quot;description&quot;: &quot;Pathway: a UB Curriculum Thematic or Global Pathway course - part of at least four UB Areas/SUNY General Education categories a student&#x27;s Pathways coursework must satisfy across two Pathways (one Thematic, one Global).&quot;, &quot;catalog_url&quot;: &quot;https://www.buffalo.edu/ubcurriculum/pathways.html&quot;}\" role=\"button\" tabindex=\"0\"><div class=\"box-eyebrow\"><span class=\"box-eyebrow-tag box-ubc-tag\">UB Curriculum</span></div><div class=\"box-label\">Pathway</div><span class=\"box-credits\">3 cr</span></div></div><div class=\"slot\"><div class=\"box box-course box-flexible\" id=\"economics-bs__box-1-2-0\" data-detail=\"{&quot;kind&quot;: &quot;generic&quot;, &quot;category&quot;: &quot;major_elective&quot;, &quot;description&quot;: &quot;\\&quot;Elective\\&quot; is an elective slot specific to this major&#x27;s own requirements, not a UB Curriculum-wide component - the exact eligible courses depend on this program&#x27;s requirements as listed in the Undergraduate Catalog.&quot;, &quot;catalog_url&quot;: &quot;https://catalogs.buffalo.edu/preview_program.php?catoid=21&amp;poid=7960&amp;returnto=1177&quot;}\" role=\"button\" tabindex=\"0\"><div class=\"box-eyebrow\"><span class=\"box-eyebrow-tag\">Elective in the major</span></div><div class=\"box-label\">Elective</div><span class=\"box-credits\">3 cr</span></div></div><div class=\"slot\"><div class=\"box box-course box-flexible\" id=\"economics-bs__box-1-3-0\" data-detail=\"{&quot;kind&quot;: &quot;generic&quot;, &quot;category&quot;: &quot;major_elective&quot;, &quot;description&quot;: &quot;\\&quot;Elective\\&quot; is an elective slot specific to this major&#x27;s own requirements, not a UB Curriculum-wide component - the exact eligible courses depend on this program&#x27;s requirements as listed in the Undergraduate Catalog.&quot;, &quot;catalog_url&quot;: &quot;https://catalogs.buffalo.edu/preview_program.php?catoid=21&amp;poid=7960&amp;returnto=1177&quot;}\" role=\"button\" tabindex=\"0\"><div class=\"box-eyebrow\"><span class=\"box-eyebrow-tag\">Elective in the major</span></div><div class=\"box-label\">Elective</div><span class=\"box-credits\">3 cr</span></div></div><div class=\"slot\"><div class=\"box box-course\" id=\"economics-bs__box-1-4-0\" data-detail=\"{&quot;kind&quot;: &quot;course&quot;, &quot;title&quot;: &quot;Introduction to Microeconomics&quot;, &quot;description&quot;: &quot;This course provides an overview of how individuals and firms make decisions regarding the allocation of scarce resources to maximize the value they obtain from these resources. The course also looks at how markets are structured and how resource scarcity has caused markets to evolve. Finally, it addresses the debate on whether regulating markets can improve their functioning. This course may be taken independently of ECO 181 .&quot;, &quot;credits&quot;: &quot;4&quot;, &quot;grading&quot;: &quot;Graded (GRD)&quot;, &quot;typically_offered&quot;: &quot;Fall, Spring, Summer, Winter&quot;, &quot;requisites&quot;: null, &quot;flexible&quot;: false, &quot;also_ubc&quot;: false}\" role=\"button\" tabindex=\"0\"><div class=\"box-label\"><span class=\"box-code\">ECO 182LD</span><span class=\"box-title\">Introduction to Microeconomics</span></div><span class=\"box-credits\">4 cr</span></div></div></div>\n        <div class=\"col-total\">16 or 17 credits</div>\n      </div>\n      <div class=\"semester-col term-fall\">\n        <div class=\"col-header\"><span class=\"col-year\">Year 2</span><span class=\"col-term\">Fall</span></div>\n        <div class=\"col-slots\"><div class=\"slot\"><div class=\"box box-generic\" id=\"economics-bs__box-2-0-0\" data-detail=\"{&quot;kind&quot;: &quot;generic&quot;, &quot;category&quot;: &quot;ubc&quot;, &quot;description&quot;: &quot;Scientific Literacy and Inquiry: a 7-credit UB Curriculum Foundations requirement (two lecture courses plus a matching 1-credit lab from the same subject area).&quot;, &quot;catalog_url&quot;: &quot;https://www.buffalo.edu/ubcurriculum/foundations.html&quot;}\" role=\"button\" tabindex=\"0\"><div class=\"box-eyebrow\"><span class=\"box-eyebrow-tag box-ubc-tag\">UB Curriculum</span></div><div class=\"box-label\">Scientific Literacy and Inquiry 1</div><span class=\"box-credits\">3 cr</span></div></div><div class=\"slot\"><div class=\"box box-generic\" id=\"economics-bs__box-2-1-0\" data-detail=\"{&quot;kind&quot;: &quot;generic&quot;, &quot;category&quot;: &quot;ubc&quot;, &quot;description&quot;: &quot;Pathway: a UB Curriculum Thematic or Global Pathway course - part of at least four UB Areas/SUNY General Education categories a student&#x27;s Pathways coursework must satisfy across two Pathways (one Thematic, one Global).&quot;, &quot;catalog_url&quot;: &quot;https://www.buffalo.edu/ubcurriculum/pathways.html&quot;}\" role=\"button\" tabindex=\"0\"><div class=\"box-eyebrow\"><span class=\"box-eyebrow-tag box-ubc-tag\">UB Curriculum</span></div><div class=\"box-label\">Pathway</div><span class=\"box-credits\">3 cr</span></div></div><div class=\"slot\"><div class=\"box box-course\" id=\"economics-bs__box-2-2-0\" data-detail=\"{&quot;kind&quot;: &quot;course&quot;, &quot;title&quot;: &quot;Macroeconomic Theory&quot;, &quot;description&quot;: &quot;This course is an intermediate-level examination of the sometimes-competing models of the macroeconomy. It uses economic theory to explain the causes of inflation, business fluctuations, unemployment, and economic growth.&quot;, &quot;credits&quot;: &quot;3&quot;, &quot;grading&quot;: &quot;Graded (GRD)&quot;, &quot;typically_offered&quot;: &quot;Fall, Spring, Summer, Winter&quot;, &quot;requisites&quot;: &quot;Pre-Requisite: MTH 121 or MTH 131 or MTH 141 or MTH 136 and MTH 137&quot;, &quot;flexible&quot;: false, &quot;also_ubc&quot;: false}\" role=\"button\" tabindex=\"0\"><div class=\"box-label\"><span class=\"box-code\">ECO 407LEC</span><span class=\"box-title\">Macroeconomic Theory</span></div><span class=\"box-credits\">3 cr</span></div></div><div class=\"slot\"><div class=\"box box-course\" id=\"economics-bs__box-2-3-0\" data-detail=\"{&quot;kind&quot;: &quot;course&quot;, &quot;title&quot;: &quot;Microeconomic Theory 1&quot;, &quot;description&quot;: &quot;This course presents the core analytical tools that economists use to model the behavior of consumers, firms, and markets. Topics include the analysis of supply and demand, consumer and producer behavior, competitive markets, monopoly, and pricing with market power. The concepts covered in this course underlie the methodology used in nearly all subfields of economics and provide a framework that can be used to analyze many practical decision problems and policy issues. Following completion of this course, students will be prepared to take upper-division elective courses in economics.&quot;, &quot;credits&quot;: &quot;3&quot;, &quot;grading&quot;: &quot;Graded (GRD)&quot;, &quot;typically_offered&quot;: &quot;Fall, Spring, Summer, Winter&quot;, &quot;requisites&quot;: &quot;Pre-Requisite: MTH 121 or MTH 131 or MTH 141 or MTH 136 and MTH 137&quot;, &quot;flexible&quot;: false, &quot;also_ubc&quot;: false}\" role=\"button\" tabindex=\"0\"><div class=\"box-label\"><span class=\"box-code\">ECO 405LEC</span><span class=\"box-title\">Microeconomic Theory 1</span></div><span class=\"box-credits\">3 cr</span></div></div><div class=\"slot\"><div class=\"box box-course\" id=\"economics-bs__box-2-4-0\" data-detail=\"{&quot;kind&quot;: &quot;course&quot;, &quot;title&quot;: &quot;Economic Statistics and Data Analysis&quot;, &quot;description&quot;: &quot;This course introduces data analysis and econometrics. Econometrics is a collection of methods that use data and statistical techniques to extract information from data, to answer real-world applied questions, and to test predictions of economic theory. Econometrics is used by governments and businesses to study the effects of government policies and to use historical data to forecast future values of variables such as gross domestic product, interest rates, unemployment rates, stock market prices, and sales growth. This course is the first in a sequence on applied economic statistics, econometrics, and data analysis. The focus is on applications and interpreting the findings of applied econometric studies.&quot;, &quot;credits&quot;: &quot;3&quot;, &quot;grading&quot;: &quot;Graded (GRD)&quot;, &quot;typically_offered&quot;: &quot;Fall, Spring, Summer, Winter&quot;, &quot;requisites&quot;: null, &quot;flexible&quot;: false, &quot;also_ubc&quot;: false}\" role=\"button\" tabindex=\"0\"><div class=\"box-label\"><span class=\"box-code\">ECO 380LEC</span><span class=\"box-title\">Economic Statistics and Data Analysis</span></div><span class=\"box-credits\">3 cr</span></div></div></div>\n        <div class=\"col-total\">15 credits</div>\n      </div>\n      <div class=\"semester-col term-spring\">\n        <div class=\"col-header\"><span class=\"col-year\">Year 2</span><span class=\"col-term\">Spring</span></div>\n        <div class=\"col-slots\"><div class=\"slot\"><div class=\"box box-generic\" id=\"economics-bs__box-3-0-0\" data-detail=\"{&quot;kind&quot;: &quot;generic&quot;, &quot;category&quot;: &quot;ubc&quot;, &quot;description&quot;: &quot;Pathway: a UB Curriculum Thematic or Global Pathway course - part of at least four UB Areas/SUNY General Education categories a student&#x27;s Pathways coursework must satisfy across two Pathways (one Thematic, one Global).&quot;, &quot;catalog_url&quot;: &quot;https://www.buffalo.edu/ubcurriculum/pathways.html&quot;}\" role=\"button\" tabindex=\"0\"><div class=\"box-eyebrow\"><span class=\"box-eyebrow-tag box-ubc-tag\">UB Curriculum</span></div><div class=\"box-label\">Pathway</div><span class=\"box-credits\">3 cr</span></div></div><div class=\"slot\"><div class=\"box box-generic\" id=\"economics-bs__box-3-1-0\" data-detail=\"{&quot;kind&quot;: &quot;generic&quot;, &quot;category&quot;: &quot;ubc&quot;, &quot;description&quot;: &quot;Scientific Literacy and Inquiry: a 7-credit UB Curriculum Foundations requirement (two lecture courses plus a matching 1-credit lab from the same subject area).&quot;, &quot;catalog_url&quot;: &quot;https://www.buffalo.edu/ubcurriculum/foundations.html&quot;}\" role=\"button\" tabindex=\"0\"><div class=\"box-eyebrow\"><span class=\"box-eyebrow-tag box-ubc-tag\">UB Curriculum</span></div><div class=\"box-label\">Scientific Literacy and Inquiry 2</div><span class=\"box-credits\">3 cr</span></div></div><div class=\"slot\"><div class=\"box box-generic\" id=\"economics-bs__box-3-2-0\" data-detail=\"{&quot;kind&quot;: &quot;generic&quot;, &quot;category&quot;: &quot;ubc&quot;, &quot;description&quot;: &quot;Scientific Literacy and Inquiry: a 7-credit UB Curriculum Foundations requirement (two lecture courses plus a matching 1-credit lab from the same subject area).&quot;, &quot;catalog_url&quot;: &quot;https://www.buffalo.edu/ubcurriculum/foundations.html&quot;}\" role=\"button\" tabindex=\"0\"><div class=\"box-eyebrow\"><span class=\"box-eyebrow-tag box-ubc-tag\">UB Curriculum</span></div><div class=\"box-label\">Scientific Literacy and Inquiry Lab</div><span class=\"box-credits\">1 cr</span></div></div><div class=\"slot\"><div class=\"box box-course\" id=\"economics-bs__box-3-3-0\" data-detail=\"{&quot;kind&quot;: &quot;course&quot;, &quot;title&quot;: &quot;Microeconomic Theory 2&quot;, &quot;description&quot;: &quot;This course introduces new theories and applied topics in microeconomics beyond the basic subjects studied in ECO 405 . It covers a broad range of imperfect markets, including monopoly, oligopoly, and monopolistic competition. It also covers topics in game theory, uncertainty, investment and capital markets, general equilibrium analysis, externalities and public goods, and markets with asymmetric information.&quot;, &quot;credits&quot;: &quot;3&quot;, &quot;grading&quot;: &quot;Graded (GRD)&quot;, &quot;typically_offered&quot;: &quot;Spring&quot;, &quot;requisites&quot;: &quot;Pre-Requisite: ECO 405&quot;, &quot;flexible&quot;: false, &quot;also_ubc&quot;: false}\" role=\"button\" tabindex=\"0\"><div class=\"box-label\"><span class=\"box-code\">ECO 406LEC</span><span class=\"box-title\">Microeconomic Theory 2</span></div><span class=\"box-credits\">3 cr</span></div></div><div class=\"slot\"><div class=\"box box-course box-flexible\" id=\"economics-bs__box-3-4-0\" data-detail=\"{&quot;kind&quot;: &quot;generic&quot;, &quot;category&quot;: &quot;major_elective&quot;, &quot;description&quot;: &quot;\\&quot;ECO 300/400 Level Elective\\&quot; is an elective slot specific to this major&#x27;s own requirements, not a UB Curriculum-wide component - the exact eligible courses depend on this program&#x27;s requirements as listed in the Undergraduate Catalog.&quot;, &quot;catalog_url&quot;: &quot;https://catalogs.buffalo.edu/preview_program.php?catoid=21&amp;poid=7960&amp;returnto=1177&quot;}\" role=\"button\" tabindex=\"0\"><div class=\"box-eyebrow\"><span class=\"box-eyebrow-tag\">Elective in the major</span></div><div class=\"box-label\">ECO 300/400 Level Elective</div><span class=\"box-credits\">3 cr</span></div></div><div class=\"slot\"><div class=\"box box-course\" id=\"economics-bs__box-3-5-0\" data-detail=\"{&quot;kind&quot;: &quot;course&quot;, &quot;title&quot;: &quot;Econometrics I&quot;, &quot;description&quot;: &quot;This course is the first class on basic applied econometrics, introducing students to the fundamental concepts and techniques used to analyze data. The course focuses on the multiple linear regression models and their assumptions, estimation techniques, and statistical inferences. Econometrics is a tool that allows one to use data and statistical techniques to answer real-world questions. Econometrics is used in all social science settings. For example, economists use econometrics to test predictions of economic theory or conduct policy analysis, governments use econometrics to study the effects of government policies, and businesses use historical data to forecast sales growth. This course emphasizes practical applications and interpreting the findings of applied econometric studies. One essential learning outcome of the class is estimating econometric models using actual data. Therefore, an important part of the class will be the use of Stata, a versatile and powerful computer statistical package used to analyze data. Knowledge of econometrics is valuable for many types of jobs; therefore, knowing a software package such as Stata is also extremely valuable.&quot;, &quot;credits&quot;: &quot;3&quot;, &quot;grading&quot;: &quot;Graded (GRD)&quot;, &quot;typically_offered&quot;: &quot;Fall, Spring, Summer&quot;, &quot;requisites&quot;: &quot;Pre-Requisites:  ECO 380 or GEO 211 or CIE 308 or (MTH 411 and MTH 412 ) or (STA 301 and STA 301 and STA 302 and STA 302 ) or (MTH 411 and STA 302 and STA 302 ) or (STA 301 and STA 301 and MTH 412 ).&quot;, &quot;flexible&quot;: false, &quot;also_ubc&quot;: false}\" role=\"button\" tabindex=\"0\"><div class=\"box-label\"><span class=\"box-code\">ECO 480LEC</span><span class=\"box-title\">Econometrics I</span></div><span class=\"box-credits\">3 cr</span></div></div></div>\n        <div class=\"col-total\">16 credits</div>\n      </div>\n      <div class=\"semester-col term-fall\">\n        <div class=\"col-header\"><span class=\"col-year\">Year 3</span><span class=\"col-term\">Fall</span></div>\n        <div class=\"col-slots\"><div class=\"slot\"><div class=\"box box-generic\" id=\"economics-bs__box-4-0-0\" data-detail=\"{&quot;kind&quot;: &quot;generic&quot;, &quot;category&quot;: &quot;ubc&quot;, &quot;description&quot;: &quot;Communication Literacy 2: a UB Curriculum Foundations requirement, completed from an approved list of discipline-specific writing courses (see the Undergraduate Catalog&#x27;s Communication Literacy II list).&quot;, &quot;catalog_url&quot;: &quot;https://www.buffalo.edu/ubcurriculum/foundations.html&quot;}\" role=\"button\" tabindex=\"0\"><div class=\"box-eyebrow\"><span class=\"box-eyebrow-tag box-ubc-tag\">UB Curriculum</span></div><div class=\"box-label\">Communication Literacy 2</div><span class=\"box-credits\">3 cr</span></div></div><div class=\"slot\"><div class=\"box box-course\" id=\"economics-bs__box-4-1-0\" data-detail=\"{&quot;kind&quot;: &quot;course&quot;, &quot;title&quot;: &quot;Math for Economists&quot;, &quot;description&quot;: &quot;This course discusses the mathematical techniques used in economic analysis, including optimization theory, consumer and producer optimization problems, and general equilibrium models.&quot;, &quot;credits&quot;: &quot;3&quot;, &quot;grading&quot;: &quot;Graded (GRD)&quot;, &quot;typically_offered&quot;: &quot;Fall&quot;, &quot;requisites&quot;: &quot;Pre-Requisite: MTH 121 or MTH 131 or MTH 141 or MTH 136 and MTH 137&quot;, &quot;flexible&quot;: false, &quot;also_ubc&quot;: false}\" role=\"button\" tabindex=\"0\"><div class=\"box-label\"><span class=\"box-code\">ECO 451SEM</span><span class=\"box-title\">Math for Economists</span></div><span class=\"box-credits\">3 cr</span></div></div><div class=\"slot\"><div class=\"box box-generic\" id=\"economics-bs__box-4-2-0\" data-detail=\"{&quot;kind&quot;: &quot;generic&quot;, &quot;category&quot;: &quot;ubc&quot;, &quot;description&quot;: &quot;Pathway: a UB Curriculum Thematic or Global Pathway course - part of at least four UB Areas/SUNY General Education categories a student&#x27;s Pathways coursework must satisfy across two Pathways (one Thematic, one Global).&quot;, &quot;catalog_url&quot;: &quot;https://www.buffalo.edu/ubcurriculum/pathways.html&quot;}\" role=\"button\" tabindex=\"0\"><div class=\"box-eyebrow\"><span class=\"box-eyebrow-tag box-ubc-tag\">UB Curriculum</span></div><div class=\"box-label\">Pathway</div><span class=\"box-credits\">3 cr</span></div></div><div class=\"slot\"><div class=\"box box-course box-flexible\" id=\"economics-bs__box-4-3-0\" data-detail=\"{&quot;kind&quot;: &quot;generic&quot;, &quot;category&quot;: &quot;major_elective&quot;, &quot;description&quot;: &quot;\\&quot;ECO 300/400 Level Elective\\&quot; is an elective slot specific to this major&#x27;s own requirements, not a UB Curriculum-wide component - the exact eligible courses depend on this program&#x27;s requirements as listed in the Undergraduate Catalog.&quot;, &quot;catalog_url&quot;: &quot;https://catalogs.buffalo.edu/preview_program.php?catoid=21&amp;poid=7960&amp;returnto=1177&quot;}\" role=\"button\" tabindex=\"0\"><div class=\"box-eyebrow\"><span class=\"box-eyebrow-tag\">Elective in the major</span></div><div class=\"box-label\">ECO 300/400 Level Elective</div><span class=\"box-credits\">3 cr</span></div></div><div class=\"slot\"><div class=\"box box-course box-flexible\" id=\"economics-bs__box-4-4-0\" data-detail=\"{&quot;kind&quot;: &quot;generic&quot;, &quot;category&quot;: &quot;major_elective&quot;, &quot;description&quot;: &quot;\\&quot;ECO 300/400 Level Elective\\&quot; is an elective slot specific to this major&#x27;s own requirements, not a UB Curriculum-wide component - the exact eligible courses depend on this program&#x27;s requirements as listed in the Undergraduate Catalog.&quot;, &quot;catalog_url&quot;: &quot;https://catalogs.buffalo.edu/preview_program.php?catoid=21&amp;poid=7960&amp;returnto=1177&quot;}\" role=\"button\" tabindex=\"0\"><div class=\"box-eyebrow\"><span class=\"box-eyebrow-tag\">Elective in the major</span></div><div class=\"box-label\">ECO 300/400 Level Elective</div><span class=\"box-credits\">3 cr</span></div></div></div>\n        <div class=\"col-total\">15 credits</div>\n      </div>\n      <div class=\"semester-col term-spring\">\n        <div class=\"col-header\"><span class=\"col-year\">Year 3</span><span class=\"col-term\">Spring</span></div>\n        <div class=\"col-slots\"><div class=\"slot\"><div class=\"box box-generic\" id=\"economics-bs__box-5-0-0\" data-detail=\"{&quot;kind&quot;: &quot;generic&quot;, &quot;category&quot;: &quot;ubc&quot;, &quot;description&quot;: &quot;Pathway: a UB Curriculum Thematic or Global Pathway course - part of at least four UB Areas/SUNY General Education categories a student&#x27;s Pathways coursework must satisfy across two Pathways (one Thematic, one Global).&quot;, &quot;catalog_url&quot;: &quot;https://www.buffalo.edu/ubcurriculum/pathways.html&quot;}\" role=\"button\" tabindex=\"0\"><div class=\"box-eyebrow\"><span class=\"box-eyebrow-tag box-ubc-tag\">UB Curriculum</span></div><div class=\"box-label\">Pathway</div><span class=\"box-credits\">3 cr</span></div></div><div class=\"slot\"><div class=\"box box-course box-flexible\" id=\"economics-bs__box-5-1-0\" data-detail=\"{&quot;kind&quot;: &quot;generic&quot;, &quot;category&quot;: &quot;major_elective&quot;, &quot;description&quot;: &quot;\\&quot;Elective\\&quot; is an elective slot specific to this major&#x27;s own requirements, not a UB Curriculum-wide component - the exact eligible courses depend on this program&#x27;s requirements as listed in the Undergraduate Catalog.&quot;, &quot;catalog_url&quot;: &quot;https://catalogs.buffalo.edu/preview_program.php?catoid=21&amp;poid=7960&amp;returnto=1177&quot;}\" role=\"button\" tabindex=\"0\"><div class=\"box-eyebrow\"><span class=\"box-eyebrow-tag\">Elective in the major</span></div><div class=\"box-label\">Elective</div><span class=\"box-credits\">3 cr</span></div></div><div class=\"slot\"><div class=\"box box-course\" id=\"economics-bs__box-5-2-0\" data-detail=\"{&quot;kind&quot;: &quot;course&quot;, &quot;title&quot;: &quot;Econometrics II&quot;, &quot;description&quot;: &quot;This course extends the knowledge of econometrics beyond the multiple linear regression models in Econometrics 1. This course is the second class on basic applied econometrics. The objective of this course is to estimate causal effect using econometric models. Students will learn how to implement and interpret the results using linear regression and non-linear regression models using actual data. These topics include randomized experiments, fixed-effects models, instrumental variables models, regression discontinuity models. The emphasis behind these models is causal inference and research design. Students should also be able to use these various models to analyze data, and critically assess studies using these models. Students should be able to articulate why a model may give misleading results, and what to do about such a problem. Understanding and being able to explain the key concepts is an important part of this course. This course is dual listed with ECO 581.&quot;, &quot;credits&quot;: &quot;3&quot;, &quot;grading&quot;: &quot;Graded (GRD)&quot;, &quot;typically_offered&quot;: &quot;Spring&quot;, &quot;requisites&quot;: &quot;Pre-Requisite: ECO 480 .&quot;, &quot;flexible&quot;: false, &quot;also_ubc&quot;: false}\" role=\"button\" tabindex=\"0\"><div class=\"box-label\"><span class=\"box-code\">ECO 481LEC</span><span class=\"box-title\">Econometrics II</span></div><span class=\"box-credits\">3 cr</span></div></div><div class=\"slot\"><div class=\"box box-course\" id=\"economics-bs__box-5-3-0\" data-detail=\"{&quot;kind&quot;: &quot;course&quot;, &quot;title&quot;: &quot;Economics and Game Theory&quot;, &quot;description&quot;: &quot;This course covers basic game theory, which is used to formalize and analyze interactive decision making where one party\\u2019s outcome depends on not just its own choice, but also another party\\u2019s choice. Game theory describes essential aspect of social behavior because game theory is used in economics, business, international relations, political sciences. The course also applies the concepts to real-world setting. The course covers decision theory, strategies, strategic dominance, Nash equilibrium in pure and mixed strategies, strategic form games, extensive form games, Bayesian games, and repeated games.&quot;, &quot;credits&quot;: &quot;3&quot;, &quot;grading&quot;: &quot;Graded (GRD)&quot;, &quot;typically_offered&quot;: &quot;Spring&quot;, &quot;requisites&quot;: null, &quot;flexible&quot;: false, &quot;also_ubc&quot;: false}\" role=\"button\" tabindex=\"0\"><div class=\"box-label\"><span class=\"box-code\">ECO 467LEC</span><span class=\"box-title\">Economics and Game Theory</span></div><span class=\"box-credits\">3 cr</span></div></div><div class=\"slot\"><div class=\"box box-course\" id=\"economics-bs__box-5-4-0\" data-detail=\"{&quot;kind&quot;: &quot;course&quot;, &quot;title&quot;: &quot;Industrial Organization&quot;, &quot;description&quot;: &quot;This course studies the behavior of firms, such as pricing, production, marketing, investment, research and development, and organization. Factors that can influence the behavior of firms include technology, consumer preferences and beliefs, and other firms? behavior, and other market conditions. This course helps students to be better informed managers, industry analysts, consumers, investors, and policymakers.&quot;, &quot;credits&quot;: &quot;3&quot;, &quot;grading&quot;: &quot;Graded (GRD)&quot;, &quot;typically_offered&quot;: &quot;Fall&quot;, &quot;requisites&quot;: &quot;Pre-Requisite: ECO 405 .&quot;, &quot;flexible&quot;: false, &quot;also_ubc&quot;: false}\" role=\"button\" tabindex=\"0\"><div class=\"box-label\"><span class=\"box-code\">ECO 469SEM</span><span class=\"box-title\">Industrial Organization</span></div><span class=\"box-credits\">3 cr</span></div></div></div>\n        <div class=\"col-total\">15 credits</div>\n      </div>\n      <div class=\"semester-col term-fall\">\n        <div class=\"col-header\"><span class=\"col-year\">Year 4</span><span class=\"col-term\">Fall</span></div>\n        <div class=\"col-slots\"><div class=\"slot\"><div class=\"box box-course box-flexible\" id=\"economics-bs__box-6-0-0\" data-detail=\"{&quot;kind&quot;: &quot;generic&quot;, &quot;category&quot;: &quot;major_elective&quot;, &quot;description&quot;: &quot;\\&quot;Elective\\&quot; is an elective slot specific to this major&#x27;s own requirements, not a UB Curriculum-wide component - the exact eligible courses depend on this program&#x27;s requirements as listed in the Undergraduate Catalog.&quot;, &quot;catalog_url&quot;: &quot;https://catalogs.buffalo.edu/preview_program.php?catoid=21&amp;poid=7960&amp;returnto=1177&quot;}\" role=\"button\" tabindex=\"0\"><div class=\"box-eyebrow\"><span class=\"box-eyebrow-tag\">Elective in the major</span></div><div class=\"box-label\">Elective</div><span class=\"box-credits\">3 cr</span></div></div><div class=\"slot\"><div class=\"box box-course box-flexible\" id=\"economics-bs__box-6-1-0\" data-detail=\"{&quot;kind&quot;: &quot;generic&quot;, &quot;category&quot;: &quot;major_elective&quot;, &quot;description&quot;: &quot;\\&quot;Elective\\&quot; is an elective slot specific to this major&#x27;s own requirements, not a UB Curriculum-wide component - the exact eligible courses depend on this program&#x27;s requirements as listed in the Undergraduate Catalog.&quot;, &quot;catalog_url&quot;: &quot;https://catalogs.buffalo.edu/preview_program.php?catoid=21&amp;poid=7960&amp;returnto=1177&quot;}\" role=\"button\" tabindex=\"0\"><div class=\"box-eyebrow\"><span class=\"box-eyebrow-tag\">Elective in the major</span></div><div class=\"box-label\">Elective</div><span class=\"box-credits\">3 cr</span></div></div><div class=\"slot\"><div class=\"box box-course\" id=\"economics-bs__box-6-2-0\" data-detail=\"{&quot;kind&quot;: &quot;course&quot;, &quot;title&quot;: &quot;UB Curriculum Capstone&quot;, &quot;description&quot;: &quot;UB Curriculum Capstone (UBC 399) is the culminating general education requirement. It is a one-credit course in which you will work in UBPortfolio, with the support of your Capstone instructor, to create a reflective and integrative Capstone ePortfolio based on your UB Curriculum coursework and lived experiences outside of the classroom. All UB Curriculum courses must be completed or in-progress to enroll in and complete UBC 399. Students who drop an in-progress course will be removed from UBC 399 through the add/drop period. Students who resign an in-progress course may not be able to successfully complete the Capstone.&quot;, &quot;credits&quot;: &quot;1&quot;, &quot;grading&quot;: &quot;Graded (GRD)&quot;, &quot;typically_offered&quot;: &quot;Fall, Spring&quot;, &quot;requisites&quot;: &quot;All UB Curriculum courses must be completed or in-progress to enroll in and complete UBC 399. UB Seminar is a prerequisite to UBC 399 and therefore cannot be taken concurrently. If you enrolled today in your remaining UBC course(s), HUB will allow you to enroll tomorrow. For questions, email: ubcurriculum@buffalo.edu.&quot;, &quot;flexible&quot;: false, &quot;also_ubc&quot;: true}\" role=\"button\" tabindex=\"0\"><div class=\"box-eyebrow\"><span class=\"box-eyebrow-tag box-ubc-tag\">UB Curriculum</span></div><div class=\"box-label\"><span class=\"box-code\">UBC 399MNT</span><span class=\"box-title\">UB Curriculum Capstone</span></div><span class=\"box-credits\">1 cr</span></div></div><div class=\"slot\"><div class=\"box box-course box-flexible\" id=\"economics-bs__box-6-3-0\" data-detail=\"{&quot;kind&quot;: &quot;generic&quot;, &quot;category&quot;: &quot;major_elective&quot;, &quot;description&quot;: &quot;\\&quot;ECO 300/400 Level Elective\\&quot; is an elective slot specific to this major&#x27;s own requirements, not a UB Curriculum-wide component - the exact eligible courses depend on this program&#x27;s requirements as listed in the Undergraduate Catalog.&quot;, &quot;catalog_url&quot;: &quot;https://catalogs.buffalo.edu/preview_program.php?catoid=21&amp;poid=7960&amp;returnto=1177&quot;}\" role=\"button\" tabindex=\"0\"><div class=\"box-eyebrow\"><span class=\"box-eyebrow-tag\">Elective in the major</span></div><div class=\"box-label\">ECO 300/400 Level Elective</div><span class=\"box-credits\">3 cr</span></div></div><div class=\"slot\"><div class=\"box box-course box-flexible\" id=\"economics-bs__box-6-4-0\" data-detail=\"{&quot;kind&quot;: &quot;generic&quot;, &quot;category&quot;: &quot;major_elective&quot;, &quot;description&quot;: &quot;\\&quot;ECO 300/400 Level Elective\\&quot; is an elective slot specific to this major&#x27;s own requirements, not a UB Curriculum-wide component - the exact eligible courses depend on this program&#x27;s requirements as listed in the Undergraduate Catalog.&quot;, &quot;catalog_url&quot;: &quot;https://catalogs.buffalo.edu/preview_program.php?catoid=21&amp;poid=7960&amp;returnto=1177&quot;}\" role=\"button\" tabindex=\"0\"><div class=\"box-eyebrow\"><span class=\"box-eyebrow-tag\">Elective in the major</span></div><div class=\"box-label\">ECO 300/400 Level Elective</div><span class=\"box-credits\">3 cr</span></div></div></div>\n        <div class=\"col-total\">13 credits</div>\n      </div>\n      <div class=\"semester-col term-spring\">\n        <div class=\"col-header\"><span class=\"col-year\">Year 4</span><span class=\"col-term\">Spring</span></div>\n        <div class=\"col-slots\"><div class=\"slot\"><div class=\"box box-course\" id=\"economics-bs__box-7-0-0\" data-detail=\"{&quot;kind&quot;: &quot;course&quot;, &quot;title&quot;: &quot;Financial Economics&quot;, &quot;description&quot;: &quot;This course provides an overview of financial decision-making and the functions of financial markets. The course first focuses on financial decisions made by individuals and firms, then investigates the way these decisions are implemented through financial systems. The key concepts are resource allocation over time, evaluation of cash flow, risk management, project evaluation, and asset pricing models.&quot;, &quot;credits&quot;: &quot;3&quot;, &quot;grading&quot;: &quot;Graded (GRD)&quot;, &quot;typically_offered&quot;: &quot;Spring&quot;, &quot;requisites&quot;: &quot;Pre-Requisite: ECO 405 and ECO 407 .&quot;, &quot;flexible&quot;: false, &quot;also_ubc&quot;: false}\" role=\"button\" tabindex=\"0\"><div class=\"box-label\"><span class=\"box-code\">ECO 426LEC</span><span class=\"box-title\">Financial Economics</span></div><span class=\"box-credits\">3 cr</span></div></div><div class=\"slot\"><div class=\"box box-course\" id=\"economics-bs__box-7-1-0\" data-detail=\"{&quot;kind&quot;: &quot;course&quot;, &quot;title&quot;: &quot;Labor Economics&quot;, &quot;description&quot;: &quot;This course provides a thorough introduction to the economic analysis of labor markets. The objective of this course are to understand economic models of markets of labor, to learn how labor economists use empirical methods to study labor market issues, and apply these models and methods to understand policy debates. It also examines wage differentials, unemployment, discrimination, and government regulation of wage-setting institutions.&quot;, &quot;credits&quot;: &quot;3&quot;, &quot;grading&quot;: &quot;Graded (GRD)&quot;, &quot;typically_offered&quot;: &quot;Spring&quot;, &quot;requisites&quot;: &quot;Pre-Requisite: ECO 405 and ECO 480 .&quot;, &quot;flexible&quot;: false, &quot;also_ubc&quot;: false}\" role=\"button\" tabindex=\"0\"><div class=\"box-label\"><span class=\"box-code\">ECO 443SEM</span><span class=\"box-title\">Labor Economics</span></div><span class=\"box-credits\">3 cr</span></div></div><div class=\"slot\"><div class=\"box box-course\" id=\"economics-bs__box-7-2-0\" data-detail=\"{&quot;kind&quot;: &quot;course&quot;, &quot;title&quot;: &quot;Time Series Analysis and Forecasting&quot;, &quot;description&quot;: &quot;This course considers alternative stochastic specifications of linear dynamic econometric models. It studies, among other topics, appropriate estimation techniques, the nature of the fluctuations of the major macroeconomic variables implied by the models, and the problem of forecasting. It emphasizes time-series models.&quot;, &quot;credits&quot;: &quot;3&quot;, &quot;grading&quot;: &quot;Graded (GRD)&quot;, &quot;typically_offered&quot;: &quot;Spring&quot;, &quot;requisites&quot;: &quot;Pre-Requisite: ECO 405 , ECO 407 and ECO 480 .&quot;, &quot;flexible&quot;: false, &quot;also_ubc&quot;: false}\" role=\"button\" tabindex=\"0\"><div class=\"box-label\"><span class=\"box-code\">ECO 461SEM</span><span class=\"box-title\">Time Series Analysis and Forecasting</span></div><span class=\"box-credits\">3 cr</span></div></div><div class=\"slot\"><div class=\"box box-course box-flexible\" id=\"economics-bs__box-7-3-0\" data-detail=\"{&quot;kind&quot;: &quot;generic&quot;, &quot;category&quot;: &quot;major_elective&quot;, &quot;description&quot;: &quot;\\&quot;Elective\\&quot; is an elective slot specific to this major&#x27;s own requirements, not a UB Curriculum-wide component - the exact eligible courses depend on this program&#x27;s requirements as listed in the Undergraduate Catalog.&quot;, &quot;catalog_url&quot;: &quot;https://catalogs.buffalo.edu/preview_program.php?catoid=21&amp;poid=7960&amp;returnto=1177&quot;}\" role=\"button\" tabindex=\"0\"><div class=\"box-eyebrow\"><span class=\"box-eyebrow-tag\">Elective in the major</span></div><div class=\"box-label\">Elective</div><span class=\"box-credits\">3 cr</span></div></div><div class=\"slot\"><div class=\"box box-course box-flexible\" id=\"economics-bs__box-7-4-0\" data-detail=\"{&quot;kind&quot;: &quot;generic&quot;, &quot;category&quot;: &quot;major_elective&quot;, &quot;description&quot;: &quot;\\&quot;Elective\\&quot; is an elective slot specific to this major&#x27;s own requirements, not a UB Curriculum-wide component - the exact eligible courses depend on this program&#x27;s requirements as listed in the Undergraduate Catalog.&quot;, &quot;catalog_url&quot;: &quot;https://catalogs.buffalo.edu/preview_program.php?catoid=21&amp;poid=7960&amp;returnto=1177&quot;}\" role=\"button\" tabindex=\"0\"><div class=\"box-eyebrow\"><span class=\"box-eyebrow-tag\">Elective in the major</span></div><div class=\"box-label\">Elective</div><span class=\"box-credits\">3 cr</span></div></div></div>\n        <div class=\"col-total\">120 credits</div>\n      </div></div></div></section>"}