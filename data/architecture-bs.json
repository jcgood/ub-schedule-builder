hitecture-bs__box-2-1-0&quot;, &quot;architecture-bs__box-3-0-0&quot;, &quot;architecture-bs__box-3-1-0&quot;], &quot;postreq&quot;: [&quot;architecture-bs__box-6-0-0&quot;, &quot;architecture-bs__box-6-1-0&quot;]}, &quot;architecture-bs__box-5-1-0&quot;: {&quot;prereq-immediate&quot;: [&quot;architecture-bs__box-4-0-0&quot;], &quot;prereq-sequence&quot;: [&quot;architecture-bs__box-0-1-0&quot;, &quot;architecture-bs__box-0-2-0&quot;, &quot;architecture-bs__box-0-3-0&quot;, &quot;architecture-bs__box-1-0-0&quot;, &quot;architecture-bs__box-1-3-0&quot;, &quot;architecture-bs__box-2-0-0&quot;, &quot;architecture-bs__box-2-1-0&quot;, &quot;architecture-bs__box-3-0-0&quot;, &quot;architecture-bs__box-3-1-0&quot;], &quot;postreq&quot;: [&quot;architecture-bs__box-6-1-0&quot;]}, &quot;architecture-bs__box-6-0-0&quot;: {&quot;prereq-immediate&quot;: [&quot;architecture-bs__box-5-0-0&quot;], &quot;prereq-sequence&quot;: [&quot;architecture-bs__box-0-1-0&quot;, &quot;architecture-bs__box-0-2-0&quot;, &quot;architecture-bs__box-0-3-0&quot;, &quot;architecture-bs__box-1-0-0&quot;, &quot;architecture-bs__box-1-3-0&quot;, &quot;architecture-bs__box-2-0-0&quot;, &quot;architecture-bs__box-2-1-0&quot;, &quot;architecture-bs__box-3-0-0&quot;, &quot;architecture-bs__box-3-1-0&quot;, &quot;architecture-bs__box-4-0-0&quot;], &quot;coreq-immediate&quot;: [&quot;architecture-bs__box-6-1-0&quot;]}, &quot;architecture-bs__box-6-1-0&quot;: {&quot;prereq-immediate&quot;: [&quot;architecture-bs__box-5-0-0&quot;, &quot;architecture-bs__box-5-1-0&quot;], &quot;prereq-sequence&quot;: [&quot;architecture-bs__box-0-1-0&quot;, &quot;architecture-bs__box-0-2-0&quot;, &quot;architecture-bs__box-0-3-0&quot;, &quot;architecture-bs__box-1-0-0&quot;, &quot;architecture-bs__box-1-3-0&quot;, &quot;architecture-bs__box-2-0-0&quot;, &quot;architecture-bs__box-2-1-0&quot;, &quot;architecture-bs__box-3-0-0&quot;, &quot;architecture-bs__box-3-1-0&quot;, &quot;architecture-bs__box-4-0-0&quot;], &quot;postcoreq&quot;: [&quot;architecture-bs__box-6-0-0&quot;]}}\"><div class=\"scroll-hint\">Scroll right for more semesters \u2192</div><div class=\"flow-scroll\"><div class=\"flow-container\">\n      <div class=\"semester-col term-fall\">\n        <div class=\"col-header\"><span class=\"col-year\">Year 1</span><span class=\"col-term\">Fall</span></div>\n        <div class=\"col-slots\"><div class=\"slot\"><div class=\"box box-generic\" id=\"architecture-bs__box-0-0-0\" data-detail=\"{&quot;kind&quot;: &quot;generic&quot;, &quot;category&quot;: &quot;ubc&quot;, &quot;description&quot;: &quot;UB Seminar: a 1- or 3-credit seminar every student completes in their first semester of enrollment, taught by faculty across departments around a &#x27;big idea&#x27; in the discipline. A UB Curriculum core requirement, not specific to this major.&quot;, &quot;catalog_url&quot;: &quot;https://www.buffalo.edu/ubcurriculum/seminar.html&quot;}\" role=\"button\" tabindex=\"0\"><div class=\"box-eyebrow\"><span class=\"box-eyebrow-tag box-ubc-tag\">UB Curriculum</span></div><div class=\"box-label\">UB Seminar</div><span class=\"box-credits\">3 cr</span><div class=\"box-note\">(NAAB non-ARC Liberal Arts)</div></div></div><div class=\"slot\"><div class=\"box box-course\" id=\"architecture-bs__box-0-1-0\" data-detail=\"{&quot;kind&quot;: &quot;course&quot;, &quot;title&quot;: &quot;Architectural Design Studio 1&quot;, &quot;description&quot;: &quot;Theme is visual communications and critical processes. Introduces two-dimensional and three-dimensional representation techniques for developing and presenting design concepts. Develops creative thinking and critical awareness in design. Cognitive understanding for spatial relationships present in structural, proportional, and site systems are introduced, combining geometry and graphics. Freehand drawings, 2-D and 3-D projections, shades, shadows, perspective, and reproduction techniques. Development of model-making skills utilizing various design media. Studio projects introduce a range of assignments for the making of both 2-D and 3-D environments. Introduces drawing and making as a mode of seeing and thinking.&quot;, &quot;credits&quot;: &quot;0&quot;, &quot;grading&quot;: &quot;Graded (GRD)&quot;, &quot;typically_offered&quot;: &quot;Fall&quot;, &quot;requisites&quot;: null, &quot;flexible&quot;: false, &quot;also_ubc&quot;: false}\" role=\"button\" tabindex=\"0\"><div class=\"box-label\"><span class=\"box-code\">ARC 101LAB</span><span class=\"box-title\">Architectural Design Studio 1 Lab</span></div><span class=\"box-credits\">5 cr</span></div></div><div class=\"slot\"><div class=\"box box-course\" id=\"architecture-bs__box-0-2-0\" data-detail=\"{&quot;kind&quot;: &quot;course&quot;, &quot;title&quot;: &quot;Introduction to Architecture&quot;, &quot;description&quot;: &quot;Introduces students to the vocabulary of architecture, and the understanding of design and applied arts in the human experience. Topics include historical examples of 19th and 20th century architecture, design, landscapes, and urbanism as a tool for developing an understanding and appreciation of the architecture discipline and its design objectives. Course material is drawn from numerous fields including architectural history the applied arts, design studies, philosophy, literature, and urban studies, all supporting Louis Kahn?s claim that architecture is \\u2018the handwriting of humanity.\\u2019 Students will gain critical insight on the contexts that drive concepts and ideas behind thoughtful design. As a vehicle for advancing an understanding of architectural design, the course will introduce students to 19th and 20th century architects and designers. An approved SUNY Arts and SUNY Humanities general education course.&quot;, &quot;credits&quot;: &quot;3&quot;, &quot;grading&quot;: &quot;Graded (GRD)&quot;, &quot;typically_offered&quot;: &quot;Fall&quot;, &quot;requisites&quot;: null, &quot;flexible&quot;: false, &quot;also_ubc&quot;: false}\" role=\"button\" tabindex=\"0\"><div class=\"box-label\"><span class=\"box-code\">ARC 121LEC</span><span class=\"box-title\">Introduction to Architecture</span></div><span class=\"box-credits\">3 cr</span></div></div><div class=\"slot\"><div class=\"box box-course box-flexible\" id=\"architecture-bs__box-0-3-0\" data-detail=\"{&quot;kind&quot;: &quot;course&quot;, &quot;title&quot;: &quot;Survey of Calculus and Its Applications I&quot;, &quot;description&quot;: &quot;For students in social, biological, and management sciences. Limits, continuity, differentiation of algebraic and exponential functions; applications; introduces integration.&quot;, &quot;credits&quot;: &quot;4&quot;, &quot;grading&quot;: &quot;Graded (GRD)&quot;, &quot;typically_offered&quot;: &quot;Fall, Spring, Summer, Winter&quot;, &quot;requisites&quot;: &quot;Pre-Requisite: Score of 70/100 or better on both the Fundamentals and the Algebra portions of the Math Readiness Assessment, or a C or better in ULC 148 , MTH 108 , MTH 113 , MTH 114 , MTH 115 , a D or better in MTH 121 or MTH 131 or MTH 141 or a score of 3 on AP Calculus or a score of 4 or 5 on AP Pre-Calculus.&quot;, &quot;flexible&quot;: true, &quot;also_ubc&quot;: true, &quot;catalog_url&quot;: &quot;https://catalogs.buffalo.edu/preview_program.php?catoid=21&amp;poid=7901&amp;returnto=1177&quot;, &quot;groups&quot;: [{&quot;requirement_type&quot;: &quot;choice_required&quot;, &quot;group&quot;: &quot;Architecture Core (90 credits) - Math requirement (choose 1 of 2)&quot;, &quot;courses&quot;: [{&quot;code&quot;: &quot;MTH 121LR&quot;, &quot;title&quot;: &quot;Survey of Calculus and Its Applications I&quot;}, {&quot;code&quot;: &quot;MTH 131LR&quot;, &quot;title&quot;: &quot;Mathematical Analysis for Management&quot;}]}]}\" role=\"button\" tabindex=\"0\"><div class=\"box-eyebrow\"><span class=\"box-eyebrow-tag\">full list on click</span><span class=\"box-eyebrow-sep\"> &middot; </span><span class=\"box-eyebrow-tag box-ubc-tag\">UB Curriculum</span></div><div class=\"box-label\">Architecture Core (90 credits) - Math requirement (choose 1 of 2)</div><span class=\"box-credits\">4 cr</span></div></div></div>\n        <div class=\"col-total\">15 credits</div>\n      </div>\n      <div class=\"semester-col term-spring\">\n        <div class=\"col-header\"><span class=\"col-year\">Year 1</span><span class=\"col-term\">Spring</span></div>\n        <div class=\"col-slots\"><div class=\"slot\"><div class=\"box box-course\" id=\"architecture-bs__box-1-0-0\" data-detail=\"{&quot;kind&quot;: &quot;course&quot;, &quot;title&quot;: &quot;Architectural Design Studio 2&quot;, &quot;description&quot;: &quot;Theme is techniques plus materiality and visual communications. Provides a working forum for developing creative thinking and critical awareness in design. Further examines two-dimensional and three-dimensional representation techniques for developing and presenting design concepts. Cognition for spatial relationships present in structural, proportional, and site systems are acquired via freehand drawings, 2-D and 3-D projections, shades, shadows, perspective, and design techniques. Further enhancement of model-making skills utilizing various design media. Advanced emphasis of 2-D and 3-D projections, shades, shadows, perspectives, and reproduction techniques. Studio projects introduce a range of assignments for the making of both 2-D and 3-D environments. There is a fee associated with this course.&quot;, &quot;credits&quot;: &quot;5&quot;, &quot;grading&quot;: &quot;Graded (GRD)&quot;, &quot;typically_offered&quot;: &quot;Spring&quot;, &quot;requisites&quot;: &quot;Pre-Requisite: ARC 101 and Architecture majors only.&quot;, &quot;flexible&quot;: false, &quot;also_ubc&quot;: false}\" role=\"button\" tabindex=\"0\"><div class=\"box-label\"><span class=\"box-code\">ARC 102LAB</span><span class=\"box-title\">Architectural Design Studio 2</span></div><span class=\"box-credits\">5 cr</span></div></div><div class=\"slot\"><div class=\"box box-course\" id=\"architecture-bs__box-1-1-0\" data-detail=\"{&quot;kind&quot;: &quot;course&quot;, &quot;title&quot;: &quot;American Diversity and Design&quot;, &quot;description&quot;: &quot;An approved SUNY Arts and SUNY American History general education course. Examines the history and diversity of cultural experiences within the United States and their attendant design issues. Specifically, the course concentrates on the ways in which our physical and media environments affect various populations in the U.S. and, in turn, the ways these populations have affected our designed environments. It introduces students to eight issues of U.S. diversity: race, ethnicity, gender, class, age, physical ability, cognitive ability, and religion. Writings, films, products, graphics, electronic media, buildings, and physical environments by and about diverse U.S. individuals and groups are examined. The U.S. history of our diverse physical and media environments are analyzed using theories and principles related to inclusive design. Open to all undergraduate University at Buffalo and SUNY students. Per the university repeat policy, ARC 211 may be used to replace the grade for UGC 211 , by petition only.&quot;, &quot;credits&quot;: &quot;3&quot;, &quot;grading&quot;: &quot;Graded (GRD)&quot;, &quot;typically_offered&quot;: &quot;Spring&quot;, &quot;requisites&quot;: null, &quot;flexible&quot;: false, &quot;also_ubc&quot;: false}\" role=\"button\" tabindex=\"0\"><div class=\"box-label\"><span class=\"box-code\">ARC 211LEC</span><span class=\"box-title\">American Diversity and Design</span></div><span class=\"box-credits\">3 cr</span><div class=\"box-note\">(NAAB non-ARC Liberal Arts)</div></div></div><div class=\"slot\"><div class=\"box box-course\" id=\"architecture-bs__box-1-2-0\" data-detail=\"{&quot;kind&quot;: &quot;course&quot;, &quot;title&quot;: &quot;Writing and Rhetoric&quot;, &quot;description&quot;: &quot;An introduction to research, writing, and rhetorical practices employed in academic and professional contexts. The course examines the operation of genres, the audiences they address, and the purposes they serve. The course focuses on the analysis and development of student writing and rhetorical practice. Assignments include research essays, digital compositions, and oral presentations.&quot;, &quot;credits&quot;: &quot;4&quot;, &quot;grading&quot;: &quot;Graded (GRD)&quot;, &quot;typically_offered&quot;: &quot;Fall, Spring, Summer&quot;, &quot;requisites&quot;: &quot;ENG 105 non-Z Requisite&quot;, &quot;flexible&quot;: false, &quot;also_ubc&quot;: true}\" role=\"button\" tabindex=\"0\"><div class=\"box-eyebrow\"><span class=\"box-eyebrow-tag box-ubc-tag\">UB Curriculum</span></div><div class=\"box-label\"><span class=\"box-code\">ENG 105LEC</span><span class=\"box-title\">Writing and Rhetoric</span></div><span class=\"box-credits\">4 cr</span><div class=\"box-note\">(NAAB non-ARC Liberal Arts)</div></div></div><div class=\"slot\"><div class=\"box box-course box-flexible\" id=\"architecture-bs__box-1-3-0\" data-detail=\"{&quot;kind&quot;: &quot;course&quot;, &quot;title&quot;: &quot;College Physics&quot;, &quot;description&quot;: &quot;Presents non-calculus, introductory physics, including mechanics, heat, waves, and sound. This course satisfies 4 credits as required by different majors, and also 4 credits (out of the mandated 7 credits total) of UB\\u2019s Scientific Literacy &amp; Inquiry Sequence general education requirements. This course is the same as AP 100, AED 101 &amp;nbsp;and course repeat rules will apply. Students should consult with their major department regarding any restrictions on their degree requirements.&quot;, &quot;credits&quot;: &quot;4&quot;, &quot;grading&quot;: &quot;Graded (GRD)&quot;, &quot;typically_offered&quot;: &quot;Fall, Spring, Summer, Winter&quot;, &quot;requisites&quot;: &quot;Enrollment is not allowed in PHY101 if a student has current enrollment in PHY 107 .&quot;, &quot;flexible&quot;: true, &quot;also_ubc&quot;: true, &quot;catalog_url&quot;: &quot;https://catalogs.buffalo.edu/preview_program.php?catoid=21&amp;poid=7901&amp;returnto=1177&quot;, &quot;groups&quot;: [{&quot;requirement_type&quot;: &quot;choice_required&quot;, &quot;group&quot;: &quot;Architecture Core (90 credits) - Physics requirement (choose 1 of 2)&quot;, &quot;courses&quot;: [{&quot;code&quot;: &quot;PHY 101LR&quot;, &quot;title&quot;: &quot;College Physics&quot;}, {&quot;code&quot;: &quot;AED 101LR&quot;, &quot;title&quot;: &quot;College Physics&quot;}]}]}\" role=\"button\" tabindex=\"0\"><div class=\"box-eyebrow\"><span class=\"box-eyebrow-tag\">full list on click</span><span class=\"box-eyebrow-sep\"> &middot; </span><span class=\"box-eyebrow-tag box-ubc-tag\">UB Curriculum</span></div><div class=\"box-label\">Architecture Core (90 credits) - Physics requirement (choose 1 of 2)</div><span class=\"box-credits\">4 cr</span></div></div></div>\n        <div class=\"col-total\">16 credits</div>\n      </div>\n      <div class=\"semester-col term-fall\">\n        <div class=\"col-header\"><span class=\"col-year\">Year 2</span><span class=\"col-term\">Fall</span></div>\n        <div class=\"col-slots\"><div class=\"slot\"><div class=\"box box-course\" id=\"architecture-bs__box-2-0-0\" data-detail=\"{&quot;kind&quot;: &quot;course&quot;, &quot;title&quot;: &quot;Architectural Design Studio 3&quot;, &quot;description&quot;: &quot;Theme is ancient architectural history and precedent. Emphasizes conceptualization, critical thinking, planning, and making. Analyzes the basic materials, methods, tools, and conventions of architectural design. Examines the connections between design precedent and the physical and visual environments. Project themes include transformation, connection, threshold, movement/storage, surface/structure, accessibility, and transition.&quot;, &quot;credits&quot;: &quot;6&quot;, &quot;grading&quot;: &quot;Graded (GRD)&quot;, &quot;typically_offered&quot;: &quot;Fall&quot;, &quot;requisites&quot;: &quot;Pre-Requisite: ARC 102 and Architecture majors only.&quot;, &quot;flexible&quot;: false, &quot;also_ubc&quot;: false}\" role=\"button\" tabindex=\"0\"><div class=\"box-label\"><span class=\"box-code\">ARC 201LAB</span><span class=\"box-title\">Architectural Design Studio 3</span></div><span class=\"box-credits\">6 cr</span></div></div><div class=\"slot\"><div class=\"box box-course\" id=\"architecture-bs__box-2-1-0\" data-detail=\"{&quot;kind&quot;: &quot;course&quot;, &quot;title&quot;: &quot;Introduction to Environmental Systems&quot;, &quot;description&quot;: &quot;Overview on interrelationship of the physical environment and buildings, specifically examining site design and environmental technologies, as they relate to environmental building systems design. More specifically, will develop an ability to respond to site characteristics including urban context, developmental patterning, zoning, soils, topography, ecology, climate, and building orientation. Students will also be introduced to the environmental technologies of lighting and acoustics including criteria relating to concepts and analysis in support of building systems design. Includes lectures, labs, field work, readings, exams, and projects.&quot;, &quot;credits&quot;: &quot;3&quot;, &quot;grading&quot;: &quot;Graded (GRD)&quot;, &quot;typically_offered&quot;: &quot;Fall&quot;, &quot;requisites&quot;: &quot;Pre-Requisite: MTH 121 or MTH 131 or MTH 141 or MTH 136 and MTH 137 . Co-Requisite: ARC 201&quot;, &quot;flexible&quot;: false, &quot;also_ubc&quot;: false}\" role=\"button\" tabindex=\"0\"><div class=\"box-label\"><span class=\"box-code\">ARC 241LEC</span><span class=\"box-title\">Introduction to Environmental Systems</span></div><span class=\"box-credits\">3 cr</span></div></div><div class=\"slot\"><div class=\"box box-course\" id=\"architecture-bs__box-2-2-0\" data-detail=\"{&quot;kind&quot;: &quot;course&quot;, &quot;title&quot;: &quot;Architecture History: Ancient - 1450&quot;, &quot;description&quot;: &quot;Introduces the development of urban and architectural form in a cultural context from the first settlements of Neolithic times to the consolidation of architecture as a discipline in the 1450s.&quot;, &quot;credits&quot;: &quot;4&quot;, &quot;grading&quot;: &quot;Graded (GRD)&quot;, &quot;typically_offered&quot;: &quot;Fall&quot;, &quot;requisites&quot;: null, &quot;flexible&quot;: false, &quot;also_ubc&quot;: false}\" role=\"button\" tabindex=\"0\"><div class=\"box-label\"><span class=\"box-code\">ARC 231LR</span><span class=\"box-title\">Architecture History: Ancient - 1450</span></div><span class=\"box-credits\">4 cr</span></div></div><div class=\"slot\"><div class=\"box box-generic\" id=\"architecture-bs__box-2-3-0\" data-detail=\"{&quot;kind&quot;: &quot;generic&quot;, &quot;category&quot;: &quot;ubc&quot;, &quot;description&quot;: &quot;Pathway: a UB Curriculum Thematic or Global Pathway course - part of at least four UB Areas/SUNY General Education categories a student&#x27;s Pathways coursework must satisfy across two Pathways (one Thematic, one Global).&quot;, &quot;catalog_url&quot;: &quot;https://www.buffalo.edu/ubcurriculum/pathways.html&quot;}\" role=\"button\" tabindex=\"0\"><div class=\"box-eyebrow\"><span class=\"box-eyebrow-tag box-ubc-tag\">UB Curriculum</span></div><div class=\"box-label\">Pathway</div><span class=\"box-credits\">3 cr</span><div class=\"box-note\">(NAAB non-ARC Liberal Arts)</div></div></div></div>\n        <div class=\"col-total\">16 credits</div>\n      </div>\n      <div class=\"semester-col term-spring\">\n        <div class=\"col-header\"><span class=\"col-year\">Year 2</span><span class=\"col-term\">Spring</span></div>\n        <div class=\"col-slots\"><div class=\"slot\"><div class=\"box box-course\" id=\"architecture-bs__box-3-0-0\" data-detail=\"{&quot;kind&quot;: &quot;course&quot;, &quot;title&quot;: &quot;Architectural Design Studio 4&quot;, &quot;description&quot;: &quot;Theme is modern architectural history and precedent. Emphasizes conceptualization, critical thinking, planning, and making. Analyzes the basic materials, methods, tools, and conventions of architectural design. Examines the connections between design precedent and the physical and visual environments. Project themes include transformation, connection, threshold, movement/storage, surface/structure, accessibility, and transition.&quot;, &quot;credits&quot;: &quot;6&quot;, &quot;grading&quot;: &quot;Graded (GRD)&quot;, &quot;typically_offered&quot;: &quot;Spring&quot;, &quot;requisites&quot;: &quot;Pre-Requisite: ARC 201 Co-Requisite: ARC 313&quot;, &quot;flexible&quot;: false, &quot;also_ubc&quot;: false}\" role=\"button\" tabindex=\"0\"><div class=\"box-label\"><span class=\"box-code\">ARC 202LAB</span><span class=\"box-title\">Architectural Design Studio 4</span></div><span class=\"box-credits\">6 cr</span></div></div><div class=\"slot\"><div class=\"box box-course\" id=\"architecture-bs__box-3-1-0\" data-detail=\"{&quot;kind&quot;: &quot;course&quot;, &quot;title&quot;: &quot;Structures I&quot;, &quot;description&quot;: &quot;Introduces the fundamentals of statics and strength of materials and the principals of structure. Provides a theoretical and scientific basis for understanding how various structural systems and structural materials work and withstand loading. Investigates the concepts introduced during the course with qualitative methods, as well as quantitative analysis. The course\\u2019s scope is includes examining simple structural elements, such as trusses, beams, and columns used throughout our human designed built environment.&quot;, &quot;credits&quot;: &quot;3&quot;, &quot;grading&quot;: &quot;Graded (GRD)&quot;, &quot;typically_offered&quot;: &quot;Spring&quot;, &quot;requisites&quot;: &quot;Pre-Requisite: ARC 121 and (PHY 101 or PHY 107 or AED 101 ) and (MTH 121 or MTH 131 or MTH 141 ).&quot;, &quot;flexible&quot;: false, &quot;also_ubc&quot;: true}\" role=\"button\" tabindex=\"0\"><div class=\"box-eyebrow\"><span class=\"box-eyebrow-tag box-ubc-tag\">UB Curriculum</span></div><div class=\"box-label\"><span class=\"box-code\">ARC 352LLB</span><span class=\"box-title\">Structures I</span></div><span class=\"box-credits\">3 cr</span></div></div><div class=\"slot\"><div class=\"box box-generic\" id=\"architecture-bs__box-3-2-0\" data-detail=\"{&quot;kind&quot;: &quot;generic&quot;, &quot;category&quot;: &quot;ubc&quot;, &quot;description&quot;: &quot;Pathway: a UB Curriculum Thematic or Global Pathway course - part of at least four UB Areas/SUNY General Education categories a student&#x27;s Pathways coursework must satisfy across two Pathways (one Thematic, one Global).&quot;, &quot;catalog_url&quot;: &quot;https://www.buffalo.edu/ubcurriculum/pathways.html&quot;}\" role=\"button\" tabindex=\"0\"><div class=\"box-eyebrow\"><span class=\"box-eyebrow-tag box-ubc-tag\">UB Curriculum</span></div><div class=\"box-label\">Pathway</div><span class=\"box-credits\">3 cr</span><div class=\"box-note\">(NAAB non-ARC Liberal Arts)</div></div></div><div class=\"slot\"><div class=\"box box-course\" id=\"architecture-bs__box-3-3-0\" data-detail=\"{&quot;kind&quot;: &quot;course&quot;, &quot;title&quot;: &quot;Architecture Media&quot;, &quot;description&quot;: &quot;Introduces students to techniques of representation with emphases on the description of part/whole relationships: (proto)types and their variations. Course assignments will develop a range of skills including: understanding of formal organizations as systems of interrelated parts; Rhinoceros (advanced modeling); 3D printing. Digital media skills introduced will be coordinated with course material from ARC 202: Architecture Design Studio 4.&quot;, &quot;credits&quot;: &quot;3&quot;, &quot;grading&quot;: &quot;Graded&quot;, &quot;typically_offered&quot;: &quot;Spring&quot;, &quot;requisites&quot;: &quot;Pre-Requisite: Architecture majors only. Co-Requisite: ARC 202 . Students must register for ARC 202 and ARC 313LEC concurrently.&quot;, &quot;flexible&quot;: false, &quot;also_ubc&quot;: false}\" role=\"button\" tabindex=\"0\"><div class=\"box-label\"><span class=\"box-code\">ARC 313LEC</span><span class=\"box-title\">Architecture Media</span></div><span class=\"box-credits\">3 cr</span></div></div></div>\n        <div class=\"col-total\">15 credits</div>\n      </div>\n      <div class=\"semester-col term-fall\">\n        <div class=\"col-header\"><span class=\"col-year\">Year 3</span><span class=\"col-term\">Fall</span></div>\n        <div class=\"col-slots\"><div class=\"slot\"><div class=\"box box-course\" id=\"architecture-bs__box-4-0-0\" data-detail=\"{&quot;kind&quot;: &quot;course&quot;, &quot;title&quot;: &quot;Architectural Design Studio 5&quot;, &quot;description&quot;: &quot;Theme is systems and subjectivity. Synthesizes design fundamentals with architectural design. Includes the theme of transformation to convert various aspects of architectural design-form, spatiality, materiality, structure, construction, use, site conditions, context, aesthetics, zoning, codes, accessibility, and cultural conditions.&quot;, &quot;credits&quot;: &quot;6&quot;, &quot;grading&quot;: &quot;Graded (GRD)&quot;, &quot;typically_offered&quot;: &quot;Fall&quot;, &quot;requisites&quot;: &quot;Pre-Requisite: ARC 202 , ARC 241 , ARC 352 /ARC 352 , and Architecture majors only.&quot;, &quot;flexible&quot;: false, &quot;also_ubc&quot;: false}\" role=\"button\" tabindex=\"0\"><div class=\"box-label\"><span class=\"box-code\">ARC 301LAB</span><span class=\"box-title\">Architectural Design Studio 5</span></div><span class=\"box-credits\">6 cr</span></div></div><div class=\"slot\"><div class=\"box box-course\" id=\"architecture-bs__box-4-1-0\" data-detail=\"{&quot;kind&quot;: &quot;course&quot;, &quot;title&quot;: &quot;Structures 2&quot;, &quot;description&quot;: &quot;Concentrates on the study and investigation of various structural materials, connections and details. Students study various design criteria for specific materials, such as timber, steel, and concrete, and are introduced to the proper use of various building codes in the structural design process.&quot;, &quot;credits&quot;: &quot;3&quot;, &quot;grading&quot;: &quot;Graded (GRD)&quot;, &quot;typically_offered&quot;: &quot;Fall&quot;, &quot;requisites&quot;: &quot;Pre-Requisites: ARC 352 and Architecture major / minor only.&quot;, &quot;flexible&quot;: false, &quot;also_ubc&quot;: false}\" role=\"button\" tabindex=\"0\"><div class=\"box-label\"><span class=\"box-code\">ARC 453LLB</span><span class=\"box-title\">Structures 2</span></div><span class=\"box-credits\">3 cr</span></div></div><div class=\"slot\"><div class=\"box box-course\" id=\"architecture-bs__box-4-2-0\" data-detail=\"{&quot;kind&quot;: &quot;course&quot;, &quot;title&quot;: &quot;Environmental Controls: Thermal Environmental Systems&quot;, &quot;description&quot;: &quot;A majors-only course. Examines active systems of climate control in buildings and their relation to energy management. Assesses evaluation and selection of mechanical equipment systems, cost implications, and effectiveness. Investigates design considerations of integrating various building systems, including: mechanical, electrical, and plumbing systems; heating, ventilation, and air-conditioning (HVAC) equipment; water; and wastewater systems. Introduces sanitation, fire protection, and vertical transportation systems. Considers techniques for solar heating, passive cooling, indoor air quality, and human health.&quot;, &quot;credits&quot;: &quot;3&quot;, &quot;grading&quot;: &quot;Graded (GRD)&quot;, &quot;typically_offered&quot;: &quot;Fall&quot;, &quot;requisites&quot;: &quot;Pre-Requisite: ARC 241 and ARC 202 and Architecture Major or ARC 324 and Architecture Minor.&quot;, &quot;flexible&quot;: false, &quot;also_ubc&quot;: false}\" role=\"button\" tabindex=\"0\"><div class=\"box-label\"><span class=\"box-code\">ARC 473LEC</span><span class=\"box-title\">Environmental Controls: Thermal Environmental Systems</span></div><span class=\"box-credits\">3 cr</span></div></div><div class=\"slot\"><div class=\"box box-generic\" id=\"architecture-bs__box-4-3-0\" data-detail=\"{&quot;kind&quot;: &quot;generic&quot;, &quot;category&quot;: &quot;ubc&quot;, &quot;description&quot;: &quot;Pathway: a UB Curriculum Thematic or Global Pathway course - part of at least four UB Areas/SUNY General Education categories a student&#x27;s Pathways coursework must satisfy across two Pathways (one Thematic, one Global).&quot;, &quot;catalog_url&quot;: &quot;https://www.buffalo.edu/ubcurriculum/pathways.html&quot;}\" role=\"button\" tabindex=\"0\"><div class=\"box-eyebrow\"><span class=\"box-eyebrow-tag box-ubc-tag\">UB Curriculum</span></div><div class=\"box-label\">Pathway</div><span class=\"box-credits\">3 cr</span><div class=\"box-note\">(NAAB non-ARC Liberal Arts)</div></div></div></div>\n        <div class=\"col-total\">15 credits</div>\n      </div>\n      <div class=\"semester-col term-spring\">\n        <div class=\"col-header\"><span class=\"col-year\">Year 3</span><span class=\"col-term\">Spring</span></div>\n        <div class=\"col-slots\"><div class=\"slot\"><div class=\"box box-course\" id=\"architecture-bs__box-5-0-0\" data-detail=\"{&quot;kind&quot;: &quot;course&quot;, &quot;title&quot;: &quot;Architectural Design Studio 6&quot;, &quot;description&quot;: &quot;Theme is models, organizations, and environments. Synthesizes design fundamentals with architectural design. Uses organization and environment to convert various aspects of architectural design-form, precedent, spatiality, systems, preparation, use, context, aesthetics, construction, collaboration, and human behavior.&quot;, &quot;credits&quot;: &quot;6&quot;, &quot;grading&quot;: &quot;Graded (GRD)&quot;, &quot;typically_offered&quot;: &quot;Spring&quot;, &quot;requisites&quot;: &quot;Pre-Requisite: ARC 301 and Architecture majors only. Co-Requisite: ARC 412LEC. Students must register for ARC 412LEC and ARC 302LAB concurrently.&quot;, &quot;flexible&quot;: false, &quot;also_ubc&quot;: false}\" role=\"button\" tabindex=\"0\"><div class=\"box-label\"><span class=\"box-code\">ARC 302LAB</span><span class=\"box-title\">Architectural Design Studio 6</span></div><span class=\"box-credits\">6 cr</span></div></div><div class=\"slot\"><div class=\"box box-course\" id=\"architecture-bs__box-5-1-0\" data-detail=\"{&quot;kind&quot;: &quot;course&quot;, &quot;title&quot;: &quot;Construction Technology&quot;, &quot;description&quot;: &quot;A structures/construction course. Emphasizes details of construction. Examines interfaces of materials and systems: foundation/wall, wall/window, wall/roof, floor/wall, etc. Investigates the effect of materials and processes on appearance and life of building components. Studies interior and exterior finishes, joints, fire protection, and specification.&quot;, &quot;credits&quot;: &quot;4&quot;, &quot;grading&quot;: &quot;Graded (GRD)&quot;, &quot;typically_offered&quot;: &quot;Spring&quot;, &quot;requisites&quot;: &quot;Pre-Requisite: ARC 301 and Architecture majors only.&quot;, &quot;flexible&quot;: false, &quot;also_ubc&quot;: false}\" role=\"button\" tabindex=\"0\"><div class=\"box-label\"><span class=\"box-code\">ARC 442LLB</span><span class=\"box-title\">Construction Technology</span></div><span class=\"box-credits\">4 cr</span></div></div><div class=\"slot\"><div class=\"box box-generic\" id=\"architecture-bs__box-5-2-0\" data-detail=\"{&quot;kind&quot;: &quot;generic&quot;, &quot;category&quot;: &quot;ubc&quot;, &quot;description&quot;: &quot;Communication Literacy 2: a UB Curriculum Foundations requirement, completed from an approved list of discipline-specific writing courses (see the Undergraduate Catalog&#x27;s Communication Literacy II list).&quot;, &quot;catalog_url&quot;: &quot;https://www.buffalo.edu/ubcurriculum/foundations.html&quot;}\" role=\"button\" tabindex=\"0\"><div class=\"box-eyebrow\"><span class=\"box-eyebrow-tag box-ubc-tag\">UB Curriculum</span></div><div class=\"box-label\">Communication Literacy 2</div><span class=\"box-credits\">3 cr</span><div class=\"box-note\">(NAAB non-ARC Liberal Arts)</div></div></div><div class=\"slot\"><div class=\"box box-course\" id=\"architecture-bs__box-5-3-0\" data-detail=\"{&quot;kind&quot;: &quot;course&quot;, &quot;title&quot;: &quot;Architecture History: 1450 - Present&quot;, &quot;description&quot;: &quot;Introduces the fundamentals of architectural design from the theory and practice of the 1450\\u2019s to the built and written manifestos of modern times. Situates the evolution of the architectural discipline within the context of social, cognitive and technological transformation.&quot;, &quot;credits&quot;: &quot;4&quot;, &quot;grading&quot;: &quot;Graded (GRD)&quot;, &quot;typically_offered&quot;: &quot;Spring&quot;, &quot;requisites&quot;: null, &quot;flexible&quot;: false, &quot;also_ubc&quot;: false}\" role=\"button\" tabindex=\"0\"><div class=\"box-label\"><span class=\"box-code\">ARC 234LR</span><span class=\"box-title\">Architecture History: 1450 - Present</span></div><span class=\"box-credits\">4 cr</span></div></div></div>\n        <div class=\"col-total\">17 credits</div>\n      </div>\n      <div class=\"semester-col term-fall\">\n        <div class=\"col-header\"><span class=\"col-year\">Year 4</span><span class=\"col-term\">Fall</span></div>\n        <div class=\"col-slots\"><div class=\"slot\"><div class=\"box box-course\" id=\"architecture-bs__box-6-0-0\" data-detail=\"{&quot;kind&quot;: &quot;course&quot;, &quot;title&quot;: &quot;Architectural Theory&quot;, &quot;description&quot;: &quot;Overview of architectural theory and approaches. Examines architectural theory as applied to building design, using architectural theory as a basis for developing design paradigms. Introduces research methods used in architectural theory.&quot;, &quot;credits&quot;: &quot;3&quot;, &quot;grading&quot;: &quot;Graded (GRD)&quot;, &quot;typically_offered&quot;: &quot;Fall&quot;, &quot;requisites&quot;: &quot;Pre-Requisite: ARC 302 and Architecture majors only. Co-Requisite: ARC 403 . Students must register for ARC 403 and ARC 463LEC concurrently.&quot;, &quot;flexible&quot;: false, &quot;also_ubc&quot;: false}\" role=\"button\" tabindex=\"0\"><div class=\"box-label\"><span class=\"box-code\">ARC 463LEC</span><span class=\"box-title\">Architectural Theory</span></div><span class=\"box-credits\">3 cr</span></div></div><div class=\"slot\"><div class=\"box box-course\" id=\"architecture-bs__box-6-1-0\" data-detail=\"{&quot;kind&quot;: &quot;course&quot;, &quot;title&quot;: &quot;Architectural Design Studio 7&quot;, &quot;description&quot;: &quot;Theme is comprehensive design. Uses comprehensive architectural projects to address the complexity of the discipline-site conditions, construction technology, programming, research methods, life safety and accessibility, codes and standards, building systems, representation, documentation, and comprehensive design. Examines the values and ideologies architects bring forward in their work.&quot;, &quot;credits&quot;: &quot;6&quot;, &quot;grading&quot;: &quot;Graded (GRD)&quot;, &quot;typically_offered&quot;: &quot;Fall&quot;, &quot;requisites&quot;: &quot;Pre-Requisites: ARC 302 and ARC 442 . Co-Requisites: ARC 362LEC. Students must register for ARC 403LAB and ARC 362LEC concurrently.&quot;, &quot;flexible&quot;: false, &quot;also_ubc&quot;: false}\" role=\"button\" tabindex=\"0\"><div class=\"box-label\"><span class=\"box-code\">ARC 403LAB</span><span class=\"box-title\">Architectural Design Studio 7</span></div><span class=\"box-credits\">6 cr</span></div></div><div class=\"slot\"><div class=\"box box-course box-flexible\" id=\"architecture-bs__box-6-2-0\" data-detail=\"{&quot;kind&quot;: &quot;generic&quot;, &quot;category&quot;: &quot;major_elective&quot;, &quot;description&quot;: &quot;\\&quot;Pathway Credits or NAAB non-ARC LAS Elective\\&quot; is an elective slot specific to this major&#x27;s own requirements, not a UB Curriculum-wide component - the exact eligible courses depend on this program&#x27;s requirements as listed in the Undergraduate Catalog.&quot;, &quot;catalog_url&quot;: &quot;https://catalogs.buffalo.edu/preview_program.php?catoid=21&amp;poid=7901&amp;returnto=1177&quot;}\" role=\"button\" tabindex=\"0\"><div class=\"box-eyebrow\"><span class=\"box-eyebrow-tag\">Elective in the major</span></div><div class=\"box-label\">Pathway Credits or NAAB non-ARC LAS Elective</div><span class=\"box-credits\">3 cr</span></div></div><div class=\"slot\"><div class=\"box box-course box-flexible\" id=\"architecture-bs__box-6-3-0\" data-detail=\"{&quot;kind&quot;: &quot;generic&quot;, &quot;category&quot;: &quot;major_elective&quot;, &quot;description&quot;: &quot;\\&quot;Pathway Credits or NAAB non-ARC LAS Elective\\&quot; is an elective slot specific to this major&#x27;s own requirements, not a UB Curriculum-wide component - the exact eligible courses depend on this program&#x27;s requirements as listed in the Undergraduate Catalog.&quot;, &quot;catalog_url&quot;: &quot;https://catalogs.buffalo.edu/preview_program.php?catoid=21&amp;poid=7901&amp;returnto=1177&quot;}\" role=\"button\" tabindex=\"0\"><div class=\"box-eyebrow\"><span class=\"box-eyebrow-tag\">Elective in the major</span></div><div class=\"box-label\">Pathway Credits or NAAB non-ARC LAS Elective</div><span class=\"box-credits\">3 cr</span></div></div><div class=\"slot\"><div class=\"box box-course\" id=\"architecture-bs__box-6-4-0\" data-detail=\"{&quot;kind&quot;: &quot;course&quot;, &quot;title&quot;: &quot;UB Curriculum Capstone&quot;, &quot;description&quot;: &quot;UB Curriculum Capstone (UBC 399) is the culminating general education requirement. It is a one-credit course in which you will work in UBPortfolio, with the support of your Capstone instructor, to create a reflective and integrative Capstone ePortfolio based on your UB Curriculum coursework and lived experiences outside of the classroom. All UB Curriculum courses must be completed or in-progress to enroll in and complete UBC 399. Students who drop an in-progress course will be removed from UBC 399 through the add/drop period. Students who resign an in-progress course may not be able to successfully complete the Capstone.&quot;, &quot;credits&quot;: &quot;1&quot;, &quot;grading&quot;: &quot;Graded (GRD)&quot;, &quot;typically_offered&quot;: &quot;Fall, Spring&quot;, &quot;requisites&quot;: &quot;All UB Curriculum courses must be completed or in-progress to enroll in and complete UBC 399. UB Seminar is a prerequisite to UBC 399 and therefore cannot be taken concurrently. If you enrolled today in your remaining UBC course(s), HUB will allow you to enroll tomorrow. For questions, email: ubcurriculum@buffalo.edu.&quot;, &quot;flexible&quot;: false, &quot;also_ubc&quot;: true}\" role=\"button\" tabindex=\"0\"><div class=\"box-eyebrow\"><span class=\"box-eyebrow-tag box-ubc-tag\">UB Curriculum</span></div><div class=\"box-label\"><span class=\"box-code\">UBC 399MNT</span><span class=\"box-title\">UB Curriculum Capstone</span></div><span class=\"box-credits\">1 cr</span><div class=\"box-note\">(NAAB non-ARC Liberal Arts)</div></div></div></div>\n        <div class=\"col-total\">16 credits</div>\n      </div>\n      <div class=\"semester-col term-spring\">\n        <div class=\"col-header\"><span class=\"col-year\">Year 4</span><span class=\"col-term\">Spring</span></div>\n        <div class=\"col-slots\"><div class=\"slot\"><div class=\"box box-course\" id=\"architecture-bs__box-7-0-0\" data-detail=\"{&quot;kind&quot;: &quot;course&quot;, &quot;title&quot;: &quot;Architecture Design Practicum&quot;, &quot;description&quot;: &quot;Theme is advanced topics in architecture and design. Uses comprehensive architectural projects to address the complexity of the discipline \\u2013 site conditions, construction technology, programming, safety and accessibility, codes and standards, and representation. Examines the values and ideologies that architects bring forward in their work.&quot;, &quot;credits&quot;: &quot;6&quot;, &quot;grading&quot;: &quot;Graded (GRD)&quot;, &quot;typically_offered&quot;: &quot;Spring&quot;, &quot;requisites&quot;: &quot;Pre-Requisite: Architecture BS students only.Senior standing required.&quot;, &quot;flexible&quot;: false, &quot;also_ubc&quot;: false}\" role=\"button\" tabindex=\"0\"><div class=\"box-label\"><span class=\"box-code\">ARC 404STU</span><span class=\"box-title\">Architecture Design Practicum</span></div><span class=\"box-credits\">6 cr</span></div></div><div class=\"slot\"><div class=\"box box-generic\" id=\"architecture-bs__box-7-1-0\" data-detail=\"{&quot;kind&quot;: &quot;generic&quot;, &quot;category&quot;: &quot;ubc&quot;, &quot;description&quot;: &quot;Pathway: a UB Curriculum Thematic or Global Pathway course - part of at least four UB Areas/SUNY General Education categories a student&#x27;s Pathways coursework must satisfy across two Pathways (one Thematic, one Global).&quot;, &quot;catalog_url&quot;: &quot;https://www.buffalo.edu/ubcurriculum/pathways.html&quot;}\" role=\"button\" tabindex=\"0\"><div class=\"box-eyebrow\"><span class=\"box-eyebrow-tag box-ubc-tag\">UB Curriculum</span></div><div class=\"box-label\">Pathway</div><span class=\"box-credits\">3 cr</span></div></div><div class=\"slot\"><div class=\"box box-course box-flexible\" id=\"architecture-bs__box-7-2-0\" data-detail=\"{&quot;kind&quot;: &quot;generic&quot;, &quot;category&quot;: &quot;major_elective&quot;, &quot;description&quot;: &quot;\\&quot;Liberal Arts and Sciences Elective\\&quot; is an elective slot specific to this major&#x27;s own requirements, not a UB Curriculum-wide component - the exact eligible courses depend on this program&#x27;s requirements as listed in the Undergraduate Catal