{"panel_html": "<section class=\"panel rel-scope active\" id=\"panel-container\" data-rel=\"{&quot;ai-and-geospatial-analytics-bs__box-0-1-0&quot;: {&quot;postreq&quot;: [&quot;ai-and-geospatial-analytics-bs__box-1-0-0&quot;, &quot;ai-and-geospatial-analytics-bs__box-6-2-0&quot;, &quot;ai-and-geospatial-analytics-bs__box-5-0-0&quot;, &quot;ai-and-geospatial-analytics-bs__box-7-0-0&quot;]}, &quot;ai-and-geospatial-analytics-bs__box-1-0-0&quot;: {&quot;prereq-immediate&quot;: [&quot;ai-and-geospatial-analytics-bs__box-0-1-0&quot;], &quot;postreq&quot;: [&quot;ai-and-geospatial-analytics-bs__box-5-0-0&quot;, &quot;ai-and-geospatial-analytics-bs__box-7-0-0&quot;]}, &quot;ai-and-geospatial-analytics-bs__box-1-1-0&quot;: {&quot;postreq&quot;: [&quot;ai-and-geospatial-analytics-bs__box-2-4-0&quot;]}, &quot;ai-and-geospatial-analytics-bs__box-2-0-0&quot;: {&quot;postreq&quot;: [&quot;ai-and-geospatial-analytics-bs__box-7-0-0&quot;]}, &quot;ai-and-geospatial-analytics-bs__box-2-3-0&quot;: {&quot;postreq&quot;: [&quot;ai-and-geospatial-analytics-bs__box-5-2-0&quot;]}, &quot;ai-and-geospatial-analytics-bs__box-2-4-0&quot;: {&quot;prereq-immediate&quot;: [&quot;ai-and-geospatial-analytics-bs__box-1-1-0&quot;]}, &quot;ai-and-geospatial-analytics-bs__box-3-0-0&quot;: {&quot;postreq&quot;: [&quot;ai-and-geospatial-analytics-bs__box-7-0-0&quot;]}, &quot;ai-and-geospatial-analytics-bs__box-4-0-0&quot;: {&quot;postreq&quot;: [&quot;ai-and-geospatial-analytics-bs__box-7-0-0&quot;]}, &quot;ai-and-geospatial-analytics-bs__box-4-1-0&quot;: {&quot;postreq&quot;: [&quot;ai-and-geospatial-analytics-bs__box-5-0-0&quot;, &quot;ai-and-geospatial-analytics-bs__box-7-0-0&quot;]}, &quot;ai-and-geospatial-analytics-bs__box-4-2-0&quot;: {&quot;postreq&quot;: [&quot;ai-and-geospatial-analytics-bs__box-6-2-0&quot;, &quot;ai-and-geospatial-analytics-bs__box-7-1-0&quot;]}, &quot;ai-and-geospatial-analytics-bs__box-5-0-0&quot;: {&quot;prereq-immediate&quot;: [&quot;ai-and-geospatial-analytics-bs__box-1-0-0&quot;, &quot;ai-and-geospatial-analytics-bs__box-4-1-0&quot;], &quot;prereq-sequence&quot;: [&quot;ai-and-geospatial-analytics-bs__box-0-1-0&quot;], &quot;postreq&quot;: [&quot;ai-and-geospatial-analytics-bs__box-7-0-0&quot;]}, &quot;ai-and-geospatial-analytics-bs__box-5-2-0&quot;: {&quot;prereq-immediate&quot;: [&quot;ai-and-geospatial-analytics-bs__box-2-3-0&quot;]}, &quot;ai-and-geospatial-analytics-bs__box-6-2-0&quot;: {&quot;prereq-immediate&quot;: [&quot;ai-and-geospatial-analytics-bs__box-0-1-0&quot;, &quot;ai-and-geospatial-analytics-bs__box-4-2-0&quot;]}, &quot;ai-and-geospatial-analytics-bs__box-7-0-0&quot;: {&quot;prereq-immediate&quot;: [&quot;ai-and-geospatial-analytics-bs__box-2-0-0&quot;, &quot;ai-and-geospatial-analytics-bs__box-3-0-0&quot;, &quot;ai-and-geospatial-analytics-bs__box-4-0-0&quot;, &quot;ai-and-geospatial-analytics-bs__box-5-0-0&quot;], &quot;prereq-sequence&quot;: [&quot;ai-and-geospatial-analytics-bs__box-0-1-0&quot;, &quot;ai-and-geospatial-analytics-bs__box-1-0-0&quot;, &quot;ai-and-geospatial-analytics-bs__box-4-1-0&quot;]}, &quot;ai-and-geospatial-analytics-bs__box-7-1-0&quot;: {&quot;prereq-immediate&quot;: [&quot;ai-and-geospatial-analytics-bs__box-4-2-0&quot;]}}\"><div class=\"scroll-hint\">Scroll right for more semesters \u2192</div><div class=\"flow-scroll\"><div class=\"flow-container\">\n      <div class=\"semester-col term-fall\">\n        <div class=\"col-header\"><span class=\"col-year\">Year 1</span><span class=\"col-term\">Fall</span></div>\n        <div class=\"col-slots\"><div class=\"slot\"><div class=\"box box-generic\" id=\"ai-and-geospatial-analytics-bs__box-0-0-0\" data-detail=\"{&quot;kind&quot;: &quot;generic&quot;, &quot;category&quot;: &quot;ubc&quot;, &quot;description&quot;: &quot;UB Seminar: a 1- or 3-credit seminar every student completes in their first semester of enrollment, taught by faculty across departments around a &#x27;big idea&#x27; in the discipline. A UB Curriculum core requirement, not specific to this major.&quot;, &quot;catalog_url&quot;: &quot;https://www.buffalo.edu/ubcurriculum/seminar.html&quot;}\" role=\"button\" tabindex=\"0\"><div class=\"box-eyebrow\"><span class=\"box-eyebrow-tag box-ubc-tag\">UB Curriculum</span></div><div class=\"box-label\">UB Seminar</div><span class=\"box-credits\">3 cr</span></div></div><div class=\"slot\"><div class=\"box box-course\" id=\"ai-and-geospatial-analytics-bs__box-0-1-0\" data-detail=\"{&quot;kind&quot;: &quot;course&quot;, &quot;title&quot;: &quot;Introduction to Computer Science I&quot;, &quot;description&quot;: &quot;Provides the fundamentals of computer science with an emphasis on applying programming skills to solve problems and increase human efficiency. Topics include variables, data types, expressions, control flow, functions, input/output, data storage, networking, security, selection, sorting, iteration and the use of aggregate data structures such as lists and more general collections. No previous programming experience required.&quot;, &quot;credits&quot;: &quot;4&quot;, &quot;grading&quot;: &quot;Graded (GRD)&quot;, &quot;typically_offered&quot;: &quot;Fall, Spring, Summer&quot;, &quot;requisites&quot;: null, &quot;flexible&quot;: false, &quot;also_ubc&quot;: false}\" role=\"button\" tabindex=\"0\"><div class=\"box-label\"><span class=\"box-code\">CSE 115LLR</span><span class=\"box-title\">Introduction to Computer Science I</span></div><span class=\"box-credits\">4 cr</span></div></div><div class=\"slot\"><div class=\"box box-course box-flexible\" id=\"ai-and-geospatial-analytics-bs__box-0-2-0\" data-detail=\"{&quot;kind&quot;: &quot;generic&quot;, &quot;category&quot;: &quot;major_elective&quot;, &quot;description&quot;: &quot;\\&quot;Elective\\&quot; is an elective slot specific to this major&#x27;s own requirements, not a UB Curriculum-wide component - the exact eligible courses depend on this program&#x27;s requirements as listed in the Undergraduate Catalog.&quot;, &quot;catalog_url&quot;: &quot;https://catalogs.buffalo.edu/preview_program.php?catoid=21&amp;poid=8482&amp;returnto=1177&quot;}\" role=\"button\" tabindex=\"0\"><div class=\"box-eyebrow\"><span class=\"box-eyebrow-tag\">Elective in the major</span></div><div class=\"box-label\">Elective</div><span class=\"box-credits\">4 cr</span></div></div><div class=\"slot\"><div class=\"or-group\"><div class=\"box box-course\" id=\"ai-and-geospatial-analytics-bs__box-0-3-0\" data-detail=\"{&quot;kind&quot;: &quot;course&quot;, &quot;title&quot;: &quot;Writing and Rhetoric&quot;, &quot;description&quot;: &quot;An introduction to research, writing, and rhetorical practices employed in academic and professional contexts. The course examines the operation of genres, the audiences they address, and the purposes they serve. The course focuses on the analysis and development of student writing and rhetorical practice. Assignments include research essays, digital compositions, and oral presentations.&quot;, &quot;credits&quot;: &quot;4&quot;, &quot;grading&quot;: &quot;Graded (GRD)&quot;, &quot;typically_offered&quot;: &quot;Fall, Spring, Summer&quot;, &quot;requisites&quot;: &quot;ENG 105 non-Z Requisite&quot;, &quot;flexible&quot;: false, &quot;also_ubc&quot;: true}\" role=\"button\" tabindex=\"0\"><div class=\"box-eyebrow\"><span class=\"box-eyebrow-tag box-ubc-tag\">UB Curriculum</span></div><div class=\"box-label\"><span class=\"box-code\">ENG 105LEC</span><span class=\"box-title\">Writing and Rhetoric</span></div><span class=\"box-credits\">4 cr</span><div class=\"box-note\">(may also be completed in a different semester shown)</div></div><div class=\"or-sep\">or</div><div class=\"box box-generic\" id=\"ai-and-geospatial-analytics-bs__box-0-3-1\" data-detail=\"{&quot;kind&quot;: &quot;generic&quot;, &quot;category&quot;: &quot;ubc&quot;, &quot;description&quot;: &quot;Pathway: a UB Curriculum Thematic or Global Pathway course - part of at least four UB Areas/SUNY General Education categories a student&#x27;s Pathways coursework must satisfy across two Pathways (one Thematic, one Global).&quot;, &quot;catalog_url&quot;: &quot;https://www.buffalo.edu/ubcurriculum/pathways.html&quot;}\" role=\"button\" tabindex=\"0\"><div class=\"box-eyebrow\"><span class=\"box-eyebrow-tag box-ubc-tag\">UB Curriculum</span></div><div class=\"box-label\">Pathway</div><span class=\"box-credits\">3 cr</span></div></div></div></div>\n        <div class=\"col-total\">14 or 15 credits</div>\n      </div>\n      <div class=\"semester-col term-spring\">\n        <div class=\"col-header\"><span class=\"col-year\">Year 1</span><span class=\"col-term\">Spring</span></div>\n        <div class=\"col-slots\"><div class=\"slot\"><div class=\"box box-course\" id=\"ai-and-geospatial-analytics-bs__box-1-0-0\" data-detail=\"{&quot;kind&quot;: &quot;course&quot;, &quot;title&quot;: &quot;Introduction to Computer Science II&quot;, &quot;description&quot;: &quot;Students will continue to develop the skills introduced in CSE 115 while exploring the details of program execution and the structure of large programs. Emphasizes design decisions that affect the efficiency, expandability, and maintainability of code while analyzing the differences amongst a variety of approaches. Design decisions analyzed include choice of data structures and object-oriented techniques such as encapsulation, polymorphism, and inheritance. Additional topics include the use of recursion, multithreading, parallelism, hardware, graph and tree traversals, asymptotic analysis, divide and conquer, databases, testing, and multi-language integration.&quot;, &quot;credits&quot;: &quot;4&quot;, &quot;grading&quot;: &quot;Graded (GRD)&quot;, &quot;typically_offered&quot;: &quot;Fall, Spring, Summer&quot;, &quot;requisites&quot;: &quot;Pre-Requisite: CSE 115 or EAS 230 or EAS 240 or EAS 999TRCP .&quot;, &quot;flexible&quot;: false, &quot;also_ubc&quot;: false}\" role=\"button\" tabindex=\"0\"><div class=\"box-label\"><span class=\"box-code\">CSE 116LLB</span><span class=\"box-title\">Introduction to Computer Science II</span></div><span class=\"box-credits\">4 cr</span></div></div><div class=\"slot\"><div class=\"box box-course\" id=\"ai-and-geospatial-analytics-bs__box-1-1-0\" data-detail=\"{&quot;kind&quot;: &quot;course&quot;, &quot;title&quot;: &quot;College Calculus I&quot;, &quot;description&quot;: &quot;Beginning of a three-semester sequence in calculus for students of mathematics, natural sciences, and engineering. Covers differentiation and integration with applications. This course is the same as MTH 136 + 137 and course repeat rules will apply. Students should consult with their major department regarding any restrictions on their degree requirements.&quot;, &quot;credits&quot;: &quot;4&quot;, &quot;grading&quot;: &quot;Graded (GRD)&quot;, &quot;typically_offered&quot;: &quot;Fall, Spring, Summer, Winter&quot;, &quot;requisites&quot;: &quot;Pre-Requisite: Score of 70/100 or better on all three components of the Math Readiness Assessment (exam results are valid for one year), or a C or better in ULC 148, MTH 108 MTH 114 MTH 115, MTH 121, MTH 131, or D or better in MTH 141, or a score of 3 on AP Calculus OR or a score of 4 or 5 on AP Pre-Calculus OR a C or concurrent registration in MTH 109 with either C or better in MTH 113 or MRA scores of 70 or better in Math Fundamentals and Algebra and between 50-69 in Trigonometry.&quot;, &quot;flexible&quot;: false, &quot;also_ubc&quot;: true}\" role=\"button\" tabindex=\"0\"><div class=\"box-eyebrow\"><span class=\"box-eyebrow-tag box-ubc-tag\">UB Curriculum</span></div><div class=\"box-label\"><span class=\"box-code\">MTH 141LR</span><span class=\"box-title\">College Calculus I</span></div><span class=\"box-credits\">4 cr</span></div></div><div class=\"slot\"><div class=\"or-group\"><div class=\"box box-course\" id=\"ai-and-geospatial-analytics-bs__box-1-2-0\" data-detail=\"{&quot;kind&quot;: &quot;course&quot;, &quot;title&quot;: &quot;Writing and Rhetoric&quot;, &quot;description&quot;: &quot;An introduction to research, writing, and rhetorical practices employed in academic and professional contexts. The course examines the operation of genres, the audiences they address, and the purposes they serve. The course focuses on the analysis and development of student writing and rhetorical practice. Assignments include research essays, digital compositions, and oral presentations.&quot;, &quot;credits&quot;: &quot;4&quot;, &quot;grading&quot;: &quot;Graded (GRD)&quot;, &quot;typically_offered&quot;: &quot;Fall, Spring, Summer&quot;, &quot;requisites&quot;: &quot;ENG 105 non-Z Requisite&quot;, &quot;flexible&quot;: false, &quot;also_ubc&quot;: true}\" role=\"button\" tabindex=\"0\"><div class=\"box-eyebrow\"><span class=\"box-eyebrow-tag box-ubc-tag\">UB Curriculum</span></div><div class=\"box-label\"><span class=\"box-code\">ENG 105LEC</span><span class=\"box-title\">Writing and Rhetoric</span></div><span class=\"box-credits\">4 cr</span><div class=\"box-note\">(may also be completed in a different semester shown)</div></div><div class=\"or-sep\">or</div><div class=\"box box-generic\" id=\"ai-and-geospatial-analytics-bs__box-1-2-1\" data-detail=\"{&quot;kind&quot;: &quot;generic&quot;, &quot;category&quot;: &quot;ubc&quot;, &quot;description&quot;: &quot;Pathway: a UB Curriculum Thematic or Global Pathway course - part of at least four UB Areas/SUNY General Education categories a student&#x27;s Pathways coursework must satisfy across two Pathways (one Thematic, one Global).&quot;, &quot;catalog_url&quot;: &quot;https://www.buffalo.edu/ubcurriculum/pathways.html&quot;}\" role=\"button\" tabindex=\"0\"><div class=\"box-eyebrow\"><span class=\"box-eyebrow-tag box-ubc-tag\">UB Curriculum</span></div><div class=\"box-label\">Pathway</div><span class=\"box-credits\">3 cr</span></div></div></div><div class=\"slot\"><div class=\"box box-generic\" id=\"ai-and-geospatial-analytics-bs__box-1-3-0\" data-detail=\"{&quot;kind&quot;: &quot;generic&quot;, &quot;category&quot;: &quot;ubc&quot;, &quot;description&quot;: &quot;Pathway: a UB Curriculum Thematic or Global Pathway course - part of at least four UB Areas/SUNY General Education categories a student&#x27;s Pathways coursework must satisfy across two Pathways (one Thematic, one Global).&quot;, &quot;catalog_url&quot;: &quot;https://www.buffalo.edu/ubcurriculum/pathways.html&quot;}\" role=\"button\" tabindex=\"0\"><div class=\"box-eyebrow\"><span class=\"box-eyebrow-tag box-ubc-tag\">UB Curriculum</span></div><div class=\"box-label\">Pathway</div><span class=\"box-credits\">3 cr</span></div></div></div>\n        <div class=\"col-total\">14 or 15 credits</div>\n      </div>\n      <div class=\"semester-col term-fall\">\n        <div class=\"col-header\"><span class=\"col-year\">Year 2</span><span class=\"col-term\">Fall</span></div>\n        <div class=\"col-slots\"><div class=\"slot\"><div class=\"box box-course\" id=\"ai-and-geospatial-analytics-bs__box-2-0-0\" data-detail=\"{&quot;kind&quot;: &quot;course&quot;, &quot;title&quot;: &quot;AI &amp; Society&quot;, &quot;description&quot;: &quot;This course is an introduction to the study of Artificial Intelligence (AI) and Society. Through the examination of case studies covering all sectors of society, it provides a balanced consideration of the advantages and disadvantages of using AI to advance the public good.&quot;, &quot;credits&quot;: &quot;3&quot;, &quot;grading&quot;: &quot;Graded&quot;, &quot;typically_offered&quot;: &quot;Fall, Spring&quot;, &quot;requisites&quot;: null, &quot;flexible&quot;: false, &quot;also_ubc&quot;: false}\" role=\"button\" tabindex=\"0\"><div class=\"box-label\"><span class=\"box-code\">AI 101LEC</span><span class=\"box-title\">AI &amp; Society</span></div><span class=\"box-credits\">3 cr</span></div></div><div class=\"slot\"><div class=\"box box-course\" id=\"ai-and-geospatial-analytics-bs__box-2-1-0\" data-detail=\"{&quot;kind&quot;: &quot;course&quot;, &quot;title&quot;: &quot;Earth Systems Science&quot;, &quot;description&quot;: &quot;Earth Systems Science examines modern environmental problems through quantitative methods, analysis, and modeling grounded in basic and applied science and research. The goal of the course is to introduce students to the fundamental processes that dominate the atmosphere, hydrosphere, lithosphere, and biosphere, their characteristics and complex interactions, and their impact on human life and society.&quot;, &quot;credits&quot;: &quot;3&quot;, &quot;grading&quot;: &quot;Graded (GRD)&quot;, &quot;typically_offered&quot;: &quot;Fall, Spring, Summer&quot;, &quot;requisites&quot;: null, &quot;flexible&quot;: false, &quot;also_ubc&quot;: true}\" role=\"button\" tabindex=\"0\"><div class=\"box-eyebrow\"><span class=\"box-eyebrow-tag box-ubc-tag\">UB Curriculum</span></div><div class=\"box-label\"><span class=\"box-code\">GEO 101LEC</span><span class=\"box-title\">Earth Systems Science</span></div><span class=\"box-credits\">3 cr</span></div></div><div class=\"slot\"><div class=\"box box-course\" id=\"ai-and-geospatial-analytics-bs__box-2-2-0\" data-detail=\"{&quot;kind&quot;: &quot;course&quot;, &quot;title&quot;: &quot;Global Economic Geographies&quot;, &quot;description&quot;: &quot;Examines the diverse economic systems that characterize a world economy in rapid transition. Highlights the complex processes of globalization and its impact on regions, cities, and countries. Examines the organization of economic activities and resources in the global economy.&quot;, &quot;credits&quot;: &quot;3&quot;, &quot;grading&quot;: &quot;Graded (GRD)&quot;, &quot;typically_offered&quot;: &quot;Fall, Spring&quot;, &quot;requisites&quot;: null, &quot;flexible&quot;: false, &quot;also_ubc&quot;: false}\" role=\"button\" tabindex=\"0\"><div class=\"box-label\"><span class=\"box-code\">GEO 103LEC</span><span class=\"box-title\">Global Economic Geographies</span></div><span class=\"box-credits\">3 cr</span></div></div><div class=\"slot\"><div class=\"box box-course\" id=\"ai-and-geospatial-analytics-bs__box-2-3-0\" data-detail=\"{&quot;kind&quot;: &quot;course&quot;, &quot;title&quot;: &quot;Univariate Statistics in Geography&quot;, &quot;description&quot;: &quot;Introduces probability as a measure of uncertainty. Addresses the use of such measures of uncertainty for describing data, and for making inferences about large populations from small samples. These descriptive and inferential aspects of statistics are illustrated using geographic examples from a wide variety of different fields.&quot;, &quot;credits&quot;: &quot;4&quot;, &quot;grading&quot;: &quot;Graded (GRD)&quot;, &quot;typically_offered&quot;: &quot;Fall, Spring&quot;, &quot;requisites&quot;: null, &quot;flexible&quot;: false, &quot;also_ubc&quot;: true}\" role=\"button\" tabindex=\"0\"><div class=\"box-eyebrow\"><span class=\"box-eyebrow-tag box-ubc-tag\">UB Curriculum</span></div><div class=\"box-label\"><span class=\"box-code\">GEO 211LLB</span><span class=\"box-title\">Univariate Statistics in Geography</span></div><span class=\"box-credits\">4 cr</span></div></div><div class=\"slot\"><div class=\"box box-course\" id=\"ai-and-geospatial-analytics-bs__box-2-4-0\" data-detail=\"{&quot;kind&quot;: &quot;course&quot;, &quot;title&quot;: &quot;College Calculus 2&quot;, &quot;description&quot;: &quot;Differentiation and integration of transcendental functions; infinite sequences; series and power series; integration methods; additional topics in analytic geometry. This course is the same as MTH 138 and MTH 139 and course repeat rules will apply. Students should consult with their major department regarding any restrictions on their degree requirements.&quot;, &quot;credits&quot;: &quot;4&quot;, &quot;grading&quot;: &quot;Graded (GRD)&quot;, &quot;typically_offered&quot;: &quot;Fall, Spring, Summer, Winter&quot;, &quot;requisites&quot;: &quot;Pre-Requisite: MTH 141 or MTH 136 with MTH 137 as a co-requisite.&quot;, &quot;flexible&quot;: false, &quot;also_ubc&quot;: false}\" role=\"button\" tabindex=\"0\"><div class=\"box-label\"><span class=\"box-code\">MTH 142LR</span><span class=\"box-title\">College Calculus 2</span></div><span class=\"box-credits\">4 cr</span></div></div></div>\n        <div class=\"col-total\">17 credits</div>\n      </div>\n      <div class=\"semester-col term-spring\">\n        <div class=\"col-header\"><span class=\"col-year\">Year 2</span><span class=\"col-term\">Spring</span></div>\n        <div class=\"col-slots\"><div class=\"slot\"><div class=\"box box-course\" id=\"ai-and-geospatial-analytics-bs__box-3-0-0\" data-detail=\"{&quot;kind&quot;: &quot;course&quot;, &quot;title&quot;: &quot;AI &amp; Ethics&quot;, &quot;description&quot;: &quot;This course introduces students to the ethics of artificial intelligence (AI). The course begins with an overview of the potential risks and benefits of AI. It then examines how artificial intelligence actually works. Once we\\u2019ve covered the basic ideas of AI-such as neural networks and machine learning-the course will survey major ethical theories and examine the so-called \\u201calignment problem.\\u201d Major topics in AI ethics will then be discussed, such as algorithmic bias, AI warfare, and democratic integrity. This course is the same as PHI 106 and course repeat rules will apply. Students should consult with their major department regarding any restrictions on their degree requirements.&quot;, &quot;credits&quot;: &quot;3&quot;, &quot;grading&quot;: &quot;Graded&quot;, &quot;typically_offered&quot;: &quot;Fall, Spring&quot;, &quot;requisites&quot;: null, &quot;flexible&quot;: false, &quot;also_ubc&quot;: false}\" role=\"button\" tabindex=\"0\"><div class=\"box-label\"><span class=\"box-code\">AI 111LEC</span><span class=\"box-title\">AI &amp; Ethics</span></div><span class=\"box-credits\">3 cr</span></div></div><div class=\"slot\"><div class=\"box box-course\" id=\"ai-and-geospatial-analytics-bs__box-3-1-0\" data-detail=\"{&quot;kind&quot;: &quot;course&quot;, &quot;title&quot;: &quot;Geographical Perspectives on AI&quot;, &quot;description&quot;: &quot;This course explores the intersection of geographical thought, spatial data science, and artificial intelligence (AI). Geographers not only use AI techniques (GeoAI), they also study how AI influences spatial patterns, human-environment interactions, and conceptualizations of space and place. This course aims to provide students with a deep theoretical understanding of how AI can be integrated with spatial science, and the potential benefits and challenges associated with the transformative nature of GeoAI technologies. Students will critically assess the benefits and challenges of GeoAI for societies within different geographical contexts. By the end of the course, students will gain a comprehensive understanding of how AI influences spatial patterns and processes, and how geographic perspectives can inform the development and deployment of AI technologies.&quot;, &quot;credits&quot;: &quot;3&quot;, &quot;grading&quot;: &quot;Graded (GRD)&quot;, &quot;typically_offered&quot;: &quot;Fall&quot;, &quot;requisites&quot;: null, &quot;flexible&quot;: false, &quot;also_ubc&quot;: false}\" role=\"button\" tabindex=\"0\"><div class=\"box-label\"><span class=\"box-code\">GEO 338LEC</span><span class=\"box-title\">Geographical Perspectives on AI</span></div><span class=\"box-credits\">3 cr</span></div></div><div class=\"slot\"><div class=\"box box-generic\" id=\"ai-and-geospatial-analytics-bs__box-3-2-0\" data-detail=\"{&quot;kind&quot;: &quot;generic&quot;, &quot;category&quot;: &quot;ubc&quot;, &quot;description&quot;: &quot;Pathway: a UB Curriculum Thematic or Global Pathway course - part of at least four UB Areas/SUNY General Education categories a student&#x27;s Pathways coursework must satisfy across two Pathways (one Thematic, one Global).&quot;, &quot;catalog_url&quot;: &quot;https://www.buffalo.edu/ubcurriculum/pathways.html&quot;}\" role=\"button\" tabindex=\"0\"><div class=\"box-eyebrow\"><span class=\"box-eyebrow-tag box-ubc-tag\">UB Curriculum</span></div><div class=\"box-label\">Pathway</div><span class=\"box-credits\">3 cr</span></div></div><div class=\"slot\"><div class=\"box box-generic\" id=\"ai-and-geospatial-analytics-bs__box-3-3-0\" data-detail=\"{&quot;kind&quot;: &quot;generic&quot;, &quot;category&quot;: &quot;ubc&quot;, &quot;description&quot;: &quot;Pathway: a UB Curriculum Thematic or Global Pathway course - part of at least four UB Areas/SUNY General Education categories a student&#x27;s Pathways coursework must satisfy across two Pathways (one Thematic, one Global).&quot;, &quot;catalog_url&quot;: &quot;https://www.buffalo.edu/ubcurriculum/pathways.html&quot;}\" role=\"button\" tabindex=\"0\"><div class=\"box-eyebrow\"><span class=\"box-eyebrow-tag box-ubc-tag\">UB Curriculum</span></div><div class=\"box-label\">Pathway</div><span class=\"box-credits\">3 cr</span></div></div><div class=\"slot\"><div class=\"box box-generic\" id=\"ai-and-geospatial-analytics-bs__box-3-4-0\" data-detail=\"{&quot;kind&quot;: &quot;generic&quot;, &quot;category&quot;: &quot;ubc&quot;, &quot;description&quot;: &quot;Scientific Literacy and Inquiry: a 7-credit UB Curriculum Foundations requirement (two lecture courses plus a matching 1-credit lab from the same subject area).&quot;, &quot;catalog_url&quot;: &quot;https://www.buffalo.edu/ubcurriculum/foundations.html&quot;}\" role=\"button\" tabindex=\"0\"><div class=\"box-eyebrow\"><span class=\"box-eyebrow-tag box-ubc-tag\">UB Curriculum</span></div><div class=\"box-label\">Scientific Literacy and Inquiry 2</div><span class=\"box-credits\">3 cr</span></div></div><div class=\"slot\"><div class=\"box box-generic\" id=\"ai-and-geospatial-analytics-bs__box-3-5-0\" data-detail=\"{&quot;kind&quot;: &quot;generic&quot;, &quot;category&quot;: &quot;ubc&quot;, &quot;description&quot;: &quot;Scientific Literacy and Inquiry: a 7-credit UB Curriculum Foundations requirement (two lecture courses plus a matching 1-credit lab from the same subject area).&quot;, &quot;catalog_url&quot;: &quot;https://www.buffalo.edu/ubcurriculum/foundations.html&quot;}\" role=\"button\" tabindex=\"0\"><div class=\"box-eyebrow\"><span class=\"box-eyebrow-tag box-ubc-tag\">UB Curriculum</span></div><div class=\"box-label\">Scientific Literacy and Inquiry Lab</div><span class=\"box-credits\">1 cr</span></div></div></div>\n        <div class=\"col-total\">16 credits</div>\n      </div>\n      <div class=\"semester-col term-fall\">\n        <div class=\"col-header\"><span class=\"col-year\">Year 3</span><span class=\"col-term\">Fall</span></div>\n        <div class=\"col-slots\"><div class=\"slot\"><div class=\"box box-course\" id=\"ai-and-geospatial-analytics-bs__box-4-0-0\" data-detail=\"{&quot;kind&quot;: &quot;course&quot;, &quot;title&quot;: &quot;Technological Disruption and Diffusion&quot;, &quot;description&quot;: &quot;This course surveys the history of human technologies and the way that they result in disruptions to pre-existing social patterns, from the rise of farming to the invention of the printing press to the latest developments in Artificial Intelligence. The goal of this course is to help students understand and situate today\\u2019s disruptive technologies in their historical context&quot;, &quot;credits&quot;: &quot;3&quot;, &quot;grading&quot;: &quot;Graded&quot;, &quot;typically_offered&quot;: &quot;Fall, Spring&quot;, &quot;requisites&quot;: null, &quot;flexible&quot;: false, &quot;also_ubc&quot;: false}\" role=\"button\" tabindex=\"0\"><div class=\"box-label\"><span class=\"box-code\">AI 211LEC</span><span class=\"box-title\">Technological Disruption and Diffusion</span></div><span class=\"box-credits\">3 cr</span></div></div><div class=\"slot\"><div class=\"box box-course\" id=\"ai-and-geospatial-analytics-bs__box-4-1-0\" data-detail=\"{&quot;kind&quot;: &quot;course&quot;, &quot;title&quot;: &quot;Applied Linear Algebra and Probability for AI&quot;, &quot;description&quot;: &quot;Introductory mathematics course assuming minimal mathematical background (non-calculus based) that introduces the foundations of math necessary to understand machine learning and AI technologies. This course is designed for students who do not plan to major in math or engineering. Key topics will include basic linear algebra and probability grounded in real-world examples of the use and interpretation of these techniques in AI applications.&quot;, &quot;credits&quot;: &quot;4&quot;, &quot;grading&quot;: &quot;Graded (GRD)&quot;, &quot;typically_offered&quot;: &quot;Fall, Spring&quot;, &quot;requisites&quot;: &quot;Pre-Requisites: MTH 114 , or equivalent. A student can take AI 220 if already placed into Calculus or received Calculus AP credit.&quot;, &quot;flexible&quot;: false, &quot;also_ubc&quot;: false}\" role=\"button\" tabindex=\"0\"><div class=\"box-label\"><span class=\"box-code\">AI 220LR</span><span class=\"box-title\">Applied Linear Algebra and Probability for AI</span></div><span class=\"box-credits\">4 cr</span></div></div><div class=\"slot\"><div class=\"box box-course\" id=\"ai-and-geospatial-analytics-bs__box-4-2-0\" data-detail=\"{&quot;kind&quot;: &quot;course&quot;, &quot;title&quot;: &quot;Geographic Information Systems&quot;, &quot;description&quot;: &quot;Provides a general introduction to the principles and applications of geographic information systems (GIS). The lectures cover several fundamental aspects of GIS: (1) the basics of a GIS system, (2) GIS data and sources of data, (3) GIS analysis functions, and (4) GIS applications and related issues. The laboratory exercises are based on the leading GIS software, ArcGIS, and are designed to help students understand the lecture materials and gain hands-on experiences in GIS data acquisition, spatial database management, spatial analysis, and mapping. This course is dual-listed with GEO 506.&quot;, &quot;credits&quot;: &quot;4&quot;, &quot;grading&quot;: &quot;Graded (GRD)&quot;, &quot;typically_offered&quot;: &quot;Fall, Spring&quot;, &quot;requisites&quot;: null, &quot;flexible&quot;: false, &quot;also_ubc&quot;: false}\" role=\"button\" tabindex=\"0\"><div class=\"box-label\"><span class=\"box-code\">GEO 481LLB</span><span class=\"box-title\">Geographic Information Systems</span></div><span class=\"box-credits\">4 cr</span></div></div><div class=\"slot\"><div class=\"box box-generic\" id=\"ai-and-geospatial-analytics-bs__box-4-3-0\" data-detail=\"{&quot;kind&quot;: &quot;generic&quot;, &quot;category&quot;: &quot;ubc&quot;, &quot;description&quot;: &quot;Communication Literacy 2: a UB Curriculum Foundations requirement, completed from an approved list of discipline-specific writing courses (see the Undergraduate Catalog&#x27;s Communication Literacy II list).&quot;, &quot;catalog_url&quot;: &quot;https://www.buffalo.edu/ubcurriculum/foundations.html&quot;}\" role=\"button\" tabindex=\"0\"><div class=\"box-eyebrow\"><span class=\"box-eyebrow-tag box-ubc-tag\">UB Curriculum</span></div><div class=\"box-label\">Communication Literacy 2</div><span class=\"box-credits\">3 cr</span></div></div></div>\n        <div class=\"col-total\">14 credits</div>\n      </div>\n      <div class=\"semester-col term-spring\">\n        <div class=\"col-header\"><span class=\"col-year\">Year 3</span><span class=\"col-term\">Spring</span></div>\n        <div class=\"col-slots\"><div class=\"slot\"><div class=\"box box-course\" id=\"ai-and-geospatial-analytics-bs__box-5-0-0\" data-detail=\"{&quot;kind&quot;: &quot;course&quot;, &quot;title&quot;: &quot;Applied Machine Learning&quot;, &quot;description&quot;: &quot;This course provides a hands-on introduction to Machine Learning (ML), covering fundamental concepts, approaches, and applications. Students will explore some foundational ideas but focus largely on practical implementations of ML techniques in real-world settings, including text and video analysis. The course will be taught in Python and make use of real-world datasets. Topics include model building, model evaluation, supervised classification, large language modeling, unsupervised methods, ethical considerations in ML, and the intersection of machine learning and society. Throughout the course, students will engage in programming assignments that reinforce course concepts, as well as taking exams.&quot;, &quot;credits&quot;: &quot;4&quot;, &quot;grading&quot;: &quot;Graded&quot;, &quot;typically_offered&quot;: &quot;Spring&quot;, &quot;requisites&quot;: &quot;CSE 116 OR AI 220&quot;, &quot;flexible&quot;: false, &quot;also_ubc&quot;: false}\" role=\"button\" tabindex=\"0\"><div class=\"box-label\"><span class=\"box-code\">AI 300LR</span><span class=\"box-title\">Applied Machine Learning</span></div><span class=\"box-credits\">4 cr</span></div></div><div class=\"slot\"><div class=\"box box-course box-flexible\" id=\"ai-and-geospatial-analytics-bs__box-5-1-0\" data-detail=\"{&quot;kind&quot;: &quot;generic&quot;, &quot;category&quot;: &quot;major_elective&quot;, &quot;description&quot;: &quot;\\&quot;AI &amp; Society Elective\\&quot; is an elective slot specific to this major&#x27;s own requirements, not a UB Curriculum-wide component - the exact eligible courses depend on this program&#x27;s requirements as listed in the Undergraduate Catalog.&quot;, &quot;catalog_url&quot;: &quot;https://catalogs.buffalo.edu/preview_program.php?catoid=21&amp;poid=8482&amp;returnto=1177&quot;}\" role=\"button\" tabindex=\"0\"><div class=\"box-eyebrow\"><span class=\"box-eyebrow-tag\">Elective in the major</span></div><div class=\"box-label\">AI &amp; Society Elective</div><span class=\"box-credits\">3 cr</span></div></div><div class=\"slot\"><div class=\"box box-course\" id=\"ai-and-geospatial-analytics-bs__box-5-2-0\" data-detail=\"{&quot;kind&quot;: &quot;course&quot;, &quot;title&quot;: &quot;Multivariate Statistics in Geography&quot;, &quot;description&quot;: &quot;Provides an introduction to techniques of multivariate analysis. Topics include ANOVA, simple regression, multiple regression, logistic regression, principal components analysis, and cluster analysis.&quot;, &quot;credits&quot;: &quot;3&quot;, &quot;grading&quot;: &quot;Graded (GRD)&quot;, &quot;typically_offered&quot;: &quot;Spring&quot;, &quot;requisites&quot;: &quot;Pre-Requisite: GEO 211 .&quot;, &quot;flexible&quot;: false, &quot;also_ubc&quot;: false}\" role=\"button\" tabindex=\"0\"><div class=\"box-label\"><span class=\"box-code\">GEO 411LEC</span><span class=\"box-title\">Multivariate Statistics in Geography</span></div><span class=\"box-credits\">3 cr</span></div></div><div class=\"slot\"><div class=\"box box-course box-flexible\" id=\"ai-and-geospatial-analytics-bs__box-5-3-0\" data-detail=\"{&quot;kind&quot;: &quot;generic&quot;, &quot;category&quot;: &quot;major_elective&quot;, &quot;description&quot;: &quot;\\&quot;Geography Elective\\&quot; is an elective slot specific to this major&#x27;s own requirements, not a UB Curriculum-wide component - the exact eligible courses depend on this program&#x27;s requirements as listed in the Undergraduate Catalog.&quot;, &quot;catalog_url&quot;: &quot;https://catalogs.buffalo.edu/preview_program.php?catoid=21&amp;poid=8482&amp;returnto=1177&quot;}\" role=\"button\" tabindex=\"0\"><div class=\"box-eyebrow\"><span class=\"box-eyebrow-tag\">Elective in the major</span></div><div class=\"box-label\">Geography Elective</div><span class=\"box-credits\">3 cr</span></div></div><div class=\"slot\"><div class=\"box box-generic\" id=\"ai-and-geospatial-analytics-bs__box-5-4-0\" data-detail=\"{&quot;kind&quot;: &quot;generic&quot;, &quot;category&quot;: &quot;ubc&quot;, &quot;description&quot;: &quot;Pathway: a UB Curriculum Thematic or Global Pathway course - part of at least four UB Areas/SUNY General Education categories a student&#x27;s Pathways coursework must satisfy across two Pathways (one Thematic, one Global).&quot;, &quot;catalog_url&quot;: &quot;https://www.buffalo.edu/ubcurriculum/pathways.html&quot;}\" role=\"button\" tabindex=\"0\"><div class=\"box-eyebrow\"><span class=\"box-eyebrow-tag box-ubc-tag\">UB Curriculum</span></div><div class=\"box-label\">Pathway</div><span class=\"box-credits\">3 cr</span></div></div></div>\n        <div class=\"col-total\">16 credits</div>\n      </div>\n      <div class=\"semester-col term-fall\">\n        <div class=\"col-header\"><span class=\"col-year\">Year 4</span><span class=\"col-term\">Fall</span></div>\n        <div class=\"col-slots\"><div class=\"slot\"><div class=\"box box-course box-flexible\" id=\"ai-and-geospatial-analytics-bs__box-6-0-0\" data-detail=\"{&quot;kind&quot;: &quot;generic&quot;, &quot;category&quot;: &quot;major_elective&quot;, &quot;description&quot;: &quot;\\&quot;AI &amp; Society Elective\\&quot; is an elective slot specific to this major&#x27;s own requirements, not a UB Curriculum-wide component - the exact eligible courses depend on this program&#x27;s requirements as listed in the Undergraduate Catalog.&quot;, &quot;catalog_url&quot;: &quot;https://catalogs.buffalo.edu/preview_program.php?catoid=21&amp;poid=8482&amp;returnto=1177&quot;}\" role=\"button\" tabindex=\"0\"><div class=\"box-eyebrow\"><span class=\"box-eyebrow-tag\">Elective in the major</span></div><div class=\"box-label\">AI &amp; Society Elective</div><span class=\"box-credits\">3 cr</span></div></div><div class=\"slot\"><div class=\"box box-course box-flexible\" id=\"ai-and-geospatial-analytics-bs__box-6-1-0\" data-detail=\"{&quot;kind&quot;: &quot;generic&quot;, &quot;category&quot;: &quot;major_elective&quot;, &quot;description&quot;: &quot;\\&quot;Geography Elective\\&quot; is an elective slot specific to this major&#x27;s own requirements, not a UB Curriculum-wide component - the exact eligible courses depend on this program&#x27;s requirements as listed in the Undergraduate Catalog.&quot;, &quot;catalog_url&quot;: &quot;https://catalogs.buffalo.edu/preview_program.php?catoid=21&amp;poid=8482&amp;returnto=1177&quot;}\" role=\"button\" tabindex=\"0\"><div class=\"box-eyebrow\"><span class=\"box-eyebrow-tag\">Elective in the major</span></div><div class=\"box-label\">Geography Elective</div><span class=\"box-credits\">4 cr</span></div></div><div class=\"slot\"><div class=\"box box-course\" id=\"ai-and-geospatial-analytics-bs__box-6-2-0\" data-detail=\"{&quot;kind&quot;: &quot;course&quot;, &quot;title&quot;: &quot;GIS and Machine Learning&quot;, &quot;description&quot;: &quot;In this course, we will explore the integration of GIS and machine learning for addressing geographical problems. We will start from the fundamental techniques related to preparing GIS data for machine learning models, and then move to discussing machine learning concepts and how to use machine learning in the context of geography. This course has an emphasis on both theoretical concepts and hands-on skills, and we will use a high-level programming language (e.g., Python) to implement machine learning models. This course is dual listed with GEO 514.&quot;, &quot;credits&quot;: &quot;3&quot;, &quot;grading&quot;: &quot;Graded (GRD)&quot;, &quot;typically_offered&quot;: null, &quot;requisites&quot;: &quot;Pre-Requisite: (GEO 281 or GEO 481 or similar GIS courses by permission of the instructor) and (CSE 115 or GEO 482 or similar programming courses by permission of the instructor).&quot;, &quot;flexible&quot;: false, &quot;also_ubc&quot;: false}\" role=\"button\" tabindex=\"0\"><div class=\"box-label\"><span class=\"box-code\">GEO 414LEC</span><span class=\"box-title\">GIS and Machine Learning</span></div><span class=\"box-credits\">3 cr</span></div></div><div class=\"slot\"><div class=\"box box-course box-flexible\" id=\"ai-and-geospatial-analytics-bs__box-6-3-0\" data-detail=\"{&quot;kind&quot;: &quot;generic&quot;, &quot;category&quot;: &quot;major_elective&quot;, &quot;description&quot;: &quot;\\&quot;Elective\\&quot; is an elective slot specific to this major&#x27;s own requirements, not a UB Curriculum-wide component - the exact eligible courses depend on this program&#x27;s requirements as listed in the Undergraduate Catalog.&quot;, &quot;catalog_url&quot;: &quot;https://catalogs.buffalo.edu/preview_program.php?catoid=21&amp;poid=8482&amp;returnto=1177&quot;}\" role=\"button\" tabindex=\"0\"><div class=\"box-eyebrow\"><span class=\"box-eyebrow-tag\">Elective in the major</span></div><div class=\"box-label\">Elective</div><span class=\"box-credits\">3 cr</span></div></div><div class=\"slot\"><div class=\"box box-course box-flexible\" id=\"ai-and-geospatial-analytics-bs__box-6-4-0\" data-detail=\"{&quot;kind&quot;: &quot;generic&quot;, &quot;category&quot;: &quot;major_elective&quot;, &quot;description&quot;: &quot;\\&quot;Elective\\&quot; is an elective slot specific to this major&#x27;s own requirements, not a UB Curriculum-wide component - the exact eligible courses depend on this program&#x27;s requirements as listed in the Undergraduate Catalog.&quot;, &quot;catalog_url&quot;: &quot;https://catalogs.buffalo.edu/preview_program.php?catoid=21&amp;poid=8482&amp;returnto=1177&quot;}\" role=\"button\" tabindex=\"0\"><div class=\"box-eyebrow\"><span class=\"box-eyebrow-tag\">Elective in the major</span></div><div class=\"box-label\">Elective</div><span class=\"box-credits\">1 cr</span></div></div></div>\n        <div class=\"col-total\">14 credits</div>\n      </div>\n      <div class=\"semester-col term-spring\">\n        <div class=\"col-header\"><span class=\"col-year\">Year 4</span><span class=\"col-term\">Spring</span></div>\n        <div class=\"col-slots\"><div class=\"slot\"><div class=\"box box-course\" id=\"ai-and-geospatial-analytics-bs__box-7-0-0\" data-detail=\"{&quot;kind&quot;: &quot;course&quot;, &quot;title&quot;: &quot;AI and Society Capstone&quot;, &quot;description&quot;: &quot;This course is designed to help students lead, document, and demonstrate a nontrivial project at the intersection of artificial intelligence (AI) and society. Students will apply robust research and development methodologies, including ethical AI frameworks, project management techniques, and hybrid agile development approaches, to explore and build AI-driven solutions with real-world impact. There will also be a presentation component at the end of the course where students demonstrate their projects and summarize their learnings in a formal presentation to a wider audience.&quot;, &quot;credits&quot;: &quot;3&quot;, &quot;grading&quot;: &quot;Graded&quot;, &quot;typically_offered&quot;: &quot;Fall&quot;, &quot;requisites&quot;: &quot;Prerequisite: AI 101, AI 111, AI 211, and one of AI 321, 323, or 325 and AI 300 or AI 320&quot;, &quot;flexible&quot;: false, &quot;also_ubc&quot;: false}\" role=\"button\" tabindex=\"0\"><div class=\"box-label\"><span class=\"box-code\">AI 494LR</span><span class=\"box-title\">AI and Society Capstone</span></div><span class=\"box-credits\">3 cr</span></div></div><div class=\"slot\"><div class=\"box box-course\" id=\"ai-and-geospatial-analytics-bs__box-7-1-0\" data-detail=\"{&quot;kind&quot;: &quot;course&quot;, &quot;title&quot;: &quot;GIS and Environmental Modeling&quot;, &quot;description&quot;: &quot;Emphasizes GIS applications for environmental modeling, which is loosely defined as any study that contains an environmental element. This is an intermediate level GIS course. GIS methodology design is the primary focus of the lectures and the following topics are discussed: basic GIS methods, using statistics to test and validate GIS methods, and integrating GIS with environmental models. Case studies are used to support the discussion of method design and help students select appropriate GIS methods for a project. The hands-on laboratory exercises focus on learning advanced GIS methods in order to help students implement a GIS project of their interest.&quot;, &quot;credits&quot;: &quot;4&quot;, &quot;grading&quot;: &quot;Graded (GRD)&quot;, &quot;typically_offered&quot;: &quot;Spring&quot;, &quot;requisites&quot;: &quot;Pre-Requisite: GEO 481 .&quot;, &quot;flexible&quot;: false, &quot;also_ubc&quot;: false}\" role=\"button\" tabindex=\"0\"><div class=\"box-label\"><span class=\"box-code\">GEO 479LLB</span><span class=\"box-title\">GIS and Environmental Modeling</span></div><span class=\"box-credits\">4 cr</span></div></div><div class=\"slot\"><div class=\"box box-course box-flexible\" id=\"ai-and-geospatial-analytics-bs__box-7-2-0\" data-detail=\"{&quot;kind&quot;: &quot;generic&quot;, &quot;category&quot;: &quot;major_elective&quot;, &quot;description&quot;: &quot;\\&quot;Geography Elective\\&quot; is an elective slot specific to this major&#x27;s own requirements, not a UB Curriculum-wide component - the exact eligible courses depend on this program&#x27;s requirements as listed in the Undergraduate Catalog.&quot;, &quot;catalog_url&quot;: &quot;https://catalogs.buffalo.edu/preview_program.php?catoid=21&amp;poid=8482&amp;returnto=1177&quot;}\" role=\"button\" tabindex=\"0\"><div class=\"box-eyebrow\"><span class=\"box-eyebrow-tag\">Elective in the major</span></div><div class=\"box-label\">Geography Elective</div><span class=\"box-credits\">3 cr</span></div></div><div class=\"slot\"><div class=\"box box-generic\" id=\"ai-and-geospatial-analytics-bs__box-7-3-0\" data-detail=\"{&quot;kind&quot;: &quot;generic&quot;, &quot;category&quot;: &quot;ubc&quot;, &quot;description&quot;: &quot;Pathway: a UB Curriculum Thematic or Global Pathway course - part of at least four UB Areas/SUNY General Education categories a student&#x27;s Pathways coursework must satisfy across two Pathways (one Thematic, one Global).&quot;, &quot;catalog_url&quot;: &quot;https://www.buffalo.edu/ubcurriculum/pathways.html&quot;}\" role=\"button\" tabindex=\"0\"><div class=\"box-eyebrow\"><span class=\"box-eyebrow-tag box-ubc-tag\">UB Curriculum</span></div><div class=\"box-label\">Pathway</div><span class=\"box-credits\">3 cr</span></div></div><div class=\"slot\"><div class=\"box box-course\" id=\"ai-and-geospatial-analytics-bs__box-7-4-0\" data-detail=\"{&quot;kind&quot;: &quot;course&quot;, &quot;title&quot;: &quot;UB Curriculum Capstone&quot;, &quot;description&quot;: &quot;UB Curriculum Capstone (UBC 399) is the culminating general education requirement. It is a one-credit course in which you will work in UBPortfolio, with the support of your Capstone instructor, to create a reflective and integrative Capstone ePortfolio based on your UB Curriculum coursework and lived experiences outside of the classroom. All UB Curriculum courses must be completed or in-progress to enroll in and complete UBC 399. Students who drop an in-progress course will be removed from UBC 399 through the add/drop period. Students who resign an in-progress course may not be able to successfully complete the Capstone.&quot;, &quot;credits&quot;: &quot;1&quot;, &quot;grading&quot;: &quot;Graded (GRD)&quot;, &quot;typically_offered&quot;: &quot;Fall, Spring&quot;, &quot;requisites&quot;: &quot;All UB Curriculum courses must be completed or in-progress to enroll in and complete UBC 399. UB Seminar is a prerequisite to UBC 399 and therefore cannot be taken concurrently. If you enrolled today in your remaining UBC course(s), HUB will allow you to enroll tomorrow. For questions, email: ubcurriculum@buffalo.edu.&quot;, &quot;flexible&quot;: false, &quot;also_ubc&quot;: true}\" role=\"button\" tabindex=\"0\"><div class=\"box-eyebrow\"><span class=\"box-eyebrow-tag box-ubc-tag\">UB Curriculum</span></div><div class=\"box-label\"><span class=\"box-code\">UBC 399MNT</span><span class=\"box-title\">UB Curriculum Capstone</span></div><span class=\"box-credits\">1 cr</span></div></div></div>\n        <div class=\"col-total\">120 credits</div>\n      </div></div></div></section>"}