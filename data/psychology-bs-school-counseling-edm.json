t;]}}\"><div class=\"scroll-hint\">Scroll right for more semesters \u2192</div><div class=\"flow-scroll\"><div class=\"flow-container\">\n      <div class=\"semester-col term-fall\">\n        <div class=\"col-header\"><span class=\"col-year\">Year 1</span><span class=\"col-term\">Fall</span></div>\n        <div class=\"col-slots\"><div class=\"slot\"><div class=\"box box-generic\" id=\"psychology-bs-school-counseling-edm__box-0-0-0\" data-detail=\"{&quot;kind&quot;: &quot;generic&quot;, &quot;category&quot;: &quot;ubc&quot;, &quot;description&quot;: &quot;UB Seminar: a 1- or 3-credit seminar every student completes in their first semester of enrollment, taught by faculty across departments around a &#x27;big idea&#x27; in the discipline. A UB Curriculum core requirement, not specific to this major.&quot;, &quot;catalog_url&quot;: &quot;https://www.buffalo.edu/ubcurriculum/seminar.html&quot;}\" role=\"button\" tabindex=\"0\"><div class=\"box-eyebrow\"><span class=\"box-eyebrow-tag box-ubc-tag\">UB Curriculum</span></div><div class=\"box-label\">UB Seminar</div><span class=\"box-credits\">3 cr</span></div></div><div class=\"slot\"><div class=\"box box-course\" id=\"psychology-bs-school-counseling-edm__box-0-1-0\" data-detail=\"{&quot;kind&quot;: &quot;course&quot;, &quot;title&quot;: &quot;Introductory Psychology&quot;, &quot;description&quot;: &quot;General survey of perception; learning and memory; cognitive, developmental, personality, abnormal, and social psychology; and behavioral neuroscience. Requires participation in research or a short paper.&quot;, &quot;credits&quot;: &quot;3&quot;, &quot;grading&quot;: &quot;Graded (GRD)&quot;, &quot;typically_offered&quot;: &quot;Fall, Spring, Summer, Winter&quot;, &quot;requisites&quot;: null, &quot;flexible&quot;: false, &quot;also_ubc&quot;: false}\" role=\"button\" tabindex=\"0\"><div class=\"box-label\"><span class=\"box-code\">PSY 101LEC</span><span class=\"box-title\">Introductory Psychology</span></div><span class=\"box-credits\">3 cr</span></div></div><div class=\"slot\"><div class=\"box box-course box-flexible\" id=\"psychology-bs-school-counseling-edm__box-0-2-0\" data-detail=\"{&quot;kind&quot;: &quot;course&quot;, &quot;title&quot;: &quot;Survey of Calculus and Its Applications I&quot;, &quot;description&quot;: &quot;For students in social, biological, and management sciences. Limits, continuity, differentiation of algebraic and exponential functions; applications; introduces integration.&quot;, &quot;credits&quot;: &quot;4&quot;, &quot;grading&quot;: &quot;Graded (GRD)&quot;, &quot;typically_offered&quot;: &quot;Fall, Spring, Summer, Winter&quot;, &quot;requisites&quot;: &quot;Pre-Requisite: Score of 70/100 or better on both the Fundamentals and the Algebra portions of the Math Readiness Assessment, or a C or better in ULC 148 , MTH 108 , MTH 113 , MTH 114 , MTH 115 , a D or better in MTH 121 or MTH 131 or MTH 141 or a score of 3 on AP Calculus or a score of 4 or 5 on AP Pre-Calculus.&quot;, &quot;flexible&quot;: true, &quot;also_ubc&quot;: true, &quot;catalog_url&quot;: &quot;https://catalogs.buffalo.edu/preview_program.php?catoid=21&amp;poid=9604&amp;returnto=1177&quot;, &quot;groups&quot;: [{&quot;requirement_type&quot;: &quot;choice_required&quot;, &quot;group&quot;: &quot;Psychology BS Core: Calculus sequence (choose 1 of 2 sequences)&quot;, &quot;courses&quot;: [{&quot;code&quot;: &quot;MTH 121LR&quot;, &quot;title&quot;: &quot;Survey of Calculus and Its Applications I&quot;}, {&quot;code&quot;: &quot;MTH 122LR&quot;, &quot;title&quot;: &quot;Survey of Calculus and Its Applications II&quot;}, {&quot;code&quot;: &quot;MTH 141LR&quot;, &quot;title&quot;: &quot;College Calculus I&quot;}, {&quot;code&quot;: &quot;MTH 142LR&quot;, &quot;title&quot;: &quot;College Calculus 2&quot;}]}]}\" role=\"button\" tabindex=\"0\"><div class=\"box-eyebrow\"><span class=\"box-eyebrow-tag\">full list on click</span><span class=\"box-eyebrow-sep\"> &middot; </span><span class=\"box-eyebrow-tag box-ubc-tag\">UB Curriculum</span></div><div class=\"box-label\">Psychology BS Core: Calculus sequence (choose 1 of 2 sequences)</div><span class=\"box-credits\">4 cr</span></div></div><div class=\"slot\"><div class=\"box box-course\" id=\"psychology-bs-school-counseling-edm__box-0-3-0\" data-detail=\"{&quot;kind&quot;: &quot;course&quot;, &quot;title&quot;: &quot;Evolutionary Biology&quot;, &quot;description&quot;: &quot;This course is designed as a general introduction to organismal biology: what happens at the level of the organism and above. Students will learn how evolution works, what organisms evolution has created, and how those organisms interact with the environment and each other. These three topics comprise the three sections of the course material: evolution, diversity, and ecology. Students will gain a general facility with the major topics of each of these fields to prepare them for future courses in the biology department and related fields.&quot;, &quot;credits&quot;: &quot;5&quot;, &quot;grading&quot;: &quot;Graded (GRD)&quot;, &quot;typically_offered&quot;: &quot;Fall, Summer&quot;, &quot;requisites&quot;: null, &quot;flexible&quot;: false, &quot;also_ubc&quot;: true}\" role=\"button\" tabindex=\"0\"><div class=\"box-eyebrow\"><span class=\"box-eyebrow-tag box-ubc-tag\">UB Curriculum</span></div><div class=\"box-label\"><span class=\"box-code\">BIO 200LLB</span><span class=\"box-title\">Evolutionary Biology</span></div><span class=\"box-credits\">5 cr</span></div></div></div>\n        <div class=\"col-total\">15 credits</div>\n      </div>\n      <div class=\"semester-col term-spring\">\n        <div class=\"col-header\"><span class=\"col-year\">Year 1</span><span class=\"col-term\">Spring</span></div>\n        <div class=\"col-slots\"><div class=\"slot\"><div class=\"box box-course box-flexible\" id=\"psychology-bs-school-counseling-edm__box-1-0-0\" data-detail=\"{&quot;kind&quot;: &quot;generic&quot;, &quot;category&quot;: &quot;major_requirement&quot;, &quot;description&quot;: &quot;\\&quot;Substantive Area Course\\&quot; is a flexible requirement slot defined by this major&#x27;s own requirements, not a specific course - see the Undergraduate Catalog for the exact eligible options.&quot;, &quot;catalog_url&quot;: &quot;https://catalogs.buffalo.edu/preview_program.php?catoid=21&amp;poid=9604&amp;returnto=1177&quot;}\" role=\"button\" tabindex=\"0\"><div class=\"box-eyebrow\"><span class=\"box-eyebrow-tag\">Requirement in the major</span></div><div class=\"box-label\">Substantive Area Course</div><span class=\"box-credits\">3 cr</span></div></div><div class=\"slot\"><div class=\"box box-course box-flexible\" id=\"psychology-bs-school-counseling-edm__box-1-1-0\" data-detail=\"{&quot;kind&quot;: &quot;generic&quot;, &quot;category&quot;: &quot;major_elective&quot;, &quot;description&quot;: &quot;\\&quot;Elective\\&quot; is an elective slot specific to this major&#x27;s own requirements, not a UB Curriculum-wide component - the exact eligible courses depend on this program&#x27;s requirements as listed in the Undergraduate Catalog.&quot;, &quot;catalog_url&quot;: &quot;https://catalogs.buffalo.edu/preview_program.php?catoid=21&amp;poid=9604&amp;returnto=1177&quot;}\" role=\"button\" tabindex=\"0\"><div class=\"box-eyebrow\"><span class=\"box-eyebrow-tag\">Elective in the major</span></div><div class=\"box-label\">Elective</div><span class=\"box-credits\">1 cr</span></div></div><div class=\"slot\"><div class=\"box box-generic\" id=\"psychology-bs-school-counseling-edm__box-1-2-0\" data-detail=\"{&quot;kind&quot;: &quot;generic&quot;, &quot;category&quot;: &quot;ubc&quot;, &quot;description&quot;: &quot;Pathway: a UB Curriculum Thematic or Global Pathway course - part of at least four UB Areas/SUNY General Education categories a student&#x27;s Pathways coursework must satisfy across two Pathways (one Thematic, one Global).&quot;, &quot;catalog_url&quot;: &quot;https://www.buffalo.edu/ubcurriculum/pathways.html&quot;}\" role=\"button\" tabindex=\"0\"><div class=\"box-eyebrow\"><span class=\"box-eyebrow-tag box-ubc-tag\">UB Curriculum</span></div><div class=\"box-label\">Pathway</div><span class=\"box-credits\">3 cr</span></div></div><div class=\"slot\"><div class=\"box box-course box-flexible\" id=\"psychology-bs-school-counseling-edm__box-1-3-0\" data-detail=\"{&quot;kind&quot;: &quot;course&quot;, &quot;title&quot;: &quot;Survey of Calculus and Its Applications II&quot;, &quot;description&quot;: &quot;Continuation of MTH 121 . Maximization of functions of several variables using both calculus and elementary linear programming techniques. Elementary integration, simple differential equations, matrix algebra.&quot;, &quot;credits&quot;: &quot;4&quot;, &quot;grading&quot;: &quot;Graded (GRD)&quot;, &quot;typically_offered&quot;: &quot;Fall, Spring, Summer, Winter&quot;, &quot;requisites&quot;: &quot;Pre-Requisite: MTH 121 or MTH 141 or MTH 136 and MTH 137 .&quot;, &quot;flexible&quot;: true, &quot;also_ubc&quot;: false, &quot;catalog_url&quot;: &quot;https://catalogs.buffalo.edu/preview_program.php?catoid=21&amp;poid=9604&amp;returnto=1177&quot;, &quot;groups&quot;: [{&quot;requirement_type&quot;: &quot;choice_required&quot;, &quot;group&quot;: &quot;Psychology BS Core: Calculus sequence (choose 1 of 2 sequences)&quot;, &quot;courses&quot;: [{&quot;code&quot;: &quot;MTH 121LR&quot;, &quot;title&quot;: &quot;Survey of Calculus and Its Applications I&quot;}, {&quot;code&quot;: &quot;MTH 122LR&quot;, &quot;title&quot;: &quot;Survey of Calculus and Its Applications II&quot;}, {&quot;code&quot;: &quot;MTH 141LR&quot;, &quot;title&quot;: &quot;College Calculus I&quot;}, {&quot;code&quot;: &quot;MTH 142LR&quot;, &quot;title&quot;: &quot;College Calculus 2&quot;}]}]}\" role=\"button\" tabindex=\"0\"><div class=\"box-eyebrow\"><span class=\"box-eyebrow-tag\">full list on click</span></div><div class=\"box-label\">Psychology BS Core: Calculus sequence (choose 1 of 2 sequences)</div><span class=\"box-credits\">4 cr</span></div></div><div class=\"slot\"><div class=\"box box-course\" id=\"psychology-bs-school-counseling-edm__box-1-4-0\" data-detail=\"{&quot;kind&quot;: &quot;course&quot;, &quot;title&quot;: &quot;Writing and Rhetoric&quot;, &quot;description&quot;: &quot;An introduction to research, writing, and rhetorical practices employed in academic and professional contexts. The course examines the operation of genres, the audiences they address, and the purposes they serve. The course focuses on the analysis and development of student writing and rhetorical practice. Assignments include research essays, digital compositions, and oral presentations.&quot;, &quot;credits&quot;: &quot;4&quot;, &quot;grading&quot;: &quot;Graded (GRD)&quot;, &quot;typically_offered&quot;: &quot;Fall, Spring, Summer&quot;, &quot;requisites&quot;: &quot;ENG 105 non-Z Requisite&quot;, &quot;flexible&quot;: false, &quot;also_ubc&quot;: true}\" role=\"button\" tabindex=\"0\"><div class=\"box-eyebrow\"><span class=\"box-eyebrow-tag box-ubc-tag\">UB Curriculum</span></div><div class=\"box-label\"><span class=\"box-code\">ENG 105LEC</span><span class=\"box-title\">Writing and Rhetoric</span></div><span class=\"box-credits\">4 cr</span></div></div></div>\n        <div class=\"col-total\">15 credits</div>\n      </div>\n      <div class=\"semester-col term-fall\">\n        <div class=\"col-header\"><span class=\"col-year\">Year 2</span><span class=\"col-term\">Fall</span></div>\n        <div class=\"col-slots\"><div class=\"slot\"><div class=\"box box-course\" id=\"psychology-bs-school-counseling-edm__box-2-0-0\" data-detail=\"{&quot;kind&quot;: &quot;course&quot;, &quot;title&quot;: &quot;Psychological Statistics&quot;, &quot;description&quot;: &quot;Graphs; permutations; combinations; probability; regression; correlation; analysis of variance; descriptive and inferential statistics; parametric and nonparametric tests appropriate to psychological research. Three hours of lecture and one hour of recitation weekly.&quot;, &quot;credits&quot;: &quot;4&quot;, &quot;grading&quot;: &quot;Graded (GRD)&quot;, &quot;typically_offered&quot;: &quot;Fall, Spring, Summer&quot;, &quot;requisites&quot;: null, &quot;flexible&quot;: false, &quot;also_ubc&quot;: true}\" role=\"button\" tabindex=\"0\"><div class=\"box-eyebrow\"><span class=\"box-eyebrow-tag box-ubc-tag\">UB Curriculum</span></div><div class=\"box-label\"><span class=\"box-code\">PSY 207LLB</span><span class=\"box-title\">Psychological Statistics</span></div><span class=\"box-credits\">4 cr</span></div></div><div class=\"slot\"><div class=\"box box-course box-flexible\" id=\"psychology-bs-school-counseling-edm__box-2-1-0\" data-detail=\"{&quot;kind&quot;: &quot;generic&quot;, &quot;category&quot;: &quot;major_requirement&quot;, &quot;description&quot;: &quot;\\&quot;Substantive Area Course\\&quot; is a flexible requirement slot defined by this major&#x27;s own requirements, not a specific course - see the Undergraduate Catalog for the exact eligible options.&quot;, &quot;catalog_url&quot;: &quot;https://catalogs.buffalo.edu/preview_program.php?catoid=21&amp;poid=9604&amp;returnto=1177&quot;}\" role=\"button\" tabindex=\"0\"><div class=\"box-eyebrow\"><span class=\"box-eyebrow-tag\">Requirement in the major</span></div><div class=\"box-label\">Substantive Area Course</div><span class=\"box-credits\">3 cr</span></div></div><div class=\"slot\"><div class=\"box box-course box-flexible\" id=\"psychology-bs-school-counseling-edm__box-2-2-0\" data-detail=\"{&quot;kind&quot;: &quot;course&quot;, &quot;title&quot;: &quot;General Chemistry&quot;, &quot;description&quot;: &quot;Introduces fundamental concepts of chemistry, and surveys important chemical elements and their compounds. The first semester course of a two-semester sequence of general chemistry designed for students in sciences and engineering. Topics include stoichiometry, reactions in solution, thermochemistry, atomic and molecular structure and bonding, gas laws, intermolecular forces, and phases of matter. Three hours of lecture plus one 50-minute recitation weekly. Examinations are scheduled outside of the listed class times.&quot;, &quot;credits&quot;: &quot;4&quot;, &quot;grading&quot;: &quot;Graded (GRD)&quot;, &quot;typically_offered&quot;: &quot;Fall, Spring, Summer&quot;, &quot;requisites&quot;: null, &quot;flexible&quot;: true, &quot;also_ubc&quot;: true, &quot;catalog_url&quot;: &quot;https://catalogs.buffalo.edu/preview_program.php?catoid=21&amp;poid=9604&amp;returnto=1177&quot;, &quot;groups&quot;: [{&quot;requirement_type&quot;: &quot;choice_required&quot;, &quot;group&quot;: &quot;Additional Science Requirements: Chemistry sequence 1 (choose 1 of 2 options)&quot;, &quot;courses&quot;: [{&quot;code&quot;: &quot;CHE 101LR&quot;, &quot;title&quot;: &quot;General Chemistry&quot;}, {&quot;code&quot;: &quot;CHE 113LAB&quot;, &quot;title&quot;: &quot;General Chemistry&quot;}, {&quot;code&quot;: &quot;CHE 105LLR&quot;, &quot;title&quot;: &quot;Chemistry: Principles and Applications&quot;}]}]}\" role=\"button\" tabindex=\"0\"><div class=\"box-eyebrow\"><span class=\"box-eyebrow-tag\">full list on click</span><span class=\"box-eyebrow-sep\"> &middot; </span><span class=\"box-eyebrow-tag box-ubc-tag\">UB Curriculum</span></div><div class=\"box-label\">Additional Science Requirements: Chemistry sequence 1 (choose 1 of 2 options)</div><span class=\"box-credits\">4 cr</span></div></div><div class=\"slot\"><div class=\"box box-course box-flexible\" id=\"psychology-bs-school-counseling-edm__box-2-3-0\" data-detail=\"{&quot;kind&quot;: &quot;course&quot;, &quot;title&quot;: &quot;General Chemistry&quot;, &quot;description&quot;: &quot;There is a fee associated with this class. Consists of the lab components of CHE 101 .&quot;, &quot;credits&quot;: &quot;1&quot;, &quot;grading&quot;: &quot;Graded (GRD)&quot;, &quot;typically_offered&quot;: &quot;Fall, Spring, Summer&quot;, &quot;requisites&quot;: &quot;Co-Requisite: CHE 101&quot;, &quot;flexible&quot;: true, &quot;also_ubc&quot;: true, &quot;catalog_url&quot;: &quot;https://catalogs.buffalo.edu/preview_program.php?catoid=21&amp;poid=9604&amp;returnto=1177&quot;, &quot;groups&quot;: [{&quot;requirement_type&quot;: &quot;choice_required&quot;, &quot;group&quot;: &quot;Additional Science Requirements: Chemistry sequence 1 (choose 1 of 2 options)&quot;, &quot;courses&quot;: [{&quot;code&quot;: &quot;CHE 101LR&quot;, &quot;title&quot;: &quot;General Chemistry&quot;}, {&quot;code&quot;: &quot;CHE 113LAB&quot;, &quot;title&quot;: &quot;General Chemistry&quot;}, {&quot;code&quot;: &quot;CHE 105LLR&quot;, &quot;title&quot;: &quot;Chemistry: Principles and Applications&quot;}]}]}\" role=\"button\" tabindex=\"0\"><div class=\"box-eyebrow\"><span class=\"box-eyebrow-tag\">full list on click</span><span class=\"box-eyebrow-sep\"> &middot; </span><span class=\"box-eyebrow-tag box-ubc-tag\">UB Curriculum</span></div><div class=\"box-label\">Additional Science Requirements: Chemistry sequence 1 (choose 1 of 2 options)</div><span class=\"box-credits\">1 cr</span></div></div><div class=\"slot\"><div class=\"box box-generic\" id=\"psychology-bs-school-counseling-edm__box-2-4-0\" data-detail=\"{&quot;kind&quot;: &quot;generic&quot;, &quot;category&quot;: &quot;ubc&quot;, &quot;description&quot;: &quot;Pathway: a UB Curriculum Thematic or Global Pathway course - part of at least four UB Areas/SUNY General Education categories a student&#x27;s Pathways coursework must satisfy across two Pathways (one Thematic, one Global).&quot;, &quot;catalog_url&quot;: &quot;https://www.buffalo.edu/ubcurriculum/pathways.html&quot;}\" role=\"button\" tabindex=\"0\"><div class=\"box-eyebrow\"><span class=\"box-eyebrow-tag box-ubc-tag\">UB Curriculum</span></div><div class=\"box-label\">Pathway</div><span class=\"box-credits\">3 cr</span></div></div></div>\n        <div class=\"col-total\">15 credits</div>\n      </div>\n      <div class