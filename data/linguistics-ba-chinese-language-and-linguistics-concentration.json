uistics-ba-chinese-language-and-linguistics-concentration__box-3-3-0&quot;: {&quot;prereq-immediate&quot;: [&quot;linguistics-ba-chinese-language-and-linguistics-concentration__box-2-2-0&quot;], &quot;prereq-sequence&quot;: [&quot;linguistics-ba-chinese-language-and-linguistics-concentration__box-0-2-0&quot;, &quot;linguistics-ba-chinese-language-and-linguistics-concentration__box-1-3-0&quot;]}}\"><div class=\"scroll-hint\">Scroll right for more semesters \u2192</div><div class=\"flow-scroll\"><div class=\"flow-container\">\n      <div class=\"semester-col term-fall\">\n        <div class=\"col-header\"><span class=\"col-year\">Year 1</span><span class=\"col-term\">Fall</span></div>\n        <div class=\"col-slots\"><div class=\"slot\"><div class=\"box box-generic\" id=\"linguistics-ba-chinese-language-and-linguistics-concentration__box-0-0-0\" data-detail=\"{&quot;kind&quot;: &quot;generic&quot;, &quot;category&quot;: &quot;ubc&quot;, &quot;description&quot;: &quot;UB Seminar: a 1- or 3-credit seminar every student completes in their first semester of enrollment, taught by faculty across departments around a &#x27;big idea&#x27; in the discipline. A UB Curriculum core requirement, not specific to this major.&quot;, &quot;catalog_url&quot;: &quot;https://www.buffalo.edu/ubcurriculum/seminar.html&quot;}\" role=\"button\" tabindex=\"0\"><div class=\"box-eyebrow\"><span class=\"box-eyebrow-tag box-ubc-tag\">UB Curriculum</span></div><div class=\"box-label\">UB Seminar</div><span class=\"box-credits\">3 cr</span></div></div><div class=\"slot\"><div class=\"or-group\"><div class=\"box box-course\" id=\"linguistics-ba-chinese-language-and-linguistics-concentration__box-0-1-0\" data-detail=\"{&quot;kind&quot;: &quot;course&quot;, &quot;title&quot;: &quot;Writing and Rhetoric&quot;, &quot;description&quot;: &quot;An introduction to research, writing, and rhetorical practices employed in academic and professional contexts. The course examines the operation of genres, the audiences they address, and the purposes they serve. The course focuses on the analysis and development of student writing and rhetorical practice. Assignments include research essays, digital compositions, and oral presentations.&quot;, &quot;credits&quot;: &quot;4&quot;, &quot;grading&quot;: &quot;Graded (GRD)&quot;, &quot;typically_offered&quot;: &quot;Fall, Spring, Summer&quot;, &quot;requisites&quot;: &quot;ENG 105 non-Z Requisite&quot;, &quot;flexible&quot;: false, &quot;also_ubc&quot;: true}\" role=\"button\" tabindex=\"0\"><div class=\"box-eyebrow\"><span class=\"box-eyebrow-tag box-ubc-tag\">UB Curriculum</span></div><div class=\"box-label\"><span class=\"box-code\">ENG 105LEC</span><span class=\"box-title\">Writing and Rhetoric</span></div><span class=\"box-credits\">4 cr</span><div class=\"box-note\">(may also be completed in a different semester shown)</div></div><div class=\"or-sep\">or</div><div class=\"box box-generic\" id=\"linguistics-ba-chinese-language-and-linguistics-concentration__box-0-1-1\" data-detail=\"{&quot;kind&quot;: &quot;generic&quot;, &quot;category&quot;: &quot;ubc&quot;, &quot;description&quot;: &quot;Pathway: a UB Curriculum Thematic or Global Pathway course - part of at least four UB Areas/SUNY General Education categories a student&#x27;s Pathways coursework must satisfy across two Pathways (one Thematic, one Global).&quot;, &quot;catalog_url&quot;: &quot;https://www.buffalo.edu/ubcurriculum/pathways.html&quot;}\" role=\"button\" tabindex=\"0\"><div class=\"box-eyebrow\"><span class=\"box-eyebrow-tag box-ubc-tag\">UB Curriculum</span></div><div class=\"box-label\">Pathway</div><span class=\"box-credits\">3 cr</span></div></div></div><div class=\"slot\"><div class=\"box box-course box-flexible\" id=\"linguistics-ba-chinese-language-and-linguistics-concentration__box-0-2-0\" data-detail=\"{&quot;kind&quot;: &quot;course&quot;, &quot;title&quot;: &quot;First-Year Chinese 1st Semester&quot;, &quot;description&quot;: &quot;As the first half of the first year Mandarin Chinese at University of Buffalo (UB), this course is designed for students to acquire some fundamental skills in Mandarin Chinese language and to learn some key elements of Chinese culture. Students will develop ability in handling some typical daily situations through class activities and assignments. The development of speaking and listening skills will be emphasized; reading and writing skills will also be cultivated. This course is only open to beginners who have no prior knowledge of Chinese, NOT native speakers of Chinese.&quot;, &quot;credits&quot;: &quot;6&quot;, &quot;grading&quot;: &quot;Graded (GRD)&quot;, &quot;typically_offered&quot;: &quot;Fall&quot;, &quot;requisites&quot;: null, &quot;flexible&quot;: true, &quot;also_ubc&quot;: false, &quot;catalog_url&quot;: &quot;https://catalogs.buffalo.edu/preview_program.php?catoid=21&amp;poid=8210&amp;returnto=1177&quot;, &quot;groups&quot;: [{&quot;requirement_type&quot;: &quot;choice_required&quot;, &quot;group&quot;: &quot;First-Year Chinese sequence (choose one of 3 options: 101+102, 111+112, or 104/114)&quot;, &quot;courses&quot;: [{&quot;code&quot;: &quot;CHI 101LEC&quot;, &quot;title&quot;: &quot;First-Year Chinese&quot;}, {&quot;code&quot;: &quot;CHI 102LEC&quot;, &quot;title&quot;: &quot;First-Year Chinese&quot;}, {&quot;code&quot;: &quot;CHI 111DIS&quot;, &quot;title&quot;: &quot;First-Year Chinese 1st Semester&quot;}, {&quot;code&quot;: &quot;CHI 112DIS&quot;, &quot;title&quot;: &quot;First-Year Chinese 2nd Semester&quot;}, {&quot;code&quot;: &quot;CHI 104LEC&quot;, &quot;title&quot;: &quot;First-Year Chinese for Heritage Learners&quot;}, {&quot;code&quot;: &quot;CHI 114DIS&quot;, &quot;title&quot;: &quot;First-Year Chinese for Heritage Learners&quot;}]}]}\" role=\"button\" tabindex=\"0\"><div class=\"box-eyebrow\"><span class=\"box-eyebrow-tag\">full list on click</span></div><div class=\"box-label\">First-Year Chinese sequence (choose one of 3 options: 101+102, 111+112, or 104/114)</div><span class=\"box-credits\">6 cr</span></div></div><div class=\"slot\"><div class=\"box box-course\" id=\"linguistics-ba-chinese-language-and-linguistics-concentration__box-0-3-0\" data-detail=\"{&quot;kind&quot;: &quot;course&quot;, &quot;title&quot;: &quot;Introduction to Linguistic Analysis&quot;, &quot;description&quot;: &quot;Introduces the structure of language (phonetics, phonology, morphology, semantics, and syntax), looking at a broad variety of languages; approaches to linguistic analysis and theory.&quot;, &quot;credits&quot;: &quot;3&quot;, &quot;grading&quot;: &quot;Graded (GRD)&quot;, &quot;typically_offered&quot;: &quot;Fall, Spring&quot;, &quot;requisites&quot;: null, &quot;flexible&quot;: false, &quot;also_ubc&quot;: false}\" role=\"button\" tabindex=\"0\"><div class=\"box-label\"><span class=\"box-code\">LIN 205LEC</span><span class=\"box-title\">Introduction to Linguistic Analysis</span></div><span class=\"box-credits\">3 cr</span></div></div></div>\n        <div class=\"col-total\">14 or 15 credits</div>\n      </div>\n      <div class=\"semester-col term-spring\">\n        <div class=\"col-header\"><span class=\"col-year\">Year 1</span><span class=\"col-term\">Spring</span></div>\n        <div class=\"col-slots\"><div class=\"slot\"><div class=\"box box-generic\" id=\"linguistics-ba-chinese-language-and-linguistics-concentration__box-1-0-0\" data-detail=\"{&quot;kind&quot;: &quot;generic&quot;, &quot;category&quot;: &quot;ubc&quot;, &quot;description&quot;: &quot;Scientific Literacy and Inquiry: a 7-credit UB Curriculum Foundations requirement (two lecture courses plus a matching 1-credit lab from the same subject area).&quot;, &quot;catalog_url&quot;: &quot;https://www.buffalo.edu/ubcurriculum/foundations.html&quot;}\" role=\"button\" tabindex=\"0\"><div class=\"box-eyebrow\"><span class=\"box-eyebrow-tag box-ubc-tag\">UB Curriculum</span></div><div class=\"box-label\">Scientific Literacy 2</div><span class=\"box-credits\">3 cr</span></div></div><div class=\"slot\"><div class=\"box box-generic\" id=\"linguistics-ba-chinese-language-and-linguistics-concentration__box-1-1-0\" data-detail=\"{&quot;kind&quot;: &quot;generic&quot;, &quot;category&quot;: &quot;ubc&quot;, &quot;description&quot;: &quot;Scientific Literacy and Inquiry: a 7-credit UB Curriculum Foundations requirement (two lecture courses plus a matching 1-credit lab from the same subject area).&quot;, &quot;catalog_url&quot;: &quot;https://www.buffalo.edu/ubcurriculum/foundations.html&quot;}\" role=\"button\" tabindex=\"0\"><div class=\"box-eyebrow\"><span class=\"box-eyebrow-tag box-ubc-tag\">UB Curriculum</span></div><div class=\"box-label\">Scientific Lab</div><span class=\"box-credits\">1 cr</span></div></div><div class=\"slot\"><div class=\"or-group\"><div class=\"box box-course\" id=\"linguistics-ba-chinese-language-and-linguistics-concentration__box-1-2-0\" data-detail=\"{&quot;kind&quot;: &quot;course&quot;, &quot;title&quot;: &quot;Writing and Rhetoric&quot;, &quot;description&quot;: &quot;An introduction to research, writing, and rhetorical practices employed in academic and professional contexts. The course examines the operation of genres, the audiences they address, and the purposes they serve. The course focuses on the analysis and development of student writing and rhetorical practice. Assignments include research essays, digital compositions, and oral presentations.&quot;, &quot;credits&quot;: &quot;4&quot;, &quot;grading&quot;: &quot;Graded (GRD)&quot;, &quot;typically_offered&quot;: &quot;Fall, Spring, Summer&quot;, &quot;requisites&quot;: &quot;ENG 105 non-Z Requisite&quot;, &quot;flexible&quot;: false, &quot;also_ubc&quot;: true}\" role=\"button\" tabindex=\"0\"><div class=\"box-eyebrow\"><span class=\"box-eyebrow-tag box-ubc-tag\">UB Curriculum</span></div><div class=\"box-label\"><span class=\"box-code\">ENG 105LEC</span><span class=\"box-title\">Writing and Rhetoric</span></div><span class=\"box-credits\">4 cr</span><div class=\"box-note\">(may also be completed in a different semester shown)</div></div><div class=\"or-sep\">or</div><div class=\"box box-generic\" id=\"linguistics-ba-chinese-language-and-linguistics-concentration__box-1-2-1\" data-detail=\"{&quot;kind&quot;: &quot;generic&quot;, &quot;category&quot;: &quot;ubc&quot;, &quot;description&quot;: &quot;Pathway: a UB Curriculum Thematic or Global Pathway course - part of at least four UB Areas/SUNY General Education categories a student&#x27;s Pathways coursework must satisfy across two Pathways (one Thematic, one Global).&quot;, &quot;catalog_url&quot;: &quot;https://www.buffalo.edu/ubcurriculum/pathways.html&quot;}\" role=\"button\" tabindex=\"0\"><div class=\"box-eyebrow\"><span class=\"box-eyebrow-tag box-ubc-tag\">UB Curriculum</span></div><div class=\"box-label\">Pathway</div><span class=\"box-credits\">3 cr</span></div></div></div><div class=\"slot\"><div class=\"box box-course box-flexible\" id=\"linguistics-ba-chinese-language-and-linguistics-concentration__box-1-3-0\" data-detail=\"{&quot;kind&quot;: &quot;course&quot;, &quot;title&quot;: &quot;First-Year Chinese 2nd Semester&quot;, &quot;description&quot;: &quot;As the second half of the first year Mandarin Chinese at University of Buffalo (UB), this course is designed for students who have taken CHI 101 or have equivalent knowledge of Mandarin Chinese. This course aims to teach fundamental skills in Mandarin Chinese language and key elements of Chinese culture. Students will develop ability in handling some typical daily situations through class activities and assignments. The development of speaking and listening skills will be emphasized; reading and writing skills will also be cultivated. This course is NOT open to native speakers of Chinese.&quot;, &quot;credits&quot;: &quot;3&quot;, &quot;grading&quot;: &quot;Graded (GRD)&quot;, &quot;typically_offered&quot;: &quot;Spring&quot;, &quot;requisites&quot;: &quot;Pre-Requisite: CHI 101 or CHI 111&quot;, &quot;flexible&quot;: true, &quot;also_ubc&quot;: false, &quot;catalog_url&quot;: &quot;https://catalogs.buffalo.edu/preview_program.php?catoid=21&amp;poid=8210&amp;returnto=1177&quot;, &quot;groups&quot;: [{&quot;requirement_type&quot;: &quot;choice_required&quot;, &quot;group&quot;: &quot;First-Year Chinese sequence (choose one of 3 options: 101+102, 111+112, or 104/114)&quot;, &quot;courses&quot;: [{&quot;code&quot;: &quot;CHI 101LEC&quot;, &quot;title&quot;: &quot;First-Year Chinese&quot;}, {&quot;code&quot;: &quot;CHI 102LEC&quot;, &quot;title&quot;: &quot;First-Year Chinese&quot;}, {&quot;code&quot;: &quot;CHI 111DIS&quot;, &quot;title&quot;: &quot;First-Year Chinese 1st Semester&quot;}, {&quot;code&quot;: &quot;CHI 112DIS&quot;, &quot;title&quot;: &quot;First-Year Chinese 2nd Semester&quot;}, {&quot;code&quot;: &quot;CHI 104LEC&quot;, &quot;title&quot;: &quot;First-Year Chinese for Heritage Learners&quot;}, {&quot;code&quot;: &quot;CHI 114DIS&quot;, &quot;title&quot;: &quot;First-Year Chinese for Heritage Learners&quot;}]}]}\" role=\"button\" tabindex=\"0\"><div class=\"box-eyebrow\"><span class=\"box-eyebrow-tag\">full list on click</span></div><div class=\"box-label\">First-Year Chinese sequence (choose one of 3 options: 101+102, 111+112, or 104/114)</div><span class=\"box-credits\">3 cr</span></div></div><div class=\"slot\"><div class=\"box box-course box-flexible\" id=\"linguistics-ba-chinese-language-and-linguistics-concentration__box-1-4-0\" data-detail=\"{&quot;kind&quot;: &quot;generic&quot;, &quot;category&quot;: &quot;major_requirement&quot;, &quot;description&quot;: &quot;\\&quot;LIN Any Level Course\\&quot; is a flexible requirement slot defined by this major&#x27;s own requirements, not a specific course - see the Undergraduate Catalog for the exact eligible options.&quot;, &quot;catalog_url&quot;: &quot;https://catalogs.buffalo.edu/preview_program.php?catoid=21&amp;poid=8210&amp;returnto=1177&quot;}\" role=\"button\" tabindex=\"0\"><div class=\"box-eyebrow\"><span class=\"box-eyebrow-tag\">Requirement in the major</span></div><div class=\"box-label\">LIN Any Level Course</div><span class=\"box-credits\">3 cr</span></div></div></div>\n        <div class=\"col-total\">15 or 16 credits</div>\n      </div>\n      <div class=\"semester-col term-fall\">\n        <div class=\"col-header\"><span class=\"col-year\">Year 2</span><span class=\"col-term\">Fall</span></div>\n        <div class=\"col-slots\"><div class=\"slot\"><div class=\"box box-generic\" id=\"linguistics-ba-chinese-language-and-linguistics-concentration__box-2-0-0\" data-detail=\"{&quot;kind&quot;: &quot;generic&quot;, &quot;category&quot;: &quot;ubc&quot;, &quot;description&quot;: &quot;Scientific Literacy and Inquiry: a 7-credit UB Curriculum Foundations requirement (two lecture courses plus a matching 1-credit lab from the same subject area).&quot;, &quot;catalog_url&quot;: &quot;https://www.buffalo.edu/ubcurriculum/foundations.html&quot;}\" role=\"button\" tabindex=\"0\"><div class=\"box-eyebrow\"><span class=\"box-eyebrow-tag box-ubc-tag\">UB Curriculum</span></div><div class=\"box-label\">Scientific Literacy 1</div><span class=\"box-credits\">3 cr</span></div></div><div class=\"slot\"><div class=\"box box-generic\" id=\"linguistics-ba-chinese-language-and-linguistics-concentration__box-2-1-0\" data-detail=\"{&quot;kind&quot;: &quot;generic&quot;, &quot;category&quot;: &quot;ubc&quot;, &quot;description&quot;: &quot;Pathway: a UB Curriculum Thematic or Global Pathway course - part of at least four UB Areas/SUNY General Education categories a student&#x27;s Pathways coursework must satisfy across two Pathways (one Thematic, one Global).&quot;, &quot;catalog_url&quot;: &quot;https://www.buffalo.edu/ubcurriculum/pathways.html&quot;}\" role=\"button\" tabindex=\"0\"><div class=\"box-eyebrow\"><span class=\"box-eyebrow-tag box-ubc-tag\">UB Curriculum</span></div><div class=\"box-label\">Pathway</div><span class=\"box-credits\">3 cr</span></div></div><div class=\"slot\"><div class=\"box box-course box-flexible\" id=\"linguistics-ba-chinese-language-and-linguistics-concentration__box-2-2-0\" data-detail=\"{&quot;kind&quot;: &quot;course&quot;, &quot;title&quot;: &quot;Second-Year Chinese&quot;, &quot;description&quot;: &quot;Continuation of CHI 112. Continuing instruction in written and spoken Chinese with particular emphasis on consolidating basic conversational skills and improving reading confidence and ability. Reading speed is substantially accelerated, and there is aural and oral practice based on the reading materials. Semi-formal composition is introduced to write about the different aspects of Chinese culture taught in this course. NOT open to native speakers. An optional course for Chinese Minor.&quot;, &quot;credits&quot;: &quot;4&quot;, &quot;grading&quot;: &quot;Graded&quot;, &quot;typically_offered&quot;: &quot;Fall&quot;, &quot;requisites&quot;: &quot;Pre-Requisite: CHI 102 or CHI 112 or AVANT Placement Scores of 4. For information visit: https://arts-sciences.buffalo.edu/romance-languages-literatures/language-placement-testing.html&quot;, &quot;flexible&quot;: true, &quot;also_ubc&quot;: false, &quot;catalog_url&quot;: &quot;https://catalogs.buffalo.edu/preview_program.php?catoid=21&amp;poid=8210&amp;returnto=1177&quot;, &quot;groups&quot;: [{&quot;requirement_type&quot;: &quot;choice_required&quot;, &quot;group&quot;: &quot;Second-Year Chinese sequence (choose one of 2 options: 201+202, or 204)&quot;, &quot;courses&quot;: [{&quot;code&quot;: &quot;CHI 201LEC&quot;, &quot;title&quot;: &quot;Second-Year Chinese&quot;}, {&quot;code&quot;: &quot;CHI 202LEC&quot;, &quot;title&quot;: &quot;Second-Year Chinese&quot;}, {&quot;code&quot;: &quot;CHI 204DIS&quot;, &quot;title&quot;: &quot;Second-Year Chinese for Heritage Learners&quot;}]}]}\" role=\"button\" tabindex=\"0\"><div class=\"box-eyebrow\"><span class=\"box-eyebrow-tag\">full list on click</span></div><div class=\"box-label\">Second-Year Chinese sequence (choose one of 2 options: 201+202, or 204)</div><span class=\"box-credits\">4 cr</span></div></div><div class=\"slot\"><div class=\"box box-course\" id=\"linguistics-ba-chinese-language-and-linguistics-concentration__box-2-3-0\" data-detail=\"{&quot;kind&quot;: &quot;course&quot;, &quot;title&quot;: &quot;Structure of English: The Sound System&quot;, &quot;description&quot;: &quot;Sound structure of English, including the articulation of sounds, phonological patterns and alternations, and dialects. This course is the same as ENG 389 and course repeat rules will apply. Students should consult with their major department regarding any restrictions on their degree requirements.&quot;, &quot;credits&quot;: &quot;3&quot;, &quot;grading&quot;: &quot;Graded (GRD)&quot;, &quot;typically_offered&quot;: &quot;Fall, Spring&quot;, &quot;requisites&quot;: &quot;Pre-Requisite: LIN 205 .&quot;, &quot;flexible&quot;: false, &quot;also_ubc&quot;: false}\" role=\"button\" tabindex=\"0\"><div class=\"box-label\"><span class=\"box-code\">LIN 301LEC</span><span class=\"box-title\">Structure of English: The Sound System</span></div><span class=\"box-credits\">3 cr</span></div></div><div class=\"slot\"><div class=\"box box-course\" id=\"linguistics-ba-chinese-language-and-linguistics-concentration__box-2-4-0\" data-detail=\"{&quot;kind&quot;: &quot;course&quot;, &quot;title&quot;: &quot;Structure of English: Grammar and Lexicon&quot;, &quot;description&quot;: &quot;Syntax and morphology of English, including lexical and grammatical categories, basic clause structure, and complex sentences. This course is the same as ENG 390 and course repeat rules will apply. Students should consult with their major department regarding any restrictions on their degree requirements.&quot;, &quot;credits&quot;: &quot;3&quot;, &quot;grading&quot;: &quot;Graded (GRD)&quot;, &quot;typically_offered&quot;: &quot;Fall, Spring&quot;, &quot;requisites&quot;: &quot;Pre-Requisite: LIN 205 .&quo