it Administration and Evaluation&quot;}, {&quot;code&quot;: &quot;SSC 452SEM&quot;, &quot;title&quot;: &quot;Fundraising and Philanthropy&quot;}, {&quot;code&quot;: &quot;SSC 496TUT&quot;, &quot;title&quot;: &quot;Internship&quot;}]}], &quot;catalog_url&quot;: &quot;https://catalogs.buffalo.edu/preview_program.php?catoid=21&amp;poid=8024&amp;returnto=1177&quot;}\" role=\"button\" tabindex=\"0\"><div class=\"box-label\"><span class=\"box-code\">SSC 420SEM</span><span class=\"box-title\">Child Mental Health</span></div><span class=\"box-credits\">3 cr</span></div></div></div>\n        <div class=\"col-total\">15 credits</div>\n      </div>\n      <div class=\"semester-col term-spring\">\n        <div class=\"col-header\"><span class=\"col-year\">Year 3</span><span class=\"col-term\">Spring</span></div>\n        <div class=\"col-slots\"><div class=\"slot\"><div class=\"box box-course\" id=\"health-and-human-services-ba-child-and-family-studies-concentration-early-childhood-childhood-education-edm__box-5-0-0\" data-detail=\"{&quot;kind&quot;: &quot;course&quot;, &quot;title&quot;: &quot;UB Curriculum Capstone&quot;, &quot;description&quot;: &quot;UB Curriculum Capstone (UBC 399) is the culminating general education requirement. It is a one-credit course in which you will work in UBPortfolio, with the support of your Capstone instructor, to create a reflective and integrative Capstone ePortfolio based on your UB Curriculum coursework and lived experiences outside of the classroom. All UB Curriculum courses must be completed or in-progress to enroll in and complete UBC 399. Students who drop an in-progress course will be removed from UBC 399 through the add/drop period. Students who resign an in-progress course may not be able to successfully complete the Capstone.&quot;, &quot;credits&quot;: &quot;1&quot;, &quot;grading&quot;: &quot;Graded (GRD)&quot;, &quot;typically_offered&quot;: &quot;Fall, Spring&quot;, &quot;requisites&quot;: &quot;All UB Curriculum courses must be completed or in-progress to enroll in and complete UBC 399. UB Seminar is a prerequisite to UBC 399 and therefore cannot be taken concurrently. If you enrolled today in your remaining UBC course(s), HUB will allow you to enroll tomorrow. For questions, email: ubcurriculum@buffalo.edu.&quot;, &quot;flexible&quot;: false, &quot;also_ubc&quot;: true}\" role=\"button\" tabindex=\"0\"><div class=\"box-eyebrow\"><span class=\"box-eyebrow-tag box-ubc-tag\">UB Curriculum</span></div><div class=\"box-label\"><span class=\"box-code\">UBC 399MNT</span><span class=\"box-title\">UB Curriculum Capstone</span></div><span class=\"box-credits\">1 cr</span></div></div><div class=\"slot\"><div class=\"box box-course box-flexible\" id=\"health-and-human-services-ba-child-and-family-studies-concentration-early-childhood-childhood-education-edm__box-5-1-0\" data-detail=\"{&quot;kind&quot;: &quot;generic&quot;, &quot;category&quot;: &quot;major_requirement&quot;, &quot;description&quot;: &quot;\\&quot;Concentration Course\\&quot; is a flexible requirement slot defined by this major&#x27;s own requirements, not a specific course - see the Undergraduate Catalog for the exact eligible options.&quot;, &quot;catalog_url&quot;: &quot;https://catalogs.buffalo.edu/preview_program.php?catoid=21&amp;poid=8024&amp;returnto=1177&quot;}\" role=\"button\" tabindex=\"0\"><div class=\"box-eyebrow\"><span class=\"box-eyebrow-tag\">Requirement in the major</span></div><div class=\"box-label\">Concentration Course</div><span class=\"box-credits\">3 cr</span></div></div><div class=\"slot\"><div class=\"box box-course box-flexible\" id=\"health-and-human-services-ba-child-and-family-studies-concentration-early-childhood-childhood-education-edm__box-5-2-0\" data-detail=\"{&quot;kind&quot;: &quot;generic&quot;, &quot;category&quot;: &quot;major_requirement&quot;, &quot;description&quot;: &quot;\\&quot;Concentration Course\\&quot; is a flexible requirement slot defined by this major&#x27;s own requirements, not a specific course - see the Undergraduate Catalog for the exact eligible options.&quot;, &quot;catalog_url&quot;: &quot;https://catalogs.buffalo.edu/preview_program.php?catoid=21&amp;poid=8024&amp;returnto=1177&quot;}\" role=\"button\" tabindex=\"0\"><div class=\"box-eyebrow\"><span class=\"box-eyebrow-tag\">Requirement in the major</span></div><div class=\"box-label\">Concentration Course</div><span class=\"box-credits\">3 cr</span></div></div><div class=\"slot\"><div class=\"box box-course\" id=\"health-and-human-services-ba-child-and-family-studies-concentration-early-childhood-childhood-education-edm__box-5-3-0\" data-detail=\"{&quot;kind&quot;: &quot;course&quot;, &quot;title&quot;: &quot;Seminar and Practicum in Early Childhood Programs&quot;, &quot;description&quot;: &quot;This course actively involves undergraduate students, one morning or afternoon per week, in a preschool classroom experience at the Fisher-Price Endowed Early Childhood Research Center (ECRC). It offers teachers guided learning experience in a NAEYC accredited preschool multicultural setting. The weekly one hour seminar provides the support needed by teachers in understanding and applying a constructive, play curriculum which fosters children\\u2019s social, emotional, physical and cognitive development. Child observation and naturalistic assessment are major course components.&quot;, &quot;credits&quot;: &quot;3&quot;, &quot;grading&quot;: &quot;Graded (GRD)&quot;, &quot;typically_offered&quot;: &quot;Fall, Spring, Summer&quot;, &quot;requisites&quot;: null, &quot;flexible&quot;: false, &quot;also_ubc&quot;: false}\" role=\"button\" tabindex=\"0\"><div class=\"box-label\"><span class=\"box-code\">LAI 490SEM</span><span class=\"box-title\">Seminar and Practicum in Early Childhood Programs</span></div><span class=\"box-credits\">3 cr</span></div></div><div class=\"slot\"><div class=\"box box-course\" id=\"health-and-human-services-ba-child-and-family-studies-concentration-early-childhood-childhood-education-edm__box-5-4-0\" data-detail=\"{&quot;kind&quot;: &quot;course&quot;, &quot;title&quot;: &quot;Teaching the Exceptional Learner in the Regular Education Classroom&quot;, &quot;description&quot;: &quot;The purpose of this course is to aid in understanding diversity by preparing teachers to offer direct and indirect services to students within the full range of disabilities and special health-care needs in inclusive environments. Students will be provided with techniques designed to enhance academic performance, classroom behavior, and social acceptance for students with disabilities and special needs. Students will learn skills enabling them to (1) differentiate and individualize instruction for students with disabilities and special needs, (2) become familiar with instructional and assistive technologies, (3) implement multiple research-validated instructional strategies, (4) formally and informally assess learning of diverse students, (5) manage classroom behavior of students with disabilities and special needs, and (6) collaborate with others and resolve conflicts to educate students with disabilities and special needs.&quot;, &quot;credits&quot;: &quot;3&quot;, &quot;grading&quot;: &quot;Graded (GRD)&quot;, &quot;typically_offered&quot;: &quot;Fall, Spring, Summer&quot;, &quot;requisites&quot;: null, &quot;flexible&quot;: false, &quot;also_ubc&quot;: false}\" role=\"button\" tabindex=\"0\"><div class=\"box-label\"><span class=\"box-code\">LAI 474SEM</span><span class=\"box-title\">Teaching the Exceptional Learner in the Regular Education Classroom</span></div><span class=\"box-credits\">3 cr</span></div></div></div>\n        <div class=\"col-total\">151-154 credits</div>\n      </div></div></div></section>"}