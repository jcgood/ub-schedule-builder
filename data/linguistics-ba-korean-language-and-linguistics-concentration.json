{"panel_html": "<section class=\"panel rel-scope active\" id=\"panel-container\" data-rel=\"{&quot;linguistics-ba-korean-language-and-linguistics-concentration__box-0-2-0&quot;: {&quot;postreq&quot;: [&quot;linguistics-ba-korean-language-and-linguistics-concentration__box-1-3-0&quot;]}, &quot;linguistics-ba-korean-language-and-linguistics-concentration__box-0-3-0&quot;: {&quot;postreq&quot;: [&quot;linguistics-ba-korean-language-and-linguistics-concentration__box-2-3-0&quot;, &quot;linguistics-ba-korean-language-and-linguistics-concentration__box-2-4-0&quot;]}, &quot;linguistics-ba-korean-language-and-linguistics-concentration__box-1-3-0&quot;: {&quot;prereq-immediate&quot;: [&quot;linguistics-ba-korean-language-and-linguistics-concentration__box-0-2-0&quot;]}, &quot;linguistics-ba-korean-language-and-linguistics-concentration__box-2-2-0&quot;: {&quot;postreq&quot;: [&quot;linguistics-ba-korean-language-and-linguistics-concentration__box-3-3-0&quot;]}, &quot;linguistics-ba-korean-language-and-linguistics-concentration__box-2-3-0&quot;: {&quot;prereq-immediate&quot;: [&quot;linguistics-ba-korean-language-and-linguistics-concentration__box-0-3-0&quot;]}, &quot;linguistics-ba-korean-language-and-linguistics-concentration__box-2-4-0&quot;: {&quot;prereq-immediate&quot;: [&quot;linguistics-ba-korean-language-and-linguistics-concentration__box-0-3-0&quot;]}, &quot;linguistics-ba-korean-language-and-linguistics-concentration__box-3-3-0&quot;: {&quot;prereq-immediate&quot;: [&quot;linguistics-ba-korean-language-and-linguistics-concentration__box-2-2-0&quot;]}}\"><div class=\"scroll-hint\">Scroll right for more semesters \u2192</div><div class=\"flow-scroll\"><div class=\"flow-container\">\n      <div class=\"semester-col term-fall\">\n        <div class=\"col-header\"><span class=\"col-year\">Year 1</span><span class=\"col-term\">Fall</span></div>\n        <div class=\"col-slots\"><div class=\"slot\"><div class=\"box box-generic\" id=\"linguistics-ba-korean-language-and-linguistics-concentration__box-0-0-0\" data-detail=\"{&quot;kind&quot;: &quot;generic&quot;, &quot;category&quot;: &quot;ubc&quot;, &quot;description&quot;: &quot;UB Seminar: a 1- or 3-credit seminar every student completes in their first semester of enrollment, taught by faculty across departments around a &#x27;big idea&#x27; in the discipline. A UB Curriculum core requirement, not specific to this major.&quot;, &quot;catalog_url&quot;: &quot;https://www.buffalo.edu/ubcurriculum/seminar.html&quot;}\" role=\"button\" tabindex=\"0\"><div class=\"box-eyebrow\"><span class=\"box-eyebrow-tag box-ubc-tag\">UB Curriculum</span></div><div class=\"box-label\">UB Seminar</div><span class=\"box-credits\">3 cr</span></div></div><div class=\"slot\"><div class=\"or-group\"><div class=\"box box-course\" id=\"linguistics-ba-korean-language-and-linguistics-concentration__box-0-1-0\" data-detail=\"{&quot;kind&quot;: &quot;course&quot;, &quot;title&quot;: &quot;Writing and Rhetoric&quot;, &quot;description&quot;: &quot;An introduction to research, writing, and rhetorical practices employed in academic and professional contexts. The course examines the operation of genres, the audiences they address, and the purposes they serve. The course focuses on the analysis and development of student writing and rhetorical practice. Assignments include research essays, digital compositions, and oral presentations.&quot;, &quot;credits&quot;: &quot;4&quot;, &quot;grading&quot;: &quot;Graded (GRD)&quot;, &quot;typically_offered&quot;: &quot;Fall, Spring, Summer&quot;, &quot;requisites&quot;: &quot;ENG 105 non-Z Requisite&quot;, &quot;flexible&quot;: false, &quot;also_ubc&quot;: true}\" role=\"button\" tabindex=\"0\"><div class=\"box-eyebrow\"><span class=\"box-eyebrow-tag box-ubc-tag\">UB Curriculum</span></div><div class=\"box-label\"><span class=\"box-code\">ENG 105LEC</span><span class=\"box-title\">Writing and Rhetoric</span></div><span class=\"box-credits\">4 cr</span><div class=\"box-note\">(may also be completed in a different semester shown)</div></div><div class=\"or-sep\">or</div><div class=\"box box-generic\" id=\"linguistics-ba-korean-language-and-linguistics-concentration__box-0-1-1\" data-detail=\"{&quot;kind&quot;: &quot;generic&quot;, &quot;category&quot;: &quot;ubc&quot;, &quot;description&quot;: &quot;Pathway: a UB Curriculum Thematic or Global Pathway course - part of at least four UB Areas/SUNY General Education categories a student&#x27;s Pathways coursework must satisfy across two Pathways (one Thematic, one Global).&quot;, &quot;catalog_url&quot;: &quot;https://www.buffalo.edu/ubcurriculum/pathways.html&quot;}\" role=\"button\" tabindex=\"0\"><div class=\"box-eyebrow\"><span class=\"box-eyebrow-tag box-ubc-tag\">UB Curriculum</span></div><div class=\"box-label\">Pathway</div><span class=\"box-credits\">3 cr</span></div></div></div><div class=\"slot\"><div class=\"box box-course box-flexible\" id=\"linguistics-ba-korean-language-and-linguistics-concentration__box-0-2-0\" data-detail=\"{&quot;kind&quot;: &quot;course&quot;, &quot;title&quot;: &quot;First-Year Korean 1st Semester&quot;, &quot;description&quot;: &quot;KOR 111 is the first half of the elementary Korean language course. The course is designed for students who have NO home language background or previous knowledge of the Korean language. The course will begin by introducing the writing and sound system of the Korean language. The remainder of the course will focus on four skills (listening, reading, speaking, and writing) as well as Korean culture.&quot;, &quot;credits&quot;: &quot;6&quot;, &quot;grading&quot;: &quot;Graded (GRD)&quot;, &quot;typically_offered&quot;: &quot;Fall&quot;, &quot;requisites&quot;: null, &quot;flexible&quot;: true, &quot;also_ubc&quot;: false, &quot;catalog_url&quot;: &quot;https://catalogs.buffalo.edu/preview_program.php?catoid=21&amp;poid=8001&amp;returnto=1177&quot;, &quot;groups&quot;: [{&quot;requirement_type&quot;: &quot;choice_required&quot;, &quot;group&quot;: &quot;First-Year Korean sequence (choose one sequence: 101LEC+102LEC or 111DIS+112DIS)&quot;, &quot;courses&quot;: [{&quot;code&quot;: &quot;KOR 101LEC&quot;, &quot;title&quot;: &quot;First-Year Korean&quot;}, {&quot;code&quot;: &quot;KOR 102LEC&quot;, &quot;title&quot;: &quot;First-Year Korean&quot;}, {&quot;code&quot;: &quot;KOR 111DIS&quot;, &quot;title&quot;: &quot;First-Year Korean 1st Semester&quot;}, {&quot;code&quot;: &quot;KOR 112DIS&quot;, &quot;title&quot;: &quot;First-Year Korean 2nd Semester&quot;}]}]}\" role=\"button\" tabindex=\"0\"><div class=\"box-eyebrow\"><span class=\"box-eyebrow-tag\">full list on click</span></div><div class=\"box-label\">First-Year Korean sequence (choose one sequence: 101LEC+102LEC or 111DIS+112DIS)</div><span class=\"box-credits\">6 cr</span></div></div><div class=\"slot\"><div class=\"box box-course\" id=\"linguistics-ba-korean-language-and-linguistics-concentration__box-0-3-0\" data-detail=\"{&quot;kind&quot;: &quot;course&quot;, &quot;title&quot;: &quot;Introduction to Linguistic Analysis&quot;, &quot;description&quot;: &quot;Introduces the structure of language (phonetics, phonology, morphology, semantics, and syntax), looking at a broad variety of languages; approaches to linguistic analysis and theory.&quot;, &quot;credits&quot;: &quot;3&quot;, &quot;grading&quot;: &quot;Graded (GRD)&quot;, &quot;typically_offered&quot;: &quot;Fall, Spring&quot;, &quot;requisites&quot;: null, &quot;flexible&quot;: false, &quot;also_ubc&quot;: false}\" role=\"button\" tabindex=\"0\"><div class=\"box-label\"><span class=\"box-code\">LIN 205LEC</span><span class=\"box-title\">Introduction to Linguistic Analysis</span></div><span class=\"box-credits\">3 cr</span></div></div></div>\n        <div class=\"col-total\">15 or 16 credits</div>\n      </div>\n      <div class=\"semester-col term-spring\">\n        <div class=\"col-header\"><span class=\"col-year\">Year 1</span><span class=\"col-term\">Spring</span></div>\n        <div class=\"col-slots\"><div class=\"slot\"><div class=\"box box-generic\" id=\"linguistics-ba-korean-language-and-linguistics-concentration__box-1-0-0\" data-detail=\"{&quot;kind&quot;: &quot;generic&quot;, &quot;category&quot;: &quot;ubc&quot;, &quot;description&quot;: &quot;Scientific Literacy and Inquiry: a 7-credit UB Curriculum Foundations requirement (two lecture courses plus a matching 1-credit lab from the same subject area).&quot;, &quot;catalog_url&quot;: &quot;https://www.buffalo.edu/ubcurriculum/foundations.html&quot;}\" role=\"button\" tabindex=\"0\"><div class=\"box-eyebrow\"><span class=\"box-eyebrow-tag box-ubc-tag\">UB Curriculum</span></div><div class=\"box-label\">Scientific Literacy 2</div><span class=\"box-credits\">3 cr</span></div></div><div class=\"slot\"><div class=\"box box-generic\" id=\"linguistics-ba-korean-language-and-linguistics-concentration__box-1-1-0\" data-detail=\"{&quot;kind&quot;: &quot;generic&quot;, &quot;category&quot;: &quot;ubc&quot;, &quot;description&quot;: &quot;Scientific Literacy and Inquiry: a 7-credit UB Curriculum Foundations requirement (two lecture courses plus a matching 1-credit lab from the same subject area).&quot;, &quot;catalog_url&quot;: &quot;https://www.buffalo.edu/ubcurriculum/foundations.html&quot;}\" role=\"button\" tabindex=\"0\"><div class=\"box-eyebrow\"><span class=\"box-eyebrow-tag box-ubc-tag\">UB Curriculum</span></div><div class=\"box-label\">Scientific Lab</div><span class=\"box-credits\">1 cr</span></div></div><div class=\"slot\"><div class=\"or-group\"><div class=\"box box-course\" id=\"linguistics-ba-korean-language-and-linguistics-concentration__box-1-2-0\" data-detail=\"{&quot;kind&quot;: &quot;course&quot;, &quot;title&quot;: &quot;Writing and Rhetoric&quot;, &quot;description&quot;: &quot;An introduction to research, writing, and rhetorical practices employed in academic and professional contexts. The course examines the operation of genres, the audiences they address, and the purposes they serve. The course focuses on the analysis and development of student writing and rhetorical practice. Assignments include research essays, digital compositions, and oral presentations.&quot;, &quot;credits&quot;: &quot;4&quot;, &quot;grading&quot;: &quot;Graded (GRD)&quot;, &quot;typically_offered&quot;: &quot;Fall, Spring, Summer&quot;, &quot;requisites&quot;: &quot;ENG 105 non-Z Requisite&quot;, &quot;flexible&quot;: false, &quot;also_ubc&quot;: true}\" role=\"button\" tabindex=\"0\"><div class=\"box-eyebrow\"><span class=\"box-eyebrow-tag box-ubc-tag\">UB Curriculum</span></div><div class=\"box-label\"><span class=\"box-code\">ENG 105LEC</span><span class=\"box-title\">Writing and Rhetoric</span></div><span class=\"box-credits\">4 cr</span><div class=\"box-note\">(may also be completed in a different semester shown)</div></div><div class=\"or-sep\">or</div><div class=\"box box-generic\" id=\"linguistics-ba-korean-language-and-linguistics-concentration__box-1-2-1\" data-detail=\"{&quot;kind&quot;: &quot;generic&quot;, &quot;category&quot;: &quot;ubc&quot;, &quot;description&quot;: &quot;Pathway: a UB Curriculum Thematic or Global Pathway course - part of at least four UB Areas/SUNY General Education categories a student&#x27;s Pathways coursework must satisfy across two Pathways (one Thematic, one Global).&quot;, &quot;catalog_url&quot;: &quot;https://www.buffalo.edu/ubcurriculum/pathways.html&quot;}\" role=\"button\" tabindex=\"0\"><div class=\"box-eyebrow\"><span class=\"box-eyebrow-tag box-ubc-tag\">UB Curriculum</span></div><div class=\"box-label\">Pathway</div><span class=\"box-credits\">3 cr</span></div></div></div><div class=\"slot\"><div class=\"box box-course box-flexible\" id=\"linguistics-ba-korean-language-and-linguistics-concentration__box-1-3-0\" data-detail=\"{&quot;kind&quot;: &quot;course&quot;, &quot;title&quot;: &quot;First-Year Korean 2nd Semester&quot;, &quot;description&quot;: &quot;KOR 112 is the second half of the beginner-level Korean series, and is designed for those who have taken KOR 111 or equivalent knowledge in Korean. Students in KOR 112 MUST have fundamental skills in the beginner-level Korean. This course aims to train students to perform appropriate spoken and written communications in essential and practical daily life situations. This course will help students continue developing accuracy and fluency in listening, reading, speaking, and writing skills for daily life. Students will learn to express situations, give instructions and explanations, communicate opinions, and narrate and comprehend stories. Moreover, students will be exposed to everyday life contexts, such as shopping, meeting friends, working, etc. as part of living in modern Korean society. This course will also introduce the Korean culture essential for a better understanding of the Korean language.&quot;, &quot;credits&quot;: &quot;3&quot;, &quot;grading&quot;: &quot;Graded (GRD)&quot;, &quot;typically_offered&quot;: &quot;Spring&quot;, &quot;requisites&quot;: &quot;Pre-Requisite: KOR 101 or KOR 111&quot;, &quot;flexible&quot;: true, &quot;also_ubc&quot;: false, &quot;catalog_url&quot;: &quot;https://catalogs.buffalo.edu/preview_program.php?catoid=21&amp;poid=8001&amp;returnto=1177&quot;, &quot;groups&quot;: [{&quot;requirement_type&quot;: &quot;choice_required&quot;, &quot;group&quot;: &quot;First-Year Korean sequence (choose one sequence: 101LEC+102LEC or 111DIS+112DIS)&quot;, &quot;courses&quot;: [{&quot;code&quot;: &quot;KOR 101LEC&quot;, &quot;title&quot;: &quot;First-Year Korean&quot;}, {&quot;code&quot;: &quot;KOR 102LEC&quot;, &quot;title&quot;: &quot;First-Year Korean&quot;}, {&quot;code&quot;: &quot;KOR 111DIS&quot;, &quot;title&quot;: &quot;First-Year Korean 1st Semester&quot;}, {&quot;code&quot;: &quot;KOR 112DIS&quot;, &quot;title&quot;: &quot;First-Year Korean 2nd Semester&quot;}]}]}\" role=\"button\" tabindex=\"0\"><div class=\"box-eyebrow\"><span class=\"box-eyebrow-tag\">full list on click</span></div><div class=\"box-label\">First-Year Korean sequence (choose one sequence: 101LEC+102LEC or 111DIS+112DIS)</div><span class=\"box-credits\">3 cr</span></div></div><div class=\"slot\"><div class=\"box box-course box-flexible\" id=\"linguistics-ba-korean-language-and-linguistics-concentration__box-1-4-0\" data-detail=\"{&quot;kind&quot;: &quot;generic&quot;, &quot;category&quot;: &quot;major_requirement&quot;, &quot;description&quot;: &quot;\\&quot;LIN Any Level Course\\&quot; is a flexible requirement slot defined by this major&#x27;s own requirements, not a specific course - see the Undergraduate Catalog for the exact eligible options.&quot;, &quot;catalog_url&quot;: &quot;https://catalogs.buffalo.edu/preview_program.php?catoid=21&amp;poid=8001&amp;returnto=1177&quot;}\" role=\"button\" tabindex=\"0\"><div class=\"box-eyebrow\"><span class=\"box-eyebrow-tag\">Requirement in the major</span></div><div class=\"box-label\">LIN Any Level Course</div><span class=\"box-credits\">3 cr</span></div></div></div>\n        <div class=\"col-total\">13 or 14 credits</div>\n      </div>\n      <div class=\"semester-col term-fall\">\n        <div class=\"col-header\"><span class=\"col-year\">Year 2</span><span class=\"col-term\">Fall</span></div>\n        <div class=\"col-slots\"><div class=\"slot\"><div class=\"box box-generic\" id=\"linguistics-ba-korean-language-and-linguistics-concentration__box-2-0-0\" data-detail=\"{&quot;kind&quot;: &quot;generic&quot;, &quot;category&quot;: &quot;ubc&quot;, &quot;description&quot;: &quot;Scientific Literacy and Inquiry: a 7-credit UB Curriculum Foundations requirement (two lecture courses plus a matching 1-credit lab from the same subject area).&quot;, &quot;catalog_url&quot;: &quot;https://www.buffalo.edu/ubcurriculum/foundations.html&quot;}\" role=\"button\" tabindex=\"0\"><div class=\"box-eyebrow\"><span class=\"box-eyebrow-tag box-ubc-tag\">UB Curriculum</span></div><div class=\"box-label\">Scientific Literacy 1</div><span class=\"box-credits\">3 cr</span></div></div><div class=\"slot\"><div class=\"box box-generic\" id=\"linguistics-ba-korean-language-and-linguistics-concentration__box-2-1-0\" data-detail=\"{&quot;kind&quot;: &quot;generic&quot;, &quot;category&quot;: &quot;ubc&quot;, &quot;description&quot;: &quot;Pathway: a UB Curriculum Thematic or Global Pathway course - part of at least four UB Areas/SUNY General Education categories a student&#x27;s Pathways coursework must satisfy across two Pathways (one Thematic, one Global).&quot;, &quot;catalog_url&quot;: &quot;https://www.buffalo.edu/ubcurriculum/pathways.html&quot;}\" role=\"button\" tabindex=\"0\"><div class=\"box-eyebrow\"><span class=\"box-eyebrow-tag box-ubc-tag\">UB Curriculum</span></div><div class=\"box-label\">Pathway</div><span class=\"box-credits\">3 cr</span></div></div><div class=\"slot\"><div class=\"box box-course\" id=\"linguistics-ba-korean-language-and-linguistics-concentration__box-2-2-0\" data-detail=\"{&quot;kind&quot;: &quot;course&quot;, &quot;title&quot;: &quot;Second-Year Korean&quot;, &quot;description&quot;: &quot;Equips students with intermediate communicative skills in Korean. Expects students to initiate and be engaged in spontaneous dialogues with little difficulty. Students should be able to understand simple Korean text and compose short essays in Korean. Emphasizes expansion of knowledge of grammar and vocabulary.&quot;, &quot;credits&quot;: &quot;4&quot;, &quot;grading&quot;: &quot;Graded (GRD)&quot;, &quot;typically_offered&quot;: &quot;Fall&quot;, &quot;requisites&quot;: &quot;Pre-Requisite: KOR 102 .&quot;, &quot;flexible&quot;: false, &quot;also_ubc&quot;: false}\" role=\"button\" tabindex=\"0\"><div class=\"box-label\"><span class=\"box-code\">KOR 201LEC</span><span class=\"box-title\">Second-Year Korean</span></div><span class=\"box-credits\">4 cr</span></div></div><div class=\"slot\"><div class=\"box box-course\" id=\"linguistics-ba-korean-language-and-linguistics-concentration__box-2-3-0\" data-detail=\"{&quot;kind&quot;: &quot;course&quot;, &quot;title&quot;: &quot;Structure of English: The Sound System&quot;, &quot;description&quot;: &quot;Sound structure of English, including the articulation of sounds, phonological patterns and alternations, and dialects. This course is the same as ENG 389 and course repeat rules will apply. Students should consult with their major department regarding any restrictions on their degree requirements.&quot;, &quot;credits&quot;: &quot;3&quot;, &quot;grading&quot;: &quot;Graded (GRD)&quot;, &quot;typically_offered&quot;: &quot;Fall, Spring&quot;, &quot;requisites&quot;: &quot;Pre-Requisite: LIN 205 .&quot;, &quot;flexible&quot;: false, &quot;also_ubc&quot;: false}\" role=\"button\" tabindex=\"0\"><div class=\"box-label\"><span class=\"box-code\">LIN 301LEC</span><span class=\"box-title\">Structure of English: The Sound System</span></div><span class=\"box-credits\">3 cr</span></div></div><div class=\"slot\"><div class=\"box box-course\" id=\"linguistics-ba-korean-language-and-linguistics-concentration__box-2-4-0\" data-detail=\"{&quot;kind&quot;: &quot;course&quot;, &quot;title&quot;: &quot;Structure of English: Grammar and Lexicon&quot;, &quot;description&quot;: &quot;Syntax and morphology of English, including lexical and grammatical categories, basic clause structure, and complex sentences. This course is the same as ENG 390 and course repeat rules will apply. Students should consult with their major department regarding any restrictions on their degree requirements.&quot;, &quot;credits&quot;: &quot;3&quot;, &quot;grading&quot;: &quot;Graded (GRD)&quot;, &quot;typically_offered&quot;: &quot;Fall, Spring&quot;, &quot;requisites&quot;: &quot;Pre-Requisite: LIN 205 .&quot;, &quot;flexible&quot;: false, &quot;also_ubc&quot;: false}\" role=\"button\" tabindex=\"0\"><div class=\"box-label\"><span class=\"box-code\">LIN 302LEC</span><span class=\"box-title\">Structure of English: Grammar and Lexicon</span></div><span cl