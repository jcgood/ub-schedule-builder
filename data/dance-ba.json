ite: DAC 201 .&quot;, &quot;flexible&quot;: false, &quot;also_ubc&quot;: false}\" role=\"button\" tabindex=\"0\"><div class=\"box-label\"><span class=\"box-code\">DAC 202LEC</span><span class=\"box-title\">Modern Dance 2</span></div><span class=\"box-credits\">2-3 cr</span><div class=\"box-note\">(3 credits required)</div></div></div><div class=\"slot\"><div class=\"box box-course\" id=\"dance-ba__box-1-2-0\" data-detail=\"{&quot;kind&quot;: &quot;course&quot;, &quot;title&quot;: &quot;Tap Dance 2&quot;, &quot;description&quot;: &quot;Teaches the fundamentals of tap dance, including basic rhythmic structure and incorporation of dance fundamentals, such as alignment and style, in conjunction with tap technique.&quot;, &quot;credits&quot;: &quot;3&quot;, &quot;grading&quot;: &quot;Graded (GRD)&quot;, &quot;typically_offered&quot;: null, &quot;requisites&quot;: null, &quot;flexible&quot;: false, &quot;also_ubc&quot;: false}\" role=\"button\" tabindex=\"0\"><div class=\"box-label\"><span class=\"box-code\">DAC 211LEC</span><span class=\"box-title\">Tap Dance 2</span></div><span class=\"box-credits\">3 cr</span><div class=\"box-note\">(3 credits required)</div></div></div><div class=\"slot\"><div class=\"box box-course\" id=\"dance-ba__box-1-3-0\" data-detail=\"{&quot;kind&quot;: &quot;course&quot;, &quot;title&quot;: &quot;Ballet 2&quot;, &quot;description&quot;: &quot;Teaches the fundamentals of ballet technique, including correct body alignment, basic barre and center work, and combinations at the elementary level.&quot;, &quot;credits&quot;: &quot;3&quot;, &quot;grading&quot;: &quot;Graded (GRD)&quot;, &quot;typically_offered&quot;: null, &quot;requisites&quot;: &quot;Pre-Requisite: DAC 116 or DAC 213&quot;, &quot;flexible&quot;: false, &quot;also_ubc&quot;: false}\" role=\"button\" tabindex=\"0\"><div class=\"box-label\"><span class=\"box-code\">DAC 214LEC</span><span class=\"box-title\">Ballet 2</span></div><span class=\"box-credits\">3 cr</span><div class=\"box-no