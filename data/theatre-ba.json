view_program.php?catoid=21&amp;poid=7966&amp;returnto=1177&quot;}\" role=\"button\" tabindex=\"0\"><div class=\"box-eyebrow\"><span class=\"box-eyebrow-tag\">Elective in the major</span></div><div class=\"box-label\">Elective</div><span class=\"box-credits\">3 cr</span></div></div><div class=\"slot\"><div class=\"box box-course box-flexible\" id=\"theatre-ba__box-1-5-0\" data-detail=\"{&quot;kind&quot;: &quot;generic&quot;, &quot;category&quot;: &quot;major_requirement&quot;, &quot;description&quot;: &quot;\\&quot;TH concentration course\\&quot; is a flexible requirement slot defined by this major&#x27;s own requirements, not a specific course - see the Undergraduate Catalog for the exact eligible options.&quot;, &quot;catalog_url&quot;: &quot;https://catalogs.buffalo.edu/preview_program.php?catoid=21&amp;poid=7966&amp;returnto=1177&quot;}\" role=\"button\" tabindex=\"0\"><div class=\"box-eyebrow\"><span class=\"box-eyebrow-tag\">Requirement in the major</span></div><div class=\"box-label\">TH concentration course</div><span class=\"box-credits\">3 cr</span></div></div></div>\n        <div class=\"col-total\">16 or 17 credits</div>\n      </div>\n      <div class=\"semester-col term-fall\">\n        <div class=\"col-header\"><span class=\"col-year\">Year 2</span><span class=\"col-term\">Fall</span></div>\n        <div class=\"col-slots\"><div class=\"slot\"><div class=\"box box-generic\" id=\"theatre-ba__box-2-0-0\" data-detail=\"{&quot;kind&quot;: &quot;generic&quot;, &quot;category&quot;: &quot;ubc&quot;, &quot;description&quot;: &quot;Scientific Literacy and Inquiry: a 7-credit UB Curriculum Foundations requirement (two lecture courses plus a matching 1-credit lab from the same subject area).&quot;, &quot;catalog_url&quot;: &quot;https://www.buffalo.edu/ubcurriculum/foundations.html&quot;}\" role=\"button\" tabindex=\"0\"><div class=\"box-eyebrow\"><span class=\"box-eyebrow-tag box-ubc-tag\">UB Curriculum</span></div><div class=\"box-label\">Scientific Literacy and Inquiry 1</div><span class=\"box-credits\">3 cr</span></div></div><div class=\"slot\"><div class=\"box box-generic\" id=\"theatre-ba__box-2-1-0\" data-detail=\"{&quot;kind&quot;: &quot;generic&quot;, &quot;category&quot;: &quot;ubc&quot;, &quot;description&quot;: &quot;Math and Quantitative Reasoning: a 4-credit UB Curriculum Foundations requirement, satisfied by one of several approved math, statistics, or precalculus/calculus courses.&quot;, &quot;catalog_url&quot;: &quot;https://www.buffalo.edu/ubcurriculum/foundations.html&quot;}\" role=\"button\" tabindex=\"0\"><div class=\"box-eyebrow\"><span class=\"box-eyebrow-tag box-ubc-tag\">UB Curriculum</span></div><div class=\"box-label\">Math &amp; Quantitative Reasoning</div><span class=\"box-credits\">4 cr</span></div></div><div class=\"slot\"><div class=\"box box-course\" id=\"theatre-ba__box-2-2-0\" data-detail=\"{&quot;kind&quot;: &quot;course&quot;, &quot;title&quot;: &quot;Script Analysis&quot;, &quot;description&quot;: &quot;Develops fundamental analytical skills that actors, directors, and designers use to prepare a wide range of dramatic texts for rehearsal and production. Students will learn an approach to moving a play from page to stage, with emphasis on understanding and analyzing the building blocks of drama: dramatic structure, given circumstances, character, language, action, tempo, rhythm, and space. Students will improve their ability to communicate ideas about staging plays orally and in writing and begin to collaborate toward a shared artistic process and product. The ultimate goal is to realize the freedom and responsibility of theatre practitioners as interpretive artists.&quot;, &quot;credits&quot;: &quot;3&quot;, &quot;grading&quot;: &quot;Graded (GRD)&quot;, &quot;typically_offered&quot;: &quot;Fall&quot;, &quot;requisites&quot;: &quot;Pre-Requisite: Completion of Communication Literacy 1 or completion of Writing Skills 1 (ENG 101 or placement into ENG 201).&quot;, &quot;flexible&quot;: fa