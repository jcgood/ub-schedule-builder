{"panel_html": "<section class=\"panel rel-scope active\" id=\"panel-container\" data-rel=\"{}\"><div class=\"scroll-hint\">Scroll right for more semesters \u2192</div><div class=\"flow-scroll\"><div class=\"flow-container\">\n      <div class=\"semester-col term-fall\">\n        <div class=\"col-header\"><span class=\"col-year\">Year 1</span><span class=\"col-term\">Fall</span></div>\n        <div class=\"col-slots\"><div class=\"slot\"><div class=\"box box-generic\" id=\"media-study-ba-critical-studies-concentration__box-0-0-0\" data-detail=\"{&quot;kind&quot;: &quot;generic&quot;, &quot;category&quot;: &quot;ubc&quot;, &quot;description&quot;: &quot;UB Seminar: a 1- or 3-credit seminar every student completes in their first semester of enrollment, taught by faculty across departments around a &#x27;big idea&#x27; in the discipline. A UB Curriculum core requirement, not specific to this major.&quot;, &quot;catalog_url&quot;: &quot;https://www.buffalo.edu/ubcurriculum/seminar.html&quot;}\" role=\"button\" tabindex=\"0\"><div class=\"box-eyebrow\"><span class=\"box-eyebrow-tag box-ubc-tag\">UB Curriculum</span></div><div class=\"box-label\">UB Seminar</div><span class=\"box-credits\">3 cr</span></div></div><div class=\"slot\"><div class=\"box box-course\" id=\"media-study-ba-critical-studies-concentration__box-0-1-0\" data-detail=\"{&quot;kind&quot;: &quot;course&quot;, &quot;title&quot;: &quot;Writing and Rhetoric&quot;, &quot;description&quot;: &quot;An introduction to research, writing, and rhetorical practices employed in academic and professional contexts. The course examines the operation of genres, the audiences they address, and the purposes they serve. The course focuses on the analysis and development of student writing and rhetorical practice. Assignments include research essays, digital compositions, and oral presentations.&quot;, &quot;credits&quot;: &quot;4&quot;, &quot;grading&quot;: &quot;Graded (GRD)&quot;, &quot;typically_offered&quot;: &quot;Fall, Spring, Summer&quot;, &quot;requisites&quot;: &quot;ENG 105 non-Z Requisite&quot;, &quot;flexible&quot;: false, &quot;also_ubc&quot;: true}\" role=\"button\" tabindex=\"0\"><div class=\"box-eyebrow\"><span class=\"box-eyebrow-tag box-ubc-tag\">UB Curriculum</span></div><div class=\"box-label\"><span class=\"box-code\">ENG 105LEC</span><span class=\"box-title\">Writing and Rhetoric</span></div><span class=\"box-credits\">4 cr</span></div></div><div class=\"slot\"><div class=\"box box-generic\" id=\"media-study-ba-critical-studies-concentration__box-0-2-0\" data-detail=\"{&quot;kind&quot;: &quot;generic&quot;, &quot;category&quot;: &quot;ubc&quot;, &quot;description&quot;: &quot;Math and Quantitative Reasoning: a 4-credit UB Curriculum Foundations requirement, satisfied by one of several approved math, statistics, or precalculus/calculus courses.&quot;, &quot;catalog_url&quot;: &quot;https://www.buffalo.edu/ubcurriculum/foundations.html&quot;}\" role=\"button\" tabindex=\"0\"><div class=\"box-eyebrow\"><span class=\"box-eyebrow-tag box-ubc-tag\">UB Curriculum</span></div><div class=\"box-label\">Math &amp; Quantitative Reasoning</div><span class=\"box-credits\">4 cr</span></div></div><div class=\"slot\"><div class=\"box box-generic\" id=\"media-study-ba-critical-studies-concentration__box-0-3-0\" data-detail=\"{&quot;kind&quot;: &quot;generic&quot;, &quot;category&quot;: &quot;ubc&quot;, &quot;description&quot;: &quot;Scientific Literacy and Inquiry: a 7-credit UB Curriculum Foundations requirement (two lecture courses plus a matching 1-credit lab from the same subject area).&quot;, &quot;catalog_url&quot;: &quot;https://www.buffalo.edu/ubcurriculum/foundations.html&quot;}\" role=\"button\" tabindex=\"0\"><div class=\"box-eyebrow\"><span class=\"box-eyebrow-tag box-ubc-tag\">UB Curriculum</span></div><div class=\"box-label\">Scientific Literacy 1</div><span class=\"box-credits\">3 cr</span></div></div><div class=\"slot\"><div class=\"box box-generic\" id=\"media-stud