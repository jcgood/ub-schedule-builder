{"panel_html": "<section class=\"panel rel-scope active\" id=\"panel-container\" data-rel=\"{&quot;computer-science-ba__box-0-1-0&quot;: {&quot;postreq&quot;: [&quot;computer-science-ba__box-1-0-0&quot;, &quot;computer-science-ba__box-1-1-0&quot;, &quot;computer-science-ba__box-2-0-0&quot;, &quot;computer-science-ba__box-2-1-0&quot;, &quot;computer-science-ba__box-3-0-0&quot;]}, &quot;computer-science-ba__box-0-2-0&quot;: {&quot;postreq&quot;: [&quot;computer-science-ba__box-1-1-0&quot;, &quot;computer-science-ba__box-1-2-0&quot;, &quot;computer-science-ba__box-2-0-0&quot;, &quot;computer-science-ba__box-2-1-0&quot;, &quot;computer-science-ba__box-3-0-0&quot;]}, &quot;computer-science-ba__box-1-0-0&quot;: {&quot;prereq-immediate&quot;: [&quot;computer-science-ba__box-0-1-0&quot;], &quot;postreq&quot;: [&quot;computer-science-ba__box-2-0-0&quot;, &quot;computer-science-ba__box-2-1-0&quot;, &quot;computer-science-ba__box-3-0-0&quot;]}, &quot;computer-science-ba__box-1-1-0&quot;: {&quot;prereq-immediate&quot;: [&quot;computer-science-ba__box-0-1-0&quot;, &quot;computer-science-ba__box-0-2-0&quot;], &quot;postreq&quot;: [&quot;computer-science-ba__box-2-1-0&quot;]}, &quot;computer-science-ba__box-1-2-0&quot;: {&quot;prereq-immediate&quot;: [&quot;computer-science-ba__box-0-2-0&quot;]}, &quot;computer-science-ba__box-2-0-0&quot;: {&quot;prereq-immediate&quot;: [&quot;computer-science-ba__box-0-2-0&quot;, &quot;computer-science-ba__box-1-0-0&quot;], &quot;prereq-sequence&quot;: [&quot;computer-science-ba__box-0-1-0&quot;], &quot;postreq&quot;: [&quot;computer-science-ba__box-3-0-0&quot;]}, &quot;computer-science-ba__box-2-1-0&quot;: {&quot;prereq-immediate&quot;: [&quot;computer-science-ba__box-0-2-0&quot;, &quot;computer-science-ba__box-1-0-0&quot;, &quot;computer-science-ba__box-1-1-0&quot;], &quot;prereq-sequence&quot;: [&quot;computer-science-ba__box-0-1-0&quot;]}, &quot;computer-science-ba__box-3-0-0&quot;: {&quot;prereq-immediate&quot;: [&quot;computer-science-ba__box-2-0-0&quot;], &quot;prereq-sequence&quot;: [&quot;computer-science-ba__box-0-1-0&quot;, &quot;computer-science-ba__box-0-2-0&quot;, &quot;computer-science-ba__box-1-0-0&quot;]}}\"><div class=\"scroll-hint\">Scroll right for more semesters \u2192</div><div class=\"flow-scroll\"><div class=\"flow-container\">\n      <div class=\"semester-col term-fall\">\n        <div class=\"col-header\"><span class=\"col-year\">Year 1</span><span class=\"col-term\">Fall</span></div>\n        <div class=\"col-slots\"><div class=\"slot\"><div class=\"box box-generic\" id=\"computer-science-ba__box-0-0-0\" data-detail=\"{&quot;kind&quot;: &quot;generic&quot;, &quot;category&quot;: &quot;ubc&quot;, &quot;description&quot;: &quot;UB Seminar: a 1- or 3-credit seminar every student completes in their first semester of enrollment, taught by faculty across departments around a &#x27;big idea&#x27; in the discipline. A UB Curriculum core requirement, not specific to this major.&quot;, &quot;catalog_url&quot;: &quot;https://www.buffalo.edu/ubcurriculum/seminar.html&quot;}\" role=\"button\" tabindex=\"0\"><div class=\"box-eyebrow\"><span class=\"box-eyebrow-tag box-ubc-tag\">UB Curriculum</span></div><div class=\"box-label\">UB Seminar</div><span class=\"box-credits\">3 cr</span></div></div><div class=\"slot\"><div class=\"box box-course\" id=\"computer-science-ba__box-0-1-0\" data-detail=\"{&quot;kind&quot;: &quot;course&quot;, &quot;title&quot;: &quot;Introduction to Computer Science I&quot;, &quot;description&quot;: &quot;Provides the fundamentals of computer science with an emphasis on applying programming skills to solve problems and increase human efficiency. Topics include variables, data types, expressions, control flow, functions, input/output, data storage, networking, security, selection, sorting, iteration and the use of aggregate data structures such as lists and more general collections. No previous programming experience required.&quot;, &quot;credits&quot;: &quot;4&quot;, &quot;grading&quot;: &quot;Graded (GRD)&quot;, &quot;typically_offered&quot;: &quot;Fall, Spring, Summer&quot;, &quot;requisites&quot;: null, &quot;flexible&quot;: false, &quot;also_ubc&quot;: false}\" role=\"button\" tabindex=\"0\"><div class=\"box-label\"><span class=\"box-code\">CSE 115LLR</span><span class=\"box-title\">Introduction to Computer Science I</span></div><span class=\"box-credits\">4 cr</span></div></div><div class=\"slot\"><div class=\"box box-course box-flexible\" id=\"computer-science-ba__box-0-2-0\" data-detail=\"{&quot;kind&quot;: &quot;course&quot;, &quot;title&quot;: &quot;Survey of Calculus and Its Applications I&quot;, &quot;description&quot;: &quot;For students in social, biological, and management sciences. Limits, continuity, differentiation of algebraic and exponential functions; applications; introduces integration.&quot;, &quot;credits&quot;: &quot;4&quot;, &quot;grading&quot;: &quot;Graded (GRD)&quot;, &quot;typically_offered&quot;: &quot;Fall, Spring, Summer, Winter&quot;, &quot;requisites&quot;: &quot;Pre-Requisite: Score of 70/100 or better on both the Fundamentals and the Algebra portions of the Math Readiness Assessment, or a C or better in ULC 148 , MTH 108 , MTH 113 , MTH 114 , MTH 115 , a D or better in MTH 121 or MTH 131 or MTH 141 or a score of 3 on AP Calculus or a score of 4 or 5 on AP Pre-Calculus.&quot;, &quot;flexible&quot;: true, &quot;also_ubc&quot;: true, &quot;catalog_url&quot;: &quot;https://catalogs.buffalo.edu/preview_program.php?catoid=21&amp;poid=7949&amp;returnto=1177&quot;, &quot;groups&quot;: [{&quot;requirement_type&quot;: &quot;choice_required&quot;, &quot;group&quot;: &quot;Computer Science Core: Calculus Sequence (choose 1 of 2 sequences)&quot;, &quot;courses&quot;: [{&quot;code&quot;: &quot;MTH 121LR&quot;, &quot;title&quot;: &quot;Survey of Calculus and Its Applications I&quot;}, {&quot;code&quot;: &quot;MTH 122LR&quot;, &quot;title&quot;: &quot;Survey of Calculus and Its Applications II&quot;}, {&quot;code&quot;: &quot;MTH 141LR&quot;, &quot;title&quot;: &quot;College Calculus I&quot;}, {&quot;code&quot;: &quot;MTH 142LR&quot;, &quot;title&quot;: &quot;College Calculus 2&quot;}]}]}\" role=\"button\" tabindex=\"0\"><div class=\"box-eyebrow\"><span class=\"box-eyebrow-tag\">full list on click</span><span class=\"box-eyebrow-sep\"> &middot; </span><span class=\"box-eyebrow-tag box-ubc-tag\">UB Curriculum</span></div><div class=\"box-label\">Computer Science Core: Calculus Sequence (choose 1 of 2 sequences)</div><span class=\"box-credits\">4 cr</span></div></div><div class=\"slot\"><div class=\"or-group\"><div class=\"box box-course\" id=\"computer-science-ba__box-0-3-0\" data-detail=\"{&quot;kind&quot;: &quot;course&quot;, &quot;title&quot;: &quot;Writing and Rhetoric&quot;, &quot;description&quot;: &quot;An introduction to research, writing, and rhetorical practices employed in academic and professional contexts. The course examines the operation of genres, the audiences they address, and the purposes they serve. The course focuses on the analysis and development of student writing and rhetorical practice. Assignments include research essays, digital compositions, and oral presentations.&quot;, &quot;credits&quot;: &quot;4&quot;, &quot;grading&quot;: &quot;Graded (GRD)&quot;, &quot;typically_offered&quot;: &quot;Fall, Spring, Summer&quot;, &quot;requisites&quot;: &quot;ENG 105 non-Z Requisite&quot;, &quot;flexible&quot;: false, &quot;also_ubc&quot;: true}\" role=\"button\" tabindex=\"0\"><div class=\"box-eyebrow\"><span class=\"box-eyebrow-tag box-ubc-tag\">UB Curriculum</span></div><div class=\"box-label\"><span class=\"box-code\">ENG 105LEC</span><span class=\"box-title\">Writing and Rhetoric</span></div><span class=\"box-credits\">4 cr</span><div class=\"box-note\">(may also be completed in a different semester shown)</div></div><div class=\"or-sep\">or</div><div class=\"box box-generic\" id=\"computer-science-ba__box-0-3-1\" data-detail=\"{&quot;kind&quot;: &quot;generic&quot;, &quot;category&quot;: &quot;ubc&quot;, &quot;description&quot;: &quot;Pathway: a UB Curriculum Thematic or Global Pathway course - part of at least four UB Areas/SUNY General Education categories a student&#x27;s Pathways coursework must satisfy across two Pathways (one Thematic, one Global).&quot;, &quot;catalog_url&quot;: &quot;https://www.buffalo.edu/ubcurriculum/pathways.html&quot;}\" role=\"button\" tabindex=\"0\"><div class=\"box-eyebrow\"><span class=\"box-eyebrow-tag box-ubc-tag\">UB Curriculum</span></div><div class=\"box-label\">Pathway</div><span class=\"box-credits\">3 cr</span></div></div></div></div>\n        <div class=\"col-total\">14 or 15 credits</div>\n      </div>\n      <div class=\"semester-col term-spring\">\n        <div class=\"col-header\"><span class=\"col-year\">Year 1</span><span class=\"col-term\">Spring</span></div>\n        <div class=\"col-slots\"><div class=\"slot\"><div class=\"box box-course\" id=\"computer-science-ba__box-1-0-0\" data-detail=\"{&quot;kind&quot;: &quot;course&quot;, &quot;title&quot;: &quot;Introduction to Computer Science II&quot;, &quot;description&quot;: &quot;Students will continue to develop the skills introduced in CSE 115 while exploring the details of program execution and the structure of large programs. Emphasizes design decisions that affect the efficiency, expandability, and maintainability of code while analyzing the differences amongst a variety of approaches. Design decisions analyzed include choice of data structures and object-oriented techniques such as encapsulation, polymorphism, and inheritance. Additional topics include the use of recursion, multithreading, parallelism, hardware, graph and tree traversals, asymptotic analysis, divide and conquer, databases, testing, and multi-language integration.&quot;, &quot;credits&quot;: &quot;4&quot;, &quot;grading&quot;: &quot;Graded (GRD)&quot;, &quot;typically_offered&quot;: &quot;Fall, Spring, Summer&quot;, &quot;requisites&quot;: &quot;Pre-Requisite: CSE 115 or EAS 230 or EAS 240 or EAS 999TRCP .&quot;, &quot;flexible&quot;: false, &quot;also_ubc&quot;: false}\" role=\"button\" tabindex=\"0\"><div class=\"box-label\"><span class=\"box-code\">CSE 116LLB</span><span class=\"box-title\">Introduction to Computer Science II</span></div><span class=\"box-credits\">4 cr</span></div></div><div class=\"slot\"><div class=\"box box-course\" id=\"computer-science-ba__box-1-1-0\" data-detail=\"{&quot;kind&quot;: &quot;course&quot;, &quot;title&quot;: &quot;Introduction to Discrete Structures&quot;, &quot;description&quot;: &quot;Foundational material for further studies in computer science. Topics include logic, proofs, sets, functions, relations, recursion, recurrence relations, mathematical induction, graphs, trees, basic counting theory, regular languages, and context free grammars. This course is the same as MTH 191 and course repeat rules will apply. Students should consult with their major department regarding any restrictions on their degree requirements.&quot;, &quot;credits&quot;: &quot;4&quot;, &quot;grading&quot;: &quot;Graded (GRD)&quot;, &quot;typically_offered&quot;: &quot;Fall, Spring, Summer&quot;, &quot;requisites&quot;: &quot;Pre-Requisite: CSE 115 or EAS 230 or EAS 240 or EAS 999TRCP , and Pre-calculus (MTH 115 or ULC 148 or MTH 113 or MTH 114 ) or appropriate math placement test scores or Co-Requisite of Calculus 1 (MTH 121 or MTH 131 or MTH 141 , or MTH 136 or MTH 108 ).&quot;, &quot;flexible&quot;: false, &quot;also_ubc&quot;: false}\" role=\"button\" tabindex=\"0\"><div class=\"box-label\"><span class=\"box-code\">CSE 191LR</span><span class=\"box-title\">Introduction to Discrete Structures</span></div><span class=\"box-credits\">4 cr</span></div></div><div class=\"slot\"><div class=\"or-group\"><div class=\"box box-course box-flexible\" id=\"computer-science-ba__box-1-2-0\" data-detail=\"{&quot;kind&quot;: &quot;course&quot;, &quot;title&quot;: &quot;Survey of Calculus and Its Applications II&quot;, &quot;description&quot;: &quot;Continuation of MTH 121 . Maximization of functions of several variables using both calculus and elementary linear programming techniques. Elementary integration, simple differential equations, matrix algebra.&quot;, &quot;credits&quot;: &quot;4&quot;, &quot;grading&quot;: &quot;Graded (GRD)&quot;, &quot;typically_offered&quot;: &quot;Fall, Spring, Summer, Winter&quot;, &quot;requisites&quot;: &quot;Pre-Requisite: MTH 121 or MTH 141 or MTH 136 and MTH 137 .&quot;, &quot;flexible&quot;: true, &quot;also_ubc&quot;: false, &quot;catalog_url&quot;: &quot;https://catalogs.buffalo.edu/preview_program.php?catoid=21&amp;poid=7949&amp;returnto=1177&quot;, &quot;groups&quot;: [{&quot;requirement_type&quot;: &quot;choice_required&quot;, &quot;group&quot;: &quot;Computer Science Core: Calculus Sequence (choose 1 of 2 sequences)&quot;, &quot;courses&quot;: [{&quot;code&quot;: &quot;MTH 121LR&quot;, &quot;title&quot;: &quot;Survey of Calculus and Its Applications I&quot;}, {&quot;code&quot;: &quot;MTH 122LR&quot;, &quot;title&quot;: &quot;Survey of Calculus and Its Applications II&quot;}, {&quot;code&quot;: &quot;MTH 141LR&quot;, &quot;title&quot;: &quot;College Calculus I&quot;}, {&quot;code&quot;: &quot;MTH 142LR&quot;, &quot;title&quot;: &quot;College Calculus 2&quot;}]}]}\" role=\"button\" tabindex=\"0\"><div class=\"box-eyebrow\"><span class=\"box-eyebrow-tag\">full list on click</span></div><div class=\"box-label\">Computer Science Core: Calculus Sequence (choose 1 of 2 sequences)</div><span class=\"box-credits\">4 cr</span></div><div class=\"or-sep\">or</div><div class=\"box box-course box-flexible\" id=\"computer-science-ba__box-1-2-1\" data-detail=\"{&quot;kind&quot;: &quot;generic&quot;, &quot;category&quot;: &quot;major_elective&quot;, &quot;description&quot;: &quot;\\&quot;100+ Level Technical Elective: If MTH 131 was taken\\&quot; is an elective slot specific to this major&#x27;s own requirements, not a UB Curriculum-wide component - the exact eligible courses depend on this program&#x27;s requirements as listed in the Undergraduate Catalog.&quot;, &quot;catalog_url&quot;: &quot;https://catalogs.buffalo.edu/preview_program.php?catoid=21&amp;poid=7949&amp;returnto=1177&quot;}\" role=\"button\" tabindex=\"0\"><div class=\"box-eyebrow\"><span class=\"box-eyebrow-tag\">Elective in the major</span></div><div class=\"box-label\">100+ Level Technical Elective: If MTH 131 was taken</div></div></div></div><div class=\"slot\"><div class=\"or-group\"><div class=\"box box-course\" id=\"computer-science-ba__box-1-3-0\" data-detail=\"{&quot;kind&quot;: &quot;course&quot;, &quot;title&quot;: &quot;Writing and Rhetoric&quot;, &quot;description&quot;: &quot;An introduction to research, writing, and rhetorical practices employed in academic and professional contexts. The course examines the operation of genres, the audiences they address, and the purposes they serve. The course focuses on the analysis and development of student writing and rhetorical practice. Assignments include research essays, digital compositions, and oral presentations.&quot;, &quot;credits&quot;: &quot;4&quot;, &quot;grading&quot;: &quot;Graded (GRD)&quot;, &quot;typically_offered&quot;: &quot;Fall, Spring, Summer&quot;, &quot;requisites&quot;: &quot;ENG 105 non-Z Requisite&quot;, &quot;flexible&quot;: false, &quot;also_ubc&quot;: true}\" role=\"button\" tabindex=\"0\"><div class=\"box-eyebrow\"><span class=\"box-eyebrow-tag box-ubc-tag\">UB Curriculum</span></div><div class=\"box-label\"><span class=\"box-code\">ENG 105LEC</span><span class=\"box-title\">Writing and Rhetoric</span></div><span class=\"box-credits\">4 cr</span><div class=\"box-note\">(may also be completed in a different semester shown)</div></div><div class=\"or-sep\">or</div><div class=\"box box-generic\" id=\"computer-science-ba__box-1-3-1\" data-detail=\"{&quot;kind&quot;: &quot;generic&quot;, &quot;category&quot;: &quot;ubc&quot;, &quot;description&quot;: &quot;Pathway: a UB Curriculum Thematic or Global Pathway course - part of at least four UB Areas/SUNY General Education categories a student&#x27;s Pathways coursework must satisfy across two Pathways (one Thematic, one Global).&quot;, &quot;catalog_url&quot;: &quot;https://www.buffalo.edu/ubcurriculum/pathways.html&quot;}\" role=\"button\" tabindex=\"0\"><div class=\"box-eyebrow\"><span class=\"box-eyebrow-tag box-ubc-tag\">UB Curriculum</span></div><div class=\"box-label\">Pathway</div><span class=\"box-credits\">3 cr</span></div></div></div></div>\n        <div class=\"col-total\">15 or 16 credits</div>\n      </div>\n      <div class=\"semester-col term-fall\">\n        <div class=\"col-header\"><span class=\"col-year\">Year 2</span><span class=\"col-term\">Fall</span></div>\n        <div class=\"col-slots\"><div class=\"slot\"><div class=\"box box-course\" id=\"computer-science-ba__box-2-0-0\" data-detail=\"{&quot;kind&quot;: &quot;course&quot;, &quot;title&quot;: &quot;Systems Programming&quot;, &quot;description&quot;: &quot;This course is an introductory course on computer systems. It introduces computer systems from a programmer\\u2019s perspective, rather than a system implementer\\u2019s perspective, which prepares students for more advanced topics that discuss the internals of a computer system (e.g., operating systems or computer architecture). As a result, the focus of the course is teaching programmable interfaces of a computer system as well as how to use them correctly and effectively when writing a program. The topics mainly include hardware/software interfaces (e.g., data representation in memory) and OS/application interfaces (e.g., syscalls). In discussing these topics, the course gives an overview of a complete computer system, the hardware, operating system, compiler, and network, in order to guide students through various components that modern programs rely on to accomplish their intended purposes.&quot;, &quot;credits&quot;: &quot;4&quot;, &quot;grading&quot;: &quot;Graded (GRD)&quot;, &quot;typically_offered&quot;: &quot;Fall, Spring&quot;, &quot;requisites&quot;: &quot;Pre-Requisite: CSE 116 , and MTH 121 or MTH 131 or MTH 141 ; Computer Science or Computer Engineering Majors, Computer Science Minors, Computational Linguistics or Data Intensive Computing Certificate students only.&quot;, &quot;flexible&quot;: false, &quot;also_ubc&quot;: false}\" role=\"button\" tabindex=\"0\"><div class=\"box-label\"><span class=\"box-code\">CSE 220LLB</span><span class=\"box-title\">Systems Programming</span></div><span class=\"box-credits\">4 cr</span></div></div><div class=\"slot\"><div class=\"box box-course\" id=\"computer-science-ba__box-2-1-0\" data-detail=\"{&quot;kind&quot;: &quot;course&quot;, &quot;title&quot;: &quot;Data Structures&quot;, &quot;description&quot;: &quot;Provides a rigorous analysis of the design, implementation, and properties of advanced data structures. Topics include time-space analysis and tradeoffs in arrays, vectors, lists, stacks, queues, and heaps; tree and graph algorithms and traversals, hashing, sorting, and data structures on secondary storage. Surveys library implementations of basic data structures in a high-level language. Advanced data structure implementations are studied in detail. Illustrates the importance of choosing appropriate data structures when solving a problem by programming projects in a high-level language.&quot;, &quot;credits&quot;: &quot;4&quot;, &quot;grading&quot;: &quot;Graded (GRD)&quot;, &quot;typically_offered&quot;: &quot;Fall, Spring, Summer&quot;, &quot;requisites&quot;: &quot;Pre-Requisite: CSE 116 and (CSE 191 or MTH 311 ) and (MTH 121 or MTH 131 or MTH 141 or MTH 137 ). Engineering, Bioinformatics, Computational Physics, or Math Majors, Computer Science Minors, and Data Intensive Computing Certificate students only.&quot;, &quot;flexible&quot;: false, &quot;also_ubc&quot;: false}\" role=\"button\" tabindex=\"0\"><div class=\"box-label\"><spa